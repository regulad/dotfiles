# ~/.wslconfig -- global WSL2 settings, applying to every distro on this
# machine. Read once when the utility VM boots, so edits only take effect
# after `wsl --shutdown`. Distinct from a distro's own /etc/wsl.conf.

[wsl2]
# NAT, which is WSL's default, stated explicitly so a future edit has to be
# deliberate.
#
# This was mirrored, which hands the VM the Windows host's own adapters
# instead of giving it a private network. That works until the host's
# networking changes underneath it: moving between Wi-Fi networks on
# 2026-08-21 left the VM holding the mirrored interfaces with no default
# route at all, so every outbound connection failed in tens of milliseconds
# with "Could not connect to server". Because mirrored shares one namespace
# across all distros, it broke every distro on the machine at once rather
# than just one. NAT gives the VM its own gateway and is unaffected by host
# adapter changes.
#
# Two things are knowingly given up:
#
#   - IPv6. Microsoft lists IPv6 as a mirrored-mode benefit; NAT does not
#     provide routable IPv6, and there is no setting that adds it. Accepted
#     deliberately -- nothing here needs it.
#   - Reaching a Windows-host service from inside a distro as localhost.
#     Under NAT that direction needs the host's address, which is the
#     gateway: `ip route show default | awk '{print $3}'`. The reverse
#     direction, reaching a WSL service from Windows as localhost, still
#     works via localhostForwarding, which defaults on.
#
# Note also that the VM's subnet is a random 172.x/20 chosen per boot. WSL
# exposes no option to pin it; the only way is re-addressing the Hyper-V NAT
# out of band, which WSL undoes on every boot. Do not rely on the address.
networkingMode=nat

[experimental]
# Every new distro's ext4.vhdx is created as a sparse file, so space freed
# inside it comes back to C: within seconds: ext4 mounts with discard, and a
# TRIMmed block of a sparse VHDX is deallocated on the host. A regular VHDX
# only grows, and getting space back means shutting WSL down and compacting
# it with Optimize-VHD.
#
# Read only when a disk is created (wsl-deploy's import, `wsl --install`), so
# existing distros keep what they have; `wsl --manage <distro> --set-sparse
# true` converts one, after which the space it had already freed only comes
# back through one compaction with sparse turned off (Optimize-VHD refuses a
# sparse file). Honoured since WSL 3.0.2; WSL still calls sparse VHDs
# experimental. 3.0.2 lifted the --allow-unsafe gate that 2.5.6 had put on
# them over reports of data corruption, without saying the cause was fixed.
sparseVhd=true
