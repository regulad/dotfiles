# this file is sourced by both zsh and bash; should use common syntax
if [ -n "$ZSH_VERSION" ]; then
    autoload -Uz colors && colors
    setopt promptsubst
    autoload -Uz compinit && compinit
fi

# completions
if [ -n "$ZSH_VERSION" ]; then
    eval "$(chezmoi completion zsh)"
else
    eval "$(chezmoi completion bash)"
fi

# === ALIASES
# Undo Bluefin's fastfetch hijack.
#
# /etc/profile.d/ublue-fastfetch.sh (from projectbluefin/common) is three lines:
#   alias neofetch='ublue-fastfetch'
#   alias neowofetch='ublue-fastfetch'
#   alias fastfetch='ublue-fastfetch'
#
# and /usr/bin/ublue-fastfetch ends in
#   exec fastfetch --color "$(ublue-bling-fastfetch)" --config "$FASTFETCH_CONFIG"
#
# where FASTFETCH_CONFIG defaults to /usr/share/ublue-os/fastfetch.jsonc. An
# explicit --config always beats ~/.config/fastfetch/config.jsonc, so the
# compact config this repo ships never applies and every interactive shell gets
# the full splash instead -- distro logo, image-info line, uptime and the rest --
# because the psuedoMOTD at the bottom of this file calls fastfetch on startup.
#
# Dropping the aliases is enough; the binary and its own config take over again.
# ublue-fastfetch is still on PATH under its own name when it's wanted, and
# nothing here touches the image, so a system update won't fight it.
#
# The alternative, if the wrapper is ever preferable, is a
# /etc/ublue-os/fastfetch.json containing {"fastfetch-config": "<path>"} -- but
# that needs sudo and has to be redone per machine, which is exactly what this
# repo exists to avoid.
unalias fastfetch neofetch neowofetch 2>/dev/null || true

alias c3="uv run --directory=$HOME/.local/share/pycalc3 ipython --no-banner -i --profile=default"
alias t3="uv run --directory=$HOME/.local/share/pycalc3 ipython --no-banner -i --profile=sympy"
alias "chomp=perl -pi -e 'chomp if eof'"

NCSU_HOSTS=(eos grendel hydra kraken)
for h in "${NCSU_HOSTS[@]}"; do
  alias "ssh-$h=sshpass -f $HOME/.ssh/id_plaintext_ncstate ssh $h"
done

v() { 
  command "$VISUAL" "$@"
}
if [ -n "${ZSH_VERSION-}" ]; then
  case "$VISUAL" in
    *nvim) compdef v=nvim ;;
    *vim)  compdef v=vim  ;;
  esac
fi

ssh-privpub() {
    for key in "$@"; do
        [[ "$key" == *.pub ]] && continue
        [ -f "$key" ] && ssh-keygen -y -f "$key" > "${key}.pub" 2>/dev/null && echo "${key}.pub"    
    done
}
[ -n "$ZSH_VERSION" ] && compdef _files ssh-privpub

reflink_duplicates() {
  local dir="${1:-.}"

  local cp_flags
  case "$(uname -s)" in
    Darwin) cp_flags="-cf" ;;
    *)      cp_flags="--reflink=always -f" ;;
  esac

  find-duplicates --keep-going "$dir" | jq -r '
    to_entries[] |
    .value[0] as $canonical |
    .value[1:][] |
    [$canonical, .] | @tsv
  ' | while IFS=$'\t' read -r canonical dup; do
    echo "reflinking: $dup -> $canonical" >&2
    cp $cp_flags -- "$canonical" "$dup"
  done
}
if [ -n "$ZSH_VERSION" ]; then
  compdef '_files -/' reflink_duplicates
fi

chezmoi-cd() {
    cd "$(chezmoi source-path)"
}

bw-unlock() {
    export BW_SESSION="$(bw unlock --raw)"
}

if [ "$(uname -o)" = "GNU/Linux" ]; then
  # given a PID show all files that PID has open
  filewatch() {
    local pid=$1
    watch -n 5 "PIDS=\$(ps --ppid $pid -o pid --no-headers 2>/dev/null | tr -d ' ' | paste -sd,),$pid; lsof -p \"\$PIDS\" -nP -F n 2>/dev/null | grep '^n/' | sed 's|^n||' | grep -Ev '^(/dev|/proc|/sys|/run|/tmp|/cgroup|/\$)' | grep -v '(stat:' | sort -ru"
  }
fi

# === ANNOUNCEMENTS/psuedoMOTD
if [[ $- == *i* && -z ${DID_COMMONRC_SPLASH+x} ]]; then
    LAST_SYNC="{{ now | date "2006-01-02" }}"
    DAYS_OLD=$(( ( $(date +%s) - $(date -j -f "%Y-%m-%d" "$LAST_SYNC" +%s 2>/dev/null || date -d "$LAST_SYNC" +%s) ) / 86400 ))

    if [ "$DAYS_OLD" -gt 7 ]; then
        echo "warning: last chezmoi sync was $LAST_SYNC, resync soon" >&2
    fi

    # Keep ublue's art without keeping ublue's config.
    #
    # Bluefin points fastfetch at a directory of its own ASCII logos and picks
    # one at random per invocation -- /etc/ublue-os/fastfetch.json is
    #   {"logo-directory": "/usr/share/ublue-os/bluefin-logos/symbols",
    #    "shuffle-logo": true}
    # and ublue-fastfetch turns that into `fastfetch --logo <random file>`.
    #
    # The art is worth keeping; the wrapper is not, because it also forces
    # --config /usr/share/ublue-os/fastfetch.jsonc and that beats
    # ~/.config/fastfetch/config.jsonc (which is what the unalias further up is
    # undoing). So do the pick here instead, with this repo's module list.
    #
    # The art is rendered ahead of time, into ~/.config/fastfetch/logos, rather
    # than converted on every shell start. Three reasons:
    #
    #   1. ublue's symbols/ renders are a fixed 36x24 and cannot be shrunk. They
    #      carry their detail in per-cell truecolor over near-arbitrary block
    #      glyphs, so dropping cells to resize them destroys the picture.
    #   2. Converting the PNG originals at runtime means fastfetch's image path,
    #      which is gated behind FF_HAVE_IMAGEMAGICK{6,7} in
    #      src/logo/image/image.c and dlopens MagickCore -- chafa decodes
    #      nothing itself, it only colours pixels ImageMagick already produced.
    #      That proved unreliable here: with brew's fastfetch, chafa and
    #      imagemagick all installed, and `magick identify` reading the files
    #      fine, fastfetch still failed with "Failed to load / convert the image
    #      source". Not worth chasing for a MOTD.
    #   3. A text file needs no ImageMagick, no chafa and no decode work on every
    #      interactive shell, and looks identical on every machine.
    #
    # Generated from bluefin.png / chicken.png / dolly.png / karl.png in
    # /usr/share/ublue-os/bluefin-logos: alpha-trimmed, Lanczos-scaled, emitted
    # as U+2580 half blocks with truecolor fg/bg -- the same shape as ublue's
    # symbols/ files, sized to fit 16x9. That box is the footprint of
    # fastfetch's builtin fedora_small (16 cols x 9 lines), which is what this
    # repo's config.jsonc "type": "small" draws on every other host. Alpha is
    # respected, so the silhouette stays transparent rather than becoming a
    # rectangle. `chafa --size 16x9 <png>` regenerates equivalents.
    #
    # Falls through to a bare `fastfetch` wherever the directory is absent,
    # which is every non-Bluefin host -- .chezmoiignore only applies these on
    # Bluefin. Note `shuf` is coreutils and missing on macOS, so it has to stay
    # behind the -d guard.
    UBLUE_LOGO_DIR="$HOME/.config/fastfetch/logos"
    UBLUE_LOGO=""
    if [ -d "$UBLUE_LOGO_DIR" ]; then
        UBLUE_LOGO="$(find "$UBLUE_LOGO_DIR" -maxdepth 1 -type f 2>/dev/null | shuf -n 1)"
    fi

    # --logo-type file is explicit because this repo's config.jsonc pins
    # "logo": {"type": "small"}, and per src/options/logo.c a bare
    # `--logo <path>` assigns options->source while never touching
    # options->type. The pinned "small" would otherwise survive and fastfetch
    # would draw its builtin logo while ignoring the file entirely.
    if [ -n "$UBLUE_LOGO" ]; then
        fastfetch --logo-type file --logo "$UBLUE_LOGO" >&2
    else
        fastfetch >&2
    fi
    unset UBLUE_LOGO_DIR UBLUE_LOGO
fi
