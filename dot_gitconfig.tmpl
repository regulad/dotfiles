{{- /* Commit signing exists only with real secrets: the SSH key and the GPG
       keypair both arrive with them. Which one signs depends on the git
       first on PATH when this renders: SSH signing (gpg.format = ssh)
       arrived in git 2.34, and an older git -- Apple's on Big Sur is 2.30 --
       treats that value as fatal for EVERY git command, chezmoi's own
       included. So an older git signs with the managed GPG key
       (private_dot_gnupg/*.asc, imported by the 145-gpg-keys hooks) through
       gpg-agent instead. The file is re-rendered on every apply, so once
       brew's newer git is on PATH the SSH branch takes over by itself. */ -}}
{{- $gitVersion := output "git" "--version" | regexFind "[0-9]+\\.[0-9]+" -}}
{{- $sshSigning := semverCompare ">=2.34.0" (printf "%s.0" $gitVersion) -}}
{{- /* hook.<name>.event/command (hooks defined in config) arrived in git 2.54. */ -}}
{{- $configHooks := semverCompare ">=2.54.0" (printf "%s.0" $gitVersion) -}}
{{- $onWindowsScoop := and (eq .chezmoi.os "windows") (stat (joinPath .chezmoi.homeDir "scoop")) -}}
# THIS FILE IS GENERATED BY CHEZMOI!
{{- if .useDummySecrets }}
# signing: off (dummy secrets)
{{- else if $sshSigning }}
# signing: ssh (git {{ $gitVersion }})
{{- else }}
# signing: gpg via gpg-agent (git {{ $gitVersion }} predates ssh signing)
{{- end }}
[user]
	name = Parker Wahle
	email = regulad@regulad.xyz
{{- if not .useDummySecrets }}
{{-   if $sshSigning }}
	signingKey = ~/.ssh/id_rsa3072.pub
{{-   else }}
	# CC05EC2F760B63496EB014C3081BE541EA23ACF3 = Parker Wahle <regulad@regulad.xyz>, ed25519 primary
	signingKey = CC05EC2F760B63496EB014C3081BE541EA23ACF3
{{-   end }}
[commit]
	gpgSign = true
[tag]
	gpgSign = true
{{- end }}
[init]
	defaultBranch = master
# --atomic and --tags should be used on almost every push but there is no way to enable these by default
[push]
	autoSetupRemote = true
	default = current
	# not supported on GitHub but is supported by others
[core]
	autocrlf = false
	excludesFile = ~/.gitignore_global
{{- if $onWindowsScoop }}
	sshCommand = "\"C:\\Windows\\System32\\OpenSSH\\ssh.exe\""
{{- end }}
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[lfs "customtransfer.xet"]
	path = git-xet
	args = transfer
	concurrent = true
{{- if $configHooks }}
# git leaves .git/REBASE_HEAD behind after any rebase that stopped on a
# conflict, and Claude Code's /diff panel reads that file as "a rebase is in
# progress" and shows "Diff unavailable" until it is gone. This drops it once a
# rebase has finished: post-rewrite fires with "rebase" only at the end, and
# the "amend" it also fires for is ignored. Defined in config rather than via
# core.hooksPath, which would switch off every repo's own .git/hooks; those
# still run, after this. stdin (the rewritten-commit list) is drained with a
# builtin rather than cat, which costs a second process on every amend.
[hook "drop-stale-rebase-head"]
	event = post-rewrite
	command = "f() { while read -r _; do :; done; [ \"$1\" = rebase ] && git update-ref -d REBASE_HEAD 2>/dev/null; return 0; }; f"
{{- end }}
{{- if not .useDummySecrets }}
{{-   if $sshSigning }}
[gpg]
	format = ssh
{{-     if $onWindowsScoop }}
	program = "C:\\Program Files\\GnuPG\\bin\\gpg.exe"
{{-     end }}
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
{{-     if $onWindowsScoop }}
	program = "C:\\Windows\\System32\\OpenSSH\\ssh-keygen.exe"
{{-     end }}
{{-   else }}
[gpg]
	# openpgp is the default format; gpg-agent (pinentry from gpg-agent.conf)
	# holds the passphrase. `gpg` is brew's on macOS, first on PATH.
	program = gpg
{{-   end }}
{{- end }}
# the ssh key itself gets passed through SSH, so it can be used even with the dummy secrets
# but for gh? tough luck
{{- if not .useDummySecrets }}
[credential "https://gist.github.com"]
	helper = !gh auth git-credential
[credential "https://github.com"]
	helper = !gh auth git-credential
{{- end }}
