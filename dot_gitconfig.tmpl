{{- /* Commit signing exists only with real secrets: the SSH key and the GPG
       keypair both arrive with them. Which one signs depends on the git
       first on PATH when this renders: SSH signing (gpg.format = ssh)
       arrived in git 2.34, and an older git -- Apple's on Big Sur is 2.30 --
       treats that value as fatal for EVERY git command, chezmoi's own
       included. So an older git signs with the managed GPG key
       (private_dot_gnupg/*.asc, imported by the 145-gpg-keys hooks) through
       gpg-agent instead. The file is re-rendered on every apply, so it
       follows whichever git that is. On macOS it is always Apple's (brew's is
       kept unlinked, see brew-packages-macos.sh), so a Mac on Big Sur or
       older stays on GPG signing. */ -}}
{{- $gitVersion := output "git" "--version" | regexFind "[0-9]+\\.[0-9]+" -}}
{{- $sshSigning := semverCompare ">=2.34.0" (printf "%s.0" $gitVersion) -}}
{{- /* hook.<name>.event/command (hooks defined in config) arrived in git 2.54. */ -}}
{{- $configHooks := semverCompare ">=2.54.0" (printf "%s.0" $gitVersion) -}}
{{- $onWindowsScoop := and (eq .chezmoi.os "windows") (stat (joinPath .chezmoi.homeDir "scoop")) -}}
{{- /* The managed GPG key: Parker Wahle <regulad@regulad.xyz>, ed25519
       primary. It signs commits under an old git (above) and patches. */ -}}
{{- $gpgKey := "CC05EC2F760B63496EB014C3081BE541EA23ACF3" -}}
{{- /* 00-nt/500 and 00-{linux,macos}/100 install patatt on every host,
       including pinned Macs. Gate on the same configuration data, not a
       binary probe: files render before the installing run_after_ scripts.
       The template's sendemail-validate hook follows the same data, in
       .chezmoiignore.tmpl. */ -}}
{{- $patatt := not .useDummySecrets -}}
# THIS FILE IS GENERATED BY CHEZMOI!
{{- if .useDummySecrets }}
# signing: off (dummy secrets)
{{- else if $sshSigning }}
# signing: ssh (git {{ $gitVersion }})
{{- else }}
# signing: gpg via gpg-agent (git {{ $gitVersion }} predates ssh signing)
{{- end }}
[user]
	name = Parker Wahle
	email = regulad@regulad.xyz
{{- if not .useDummySecrets }}
{{-   if $sshSigning }}
	signingKey = ~/.ssh/id_rsa3072.pub
{{-   else }}
	# {{ $gpgKey }} = Parker Wahle <regulad@regulad.xyz>, ed25519 primary
	signingKey = {{ $gpgKey }}
{{-   end }}
[commit]
	gpgSign = true
[tag]
	gpgSign = true
{{- end }}
[init]
	defaultBranch = master
	# New repositories (init and clone) start from this instead of git's
	# stock template. Its hooks/pre-commit, which `pre-commit init-templatedir`
	# writes there (the pre-commit-templatedir hookscripts), runs pre-commit in
	# a repository with a .pre-commit-config.yaml, and with real secrets its
	# hooks/sendemail-validate signs git send-email patches with patatt (see
	# [patatt] below; .chezmoiignore.tmpl leaves that hook out otherwise).
	# `git init` in an existing repository adds what it is missing.
	templateDir = ~/.config/git/template
# --atomic and --tags should be used on almost every push but there is no way to enable these by default
[push]
	autoSetupRemote = true
	default = current
	# not supported on GitHub but is supported by others
[core]
	autocrlf = false
	excludesFile = ~/.gitignore_global
{{- if $onWindowsScoop }}
	sshCommand = "\"C:\\Windows\\System32\\OpenSSH\\ssh.exe\""
{{- end }}
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[lfs "customtransfer.xet"]
	path = git-xet
	args = transfer
	concurrent = true
{{- if $configHooks }}
# git leaves .git/REBASE_HEAD behind after any rebase that stopped on a
# conflict, and Claude Code's /diff panel reads that file as "a rebase is in
# progress" and shows "Diff unavailable" until it is gone. This drops it once a
# rebase has finished: post-rewrite fires with "rebase" only at the end, and
# the "amend" it also fires for is ignored. Defined in config rather than via
# core.hooksPath, which would switch off every repo's own .git/hooks; those
# still run, after this. stdin (the rewritten-commit list) is drained with a
# builtin rather than cat, which costs a second process on every amend.
[hook "drop-stale-rebase-head"]
	event = post-rewrite
	command = "f() { while read -r _; do :; done; [ \"$1\" = rebase ] && git update-ref -d REBASE_HEAD 2>/dev/null; return 0; }; f"
{{- end }}
{{- if not .useDummySecrets }}
{{-   if $sshSigning }}
[gpg]
	format = ssh
{{-     if $onWindowsScoop }}
	program = "C:\\Program Files\\GnuPG\\bin\\gpg.exe"
{{-     end }}
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
{{-     if $onWindowsScoop }}
	program = "C:\\Windows\\System32\\OpenSSH\\ssh-keygen.exe"
{{-     end }}
{{-   else }}
[gpg]
	# openpgp is the default format; gpg-agent (pinentry from gpg-agent.conf)
	# holds the passphrase. `gpg` is brew's on macOS, first on PATH.
	program = gpg
{{-   end }}
{{- end }}
# the ssh key itself gets passed through SSH, so it can be used even with the dummy secrets
# but for gh? tough luck
{{- if not .useDummySecrets }}
[credential "https://gist.github.com"]
	helper = !gh auth git-credential
[credential "https://github.com"]
	helper = !gh auth git-credential
{{-   $smtpLogin := (bitwarden "item" .smtp.bitwardenItem).login }}
# git send-email, through the server in .chezmoidata/smtp.toml. From: is
# user.name <user.email> above. There is deliberately no smtpPass: send-email
# asks the credential helpers below for the password instead, and the
# git-smtp-credential hookscripts put it there from Bitwarden.
[sendemail]
	smtpServer = {{ .smtp.host }}
	smtpServerPort = {{ .smtp.port }}
	smtpEncryption = ssl
	smtpUser = {{ $smtpLogin.username }}
{{- /* The helper that holds the SMTP password, per platform: Git Credential
       Manager on Windows (Windows Credential Manager), and the same Windows
       GCM from WSL, found through /mnt/c the way wsl-ssh-agent-relay finds
       npiperelay, so WSL reads the entry 00-nt/240 stored without one of its
       own. osxkeychain on macOS (the login keychain), where git is Apple's.
       Native Linux has none yet (README TODOs), so send-email prompts there.
       An empty helper first clears the list for this URL, dropping the one
       the git package registers in its own system gitconfig, so the store
       the hookscripts fill is the only one asked. */ -}}
{{-   $smtpHelper := "" }}
{{-   if eq .chezmoi.os "windows" }}
{{-     $smtpHelper = "manager" }}
{{-   else if eq .chezmoi.os "darwin" }}
{{-     $smtpHelper = "osxkeychain" }}
{{-   else if and (eq .chezmoi.os "linux") (ne (env "WSL_DISTRO_NAME") "") }}
{{-     $smtpHelper = output "sh" "-c" "for f in /mnt/c/Users/*/scoop/apps/git/current/*/bin/git-credential-manager.exe; do if [ -f \"$f\" ]; then printf '%s' \"$f\"; break; fi; done; true" | trim }}
{{-   end }}
{{-   if $smtpHelper }}
[credential "smtp://{{ .smtp.host }}:{{ .smtp.port }}"]
	helper =
	helper = {{ $smtpHelper }}
{{-   end }}
{{- end }}
{{- if $patatt }}
# patatt signs each git send-email patch with an X-Developer-Signature header,
# from the sendemail-validate hook init.templateDir hands out. One OpenPGP
# signature only: patatt (0.8.0) keeps a single signature per message, and its
# validator matches signatures by sender alone, so a second one from the same
# address would show up as BADSIG to anyone holding both keys. OpenPGP because
# it verifies against a verifier's ordinary gpg keyring, which SSH signatures
# do not. Set explicitly, as patatt otherwise falls back to user.signingKey,
# the SSH key under gpg.format = ssh. gpg is gpg.program above, else PATH's.
[patatt]
	signingkey = openpgp:{{ $gpgKey }}
{{- end }}
