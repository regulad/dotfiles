{{- /* Commit signing depends on the git that is first on PATH when this is
       rendered. SSH signing (gpg.format = ssh) arrived in git 2.34; an older
       git -- Apple's on Big Sur is 2.30 -- treats that value as fatal for
       EVERY git command, chezmoi's own included. So on an older git, sign
       with GPG through gpg-agent instead, using the managed key
       (private_dot_gnupg/*.asc, imported by the 145-gpg-keys hooks), and
       only when its secret half is actually in the keyring: gpg 2.1+ keeps
       each secret key as private-keys-v1.d/<keygrip>.key, and the keygrip
       is a property of the key, so its presence can be tested without
       running gpg. Otherwise signing is off rather than broken. The file is
       re-rendered on every apply, so once brew's newer git is on PATH the
       SSH branch takes over by itself. */ -}}
{{- $gitVersion := output "git" "--version" | regexFind "[0-9]+\\.[0-9]+" -}}
{{- $sshSigning := semverCompare ">=2.34.0" (printf "%s.0" $gitVersion) -}}
{{- $gpgHome := joinPath .chezmoi.homeDir ".gnupg" -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   $gpgHome = joinPath (env "APPDATA") "gnupg" -}}
{{- end -}}
{{- /* CC05EC2F760B63496EB014C3081BE541EA23ACF3 = Parker Wahle <regulad@regulad.xyz>, ed25519 primary (sign-capable) */ -}}
{{- $gpgFingerprint := "CC05EC2F760B63496EB014C3081BE541EA23ACF3" -}}
{{- $gpgKeygrip := "7DFA9C9B79F22E66CA6E94FE4BA36D81777A2A57" -}}
{{- $gpgSigning := and (not $sshSigning) (ne (lookPath "gpg") "") (stat (joinPath $gpgHome "private-keys-v1.d" (printf "%s.key" $gpgKeygrip))) -}}
{{- $signing := or $sshSigning $gpgSigning -}}
# THIS FILE IS GENERATED BY CHEZMOI!
# signing: {{ if $sshSigning }}ssh (git {{ $gitVersion }}){{ else if $gpgSigning }}gpg via gpg-agent (git {{ $gitVersion }} predates ssh signing){{ else }}off (git {{ $gitVersion }} predates ssh signing and the GPG secret key is not in the keyring){{ end }}
[user]
	name = Parker Wahle
	email = regulad@regulad.xyz
{{- if $sshSigning }}
	signingKey = ~/.ssh/id_rsa3072.pub
{{- else if $gpgSigning }}
	signingKey = {{ $gpgFingerprint }}
{{- end }}
[init]
	defaultBranch = master
[commit]
	gpgSign = {{ if $signing }}true{{ else }}false{{ end }}
[tag]
	gpgSign = {{ if $signing }}true{{ else }}false{{ end }}
# --atomic and --tags should be used on almost every push but there is no way to enable these by default
[push]
	autoSetupRemote = true
	default = current
	# not supported on GitHub but is supported by others
[core]
	autocrlf = false
	excludesFile = ~/.gitignore_global
{{- if and (eq .chezmoi.os "windows") (stat (joinPath .chezmoi.homeDir "scoop")) }}
	sshCommand = "\"C:\\Windows\\System32\\OpenSSH\\ssh.exe\""
{{- end }}
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[lfs "customtransfer.xet"]
	path = git-xet
	args = transfer
	concurrent = true
{{- if $sshSigning }}
[gpg]
	format = ssh
{{- if and (eq .chezmoi.os "windows") (stat (joinPath .chezmoi.homeDir "scoop")) }}
	program = "C:\\Program Files\\GnuPG\\bin\\gpg.exe"
{{- end }}
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
{{- if and (eq .chezmoi.os "windows") (stat (joinPath .chezmoi.homeDir "scoop")) }}
	program = "C:\\Windows\\System32\\OpenSSH\\ssh-keygen.exe"
{{- end }}
{{- else if $gpgSigning }}
[gpg]
	# openpgp is the default format; gpg-agent (pinentry from gpg-agent.conf)
	# holds the passphrase. `gpg` is brew's on macOS, first on PATH.
	program = gpg
{{- end }}
# the ssh key itself gets passed through SSH, so it can be used even with the dummy secrets
# but for gh? tough luck
{{- if not .useDummySecrets }}
[credential "https://gist.github.com"]
	helper = !gh auth git-credential
[credential "https://github.com"]
	helper = !gh auth git-credential
{{- end }}
