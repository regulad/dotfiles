# Linux
{{- if ne .chezmoi.os "linux" }}
.chezmoiscripts/00-linux/*
.config/systemd/
{{- else }}
# only one package manager's script applies per distro
{{-     if ne .chezmoi.osRelease.id "fedora" }}
.chezmoiscripts/00-linux/run_once_after_10-fedora.sh.tmpl
.chezmoiscripts/00-linux/run_after_20-dnf-packages.sh.tmpl
{{-     end }}
{{-     if not (or (eq .chezmoi.osRelease.id "ubuntu") (eq .chezmoi.osRelease.id "debian")) }}
.chezmoiscripts/00-linux/run_after_21-apt-packages.sh.tmpl
{{-     end }}
{{-     if not (contains "WSL2" (output "uname" "-r")) }}
# mask out the WSL-only scriptlets on a non-WSL Linux kernel
.chezmoiscripts/00-linux/run_once_after_05-wslview.sh
.chezmoiscripts/00-linux/run_once_after_06-wsl-gpu.sh
{{-     else }}
# special case: tailscale is handled from the windows side for WSL2 hosts
.chezmoiscripts/00-linux/run_once_after_90-tailscale.sh
{{-     end }}
{{- end }}
