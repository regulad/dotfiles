# only one package manager's script applies per distro
# NOTE: chezmoiignore patterns match the target-relative path, i.e. with the
# run_once_after_/run_after_ prefix and any .tmpl suffix already stripped.
# NOTE: chezmoi orders scripts by plain lexicographic string comparison of
# that stripped name (not numeric), so every script number in this directory
# MUST stay zero-padded to 3 digits (e.g. 020, not 20) or a two-digit script
# will silently sort after a three-digit one (e.g. "20-x" running after "100-y").
{{-     if ne .chezmoi.osRelease.id "fedora" }}
.chezmoiscripts/00-linux/010-fedora.sh
.chezmoiscripts/00-linux/012-vscode-dnf-repo.sh
.chezmoiscripts/00-linux/020-dnf-packages.sh
{{-     end }}
{{-     if not (or (eq .chezmoi.osRelease.id "ubuntu") (eq .chezmoi.osRelease.id "debian")) }}
.chezmoiscripts/00-linux/011-vscode-apt-repo.sh
.chezmoiscripts/00-linux/021-apt-packages.sh
{{-     end }}
{{-     if ne .chezmoi.osRelease.id "bluefin" }}
# Universal Blue rewrites ID=fedora to ID=bluefin in the image, which is what
# already keeps 020-dnf-packages.sh masked here -- there is no dnf transaction
# to be had against a read-only /usr. 022 is the brew-backed stand-in.
.chezmoiscripts/00-linux/022-brew-packages.sh
# The pre-rendered mascots are Bluefin branding and the MOTD only reaches for
# them when this directory exists, so everywhere else keeps the builtin small
# logo instead of shipping four files it will never read.
.config/fastfetch/logos/
{{-     end }}
{{-     if stat "/run/ostree-booted" }}
# Theos cannot be installed on an atomic host, and unlike the dnf/brew split
# above there is no stand-in script to swap in.
#
# bin/install-theos begins with a privileged system-package transaction for its
# build dependencies, and it picks that branch from what is on PATH, not from
# the distro ID: apt, then pacman, then dnf, then zypper. Universal Blue images
# ship dnf, so the redhat branch wins and runs `dnf group install c-development`
# plus a dozen packages against a /usr that belongs to the bootc image and is
# mounted read-only. That exits 3, and the preamble's `bash -e` turns that into
# a failed apply. The installer has no notion of a prefix other than the system
# one, so there is nothing to redirect at brew.
#
# ~/theos itself would be perfectly writable, so this stays recoverable by hand
# on an atomic host that actually wants the toolchain: layer the dependencies
# with rpm-ostree and run the hook manually, or do the whole install inside a
# toolbox/distrobox. .commonprofile exports $THEOS unconditionally and only puts
# it on PATH if the directory exists, so either route is picked up with no
# further changes here.
#
# Keyed on /run/ostree-booted rather than the distro ID, matching IS_ATOMIC in
# posix-preamble.sh: the file is written by ostree-prepare-root at boot and is
# the canonical signal, whereas the ID varies per image (bluefin, aurora,
# bazzite, silverblue, ...) and probing for the rpm-ostree binary would also
# catch a package-mode Fedora that merely has it installed. It is deliberately
# false inside the published container images -- those are built FROM ordinary
# fedora/ubuntu, where the dnf and apt branches both work, so they keep Theos.
.chezmoiscripts/00-linux/125-theos.sh
{{-     end }}
{{-     if or (ne (env "WSL_DISTRO_NAME") "") (eq (output "sh" "-c" "systemd-detect-virt --container --quiet && echo yes || echo no" | trim) "yes") }}
# VSCode is installed on native GNU/Linux desktops only -- not in containers,
# not in WSL.
#
# Containers have no display to run it on, and `code` plus its extensions is
# ~1.5 GB of the published images.
#
# WSL is excluded because the Linux `code` CLI manages the wrong directory
# there: Remote-WSL runs out of ~/.vscode-server/extensions, which the
# Windows-side client populates, while `code --install-extension` writes
# ~/.vscode/extensions. Verified on a live distro -- `code --list-extensions`
# matched ~/.vscode/extensions exactly (33/33) and differed from the effective
# remote set. There is no supported CLI or settings hook to drive the server's
# extension directory from inside the distro (`remote.WSL.defaultExtensions`
# does not exist; only Dev Containers has an equivalent), so this is left to
# the Windows client entirely.
#
# NOTE: systemd classifies WSL itself as a container -- `systemd-detect-virt
# --container` prints "wsl" and exits 0 inside a real WSL distro -- and it
# *also* prints "wsl" inside a Docker container whose host is WSL2-backed
# (Docker Desktop), because the microsoft kernel string wins over the
# container= env var. detect-virt therefore cannot distinguish the two on its
# own; that both arms of this `or` land on the same answer here is a
# coincidence of this rule, not a general truth.
#
# NOTE: phrased as "--quiet && echo yes || echo no" rather than comparing
# systemd-detect-virt's stdout, so that a missing systemd-detect-virt fails
# towards "not a container" (installing VSCode) instead of silently masking it.
.chezmoiscripts/00-linux/011-vscode-apt-repo.sh
.chezmoiscripts/00-linux/012-vscode-dnf-repo.sh
.chezmoiscripts/00-linux/160-install-vscode-ext.sh
{{-     end }}
{{-     if not (or (ne (env "WSL_DISTRO_NAME") "") (eq (output "sh" "-c" "systemd-detect-virt --container --quiet && echo yes || echo no" | trim) "yes")) }}
# The ephemeral tailnet join is for disposable hosts only: containers -- so it
# is in every docker build -- and WSL instances. A hardware machine is the
# opposite case. Its tailnet identity is long-lived and set up out of band, it
# is not thrown away and recreated, and re-registering it as a fresh ephemeral
# node on every boot would be actively wrong.
#
# Hardware hosts still get tailscale itself, from 090-tailscale.sh. What they do
# not get is this unit, the auth key that arms it, or the operator delegation
# that lets a --user unit drive the daemon -- that last one is a privilege
# decision that belongs to whoever administers the machine.
#
# Same predicate as the VSCode rule above, and it inherits the same caveats:
# systemd-detect-virt reports "wsl" for a genuine WSL distro *and* for a docker
# container on a WSL2-backed host, and the phrasing fails towards "not a
# container" when systemd-detect-virt is missing. Failing that way here means a
# host we cannot classify is treated as hardware, which is the safe direction --
# it withholds a credential rather than writing one out.
.config/systemd/user/tailscale-ephemeral.service
.secrets/tailscale-authkey
{{-     end }}
{{-     if eq (env "WSL_DISTRO_NAME") "" }}
# mask out the WSL-only scriptlets unless running inside a genuine WSL2 distro.
# WSL_DISTRO_NAME is only set by WSL's own session bootstrap; `uname -r` alone
# is unreliable since containers on a WSL2-backed Docker host (e.g. Docker
# Desktop) inherit the same host kernel string without being WSL themselves.
.chezmoiscripts/00-linux/004-wsl-binfmt-interop.sh
.chezmoiscripts/00-linux/006-wsl-gpu.sh
.chezmoiscripts/00-linux/007-ssh-agent-relay.sh
.config/systemd/user/ssh-agent-relay.service
{{-     end }}
{{- end }}
