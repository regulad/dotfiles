# Tailnet
{{- if ne .chezmoi.os "linux" }}
# tailscale-ephemeral.service is a systemd --user unit, so the key that feeds it
# is only ever read on Linux. On macOS and Windows the native client owns the
# tailnet identity and this would just be a live credential sitting on disk with
# nothing to redeem it. The linux branch below narrows this further, to
# containers and WSL only.
.secrets/tailscale-authkey
{{- end }}

