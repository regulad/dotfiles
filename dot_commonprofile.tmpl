# this file is sourced by both zsh and bash; should use common syntax
[ -r /etc/environment ] && set -a && . /etc/environment && set +a

export PATH="$HOME/.local/bin:$PATH"

# brew made some security changes recently, this opts out of the prompt.
# (HOMEBREW_NO_REQUIRE_TAP_TRUST=1 used to sit here too; brew deprecated it
# in favour of `brew trust`, which the hookscripts now run for each
# non-official tap/formula they use.)
export HOMEBREW_NO_ASK=1

{{ template "brew-mirror-env.sh" .brewMirror }}
# WSL stubs
export DONT_PROMPT_WSL_INSTALL=1

{{- /* Era pin, mirrored from posix-preamble.sh: a macOS that mainline brew
       no longer bottles for runs a brew pinned by 005-homebrew, and every
       brew invocation -- interactive ones included -- must carry these two
       or brew updates itself out from under the pin / reads the API. */}}
{{- $brewPin := dict }}
{{- $x86Pin := dict }}
{{- /* Apple Silicon up to Tahoe 26 also carries the Rosetta brew, x86_64 in
       /usr/local (00-macos/006, docs/rosetta-brew.md). */}}
{{- $rosettaBrew := false }}
{{- if eq .chezmoi.os "darwin" }}
{{-   $brewPin = index .brewTiers.legacy (printf "%s-%s" .macos.series .chezmoi.arch) | default dict }}
{{-   $rosettaBrew = and (eq .chezmoi.arch "arm64") (le .macos.major 26) }}
{{-   if $rosettaBrew }}
{{-     $x86Pin = index .brewTiers.legacy (printf "%s-amd64" .macos.series) | default dict }}
{{-   end }}
{{- end }}
{{- $nativeBrew := dict "prefix" .homebrewPrefix "pin" $brewPin "label" (printf "%s/%s" .macos.series .chezmoi.arch) }}
{{- /* uname -s, never -o: BSD uname only grew -o in macOS 13, and on older
       releases "$(uname -o)" is empty, which silently skipped this whole
       block (and brew with it). */}}
if [ "$(uname -s)" = "Darwin" ]; then
    # Prefix decided by chezmoi at init (.homebrewPrefix): /opt/homebrew on
    # Apple Silicon, /usr/local on Intel.
{{- if $rosettaBrew }}
    # ... unless this shell is translated by Rosetta -- an `intel` shell, see
    # below -- which gets the x86_64 brew in /usr/local instead, so that it
    # looks like a login on an Intel Mac.
    if [ "$(sysctl -n sysctl.proc_translated 2>/dev/null)" = 1 ]; then
        {{- includeTemplate "brew-profile-env.sh" (dict "prefix" "/usr/local" "pin" $x86Pin "label" (printf "%s/amd64 (Rosetta)" .macos.series)) | trim | nindent 8 }}

        # chezmoi must run natively: an x86_64 one would render every template
        # for Intel (.chezmoiignore.tmpl refuses to), and the native brew's
        # chezmoi is not on this shell's PATH at all. Run the native binary
        # -- brew's, or the get.chezmoi.io one in ~/.local/bin -- minus this
        # brew's environment, which would otherwise leak into the native
        # hookscripts.
        chezmoi() {
            local _cz
            for _cz in {{ .homebrewPrefix }}/bin/chezmoi "$HOME/.local/bin/chezmoi" "$HOME/bin/chezmoi" ""; do
                [ -x "$_cz" ] && break
            done
            if [ -z "$_cz" ]; then
                echo "error: no native chezmoi found; run \`arm\` first" >&2
                return 1
            fi
            /usr/bin/env -u HOMEBREW_PREFIX -u HOMEBREW_CELLAR -u HOMEBREW_REPOSITORY \
                -u HOMEBREW_NO_AUTO_UPDATE -u HOMEBREW_NO_INSTALL_FROM_API -u HOMEBREW_FORCE_BREWED_CURL \
                PATH="{{ .homebrewPrefix }}/bin:{{ .homebrewPrefix }}/sbin:$PATH" \
                /usr/bin/arch -arm64 "$_cz" "$@"
        }
    else
        {{- includeTemplate "brew-profile-env.sh" $nativeBrew | trim | nindent 8 }}
    fi

    # `intel` / `arm`: replace this shell with a fresh login shell running as
    # x86_64 (under Rosetta) or arm64, from a clean environment -- only what a
    # real login would bring along -- so that it comes up as if this were a
    # native login on that arch: PATH rebuilt by path_helper, the matching
    # brew, every universal binary started from it in the same arch.
    _arch_login() {
        local _arch="$1" _n
        set --
        for _n in HOME USER LOGNAME SHELL TERM COLORTERM TERM_PROGRAM TERM_PROGRAM_VERSION \
            LANG LC_ALL TMPDIR SSH_AUTH_SOCK SSH_CONNECTION SSH_CLIENT SSH_TTY __CF_USER_TEXT_ENCODING; do
            eval "[ -n \"\${$_n+x}\" ] && set -- \"\$@\" \"$_n=\${$_n}\""
        done
        exec /usr/bin/env -i "$@" /usr/bin/arch "-$_arch" "${SHELL:-/bin/zsh}" -l
    }
    intel() { _arch_login x86_64; }
    arm() { _arch_login arm64; }
{{- else }}
    {{- includeTemplate "brew-profile-env.sh" $nativeBrew | trim | nindent 4 }}
{{- end }}
    export PATH="/Applications/Ghostty.app/Contents/MacOS/:$PATH"

    # MacPorts (016-macports): CLI only, no ports installed by this repo.
    # Ahead of brew on PATH, so a port that IS installed wins the collision.
    if [ -d /opt/local/bin ]; then
        export PATH="/opt/local/bin:/opt/local/sbin:$PATH"
    fi

    # LLVM is keg-only on macOS. Expose clangd without overriding Apple's
    # compiler tools (or an existing clangd supplied by Xcode).
    export PATH="$PATH:$HOMEBREW_PREFIX/opt/llvm/bin"

    export PATH="$(brew --prefix ruby)/bin:$PATH"
    export PATH="$(brew --prefix rustup)/bin:$PATH"
    export PATH="$HOMEBREW_PREFIX/lib/ruby/gems/4.0.0/bin:$PATH"

    export PKG_CONFIG_PATH="$(brew --prefix python3)/lib/pkgconfig:$PKG_CONFIG_PATH"

    # do not clobber system-wide install
    export ANDROID_SDK_ROOT="${ANDROID_SDK_ROOT:-$HOME/Library/Android/sdk}"

    export PNPM_HOME="$HOME/Library/pnpm"
{{- if eq .chezmoi.os "darwin" }}
{{-   if and (eq .chezmoi.arch "arm64") (ge .macos.major .containers.appleMinMacos) }}

    # The Docker Engine API for the docker CLI and for tools that read
    # DOCKER_HOST but not docker contexts: socktainer over apple/container
    # (00-macos/035-container-runtime; .chezmoidata/containers.toml).
    export DOCKER_HOST="unix://{{ .homebrewPrefix }}/var/run/socktainer/.socktainer/container.sock"
{{-   else }}

    # The Docker Engine API for the docker CLI and for tools that read
    # DOCKER_HOST but not docker contexts: colima's dockerd
    # (00-macos/035-container-runtime; .chezmoidata/containers.toml).
    export DOCKER_HOST="unix://$HOME/.colima/default/docker.sock"
{{-   end }}
{{- end }}
elif [ "$(uname -s)" = "Linux" ]; then
    eval "$({{ .homebrewPrefix }}/bin/brew shellenv)"

    # Make brew's TLS clients trust the OS store.
    #
    # brew links git, curl, python, ruby and friends against its own openssl@3,
    # which reads brew's `ca-certificates` formula bundle -- Mozilla's public
    # roots and nothing else. It never consults /etc/pki, so the private CAs
    # that 140-ca-certs installs into the system trust store are invisible to
    # it, and anything they sign fails with "unable to get local issuer
    # certificate (20)". /usr/bin/git verifies the same URL fine, which makes
    # this look like a server problem rather than a client one.
    #
    # The shellenv above is what makes it bite: it puts $HOMEBREW_PREFIX/bin
    # ahead of /usr/bin, so brew's git wins whenever brew has one -- and brew
    # can acquire git as a transitive dependency, or from Bluefin's own
    # cli.Brewfile, without it ever appearing in a list in this repo.
    #
    # The system bundle carries the public roots AND the private anchors, and
    # update-ca-trust regenerates it, so pointing at it is strictly a superset
    # of what brew ships. Fedora's path first, Debian/Ubuntu's second.
    for _ca_bundle in \
        /etc/pki/tls/certs/ca-bundle.crt \
        /etc/ssl/certs/ca-certificates.crt
    do
        if [ -r "$_ca_bundle" ]; then
            export SSL_CERT_FILE="$_ca_bundle"   # openssl
            export CURL_CA_BUNDLE="$_ca_bundle"  # curl
            export GIT_SSL_CAINFO="$_ca_bundle"  # git
            break
        fi
    done
    unset _ca_bundle

    export PATH="$(brew --prefix ruby)/bin:$PATH"
    export PATH="$HOMEBREW_PREFIX/lib/ruby/gems/4.0.0/bin:$PATH"

    # inetutils is kept unlinked by 00-linux/030-brew-extras.sh because its
    # unprefixed ping6/traceroute shadow the host's capability-bearing ones
    # and cannot open a raw socket. Its keg goes on the TAIL of PATH instead:
    # telnet/ftp/rsh (which the host lacks) still resolve, and anything
    # /usr/bin also has keeps winning.
    if [ -d "$HOMEBREW_PREFIX/opt/inetutils/bin" ]; then
        export PATH="$PATH:$HOMEBREW_PREFIX/opt/inetutils/bin"
    fi

    export PKG_CONFIG_PATH="$(brew --prefix python3)/lib/pkgconfig:$PKG_CONFIG_PATH"

    # do not clobber system-wide install
    export ANDROID_SDK_ROOT="${ANDROID_SDK_ROOT:-$HOME/Android/sdk}"

    export PNPM_HOME="$HOME/.local/share/pnpm"
fi

export NODE_COMPILE_CACHE="$HOME/.cache/node-compile-cache"
mkdir -p $NODE_COMPILE_CACHE

# legacy
export ANDROID_HOME="$ANDROID_SDK_ROOT"

# sdkmanager-managed sdkmanager overrides brew-managed sdkmanager
export PATH="$ANDROID_HOME/platform-tools:$PATH"
export PATH="$ANDROID_HOME/tools:$PATH"

if [[ -f /etc/os-release ]]; then
  . /etc/os-release
  if [[ "$ID" == "ubuntu" ]]; then
    # Add snap bin directories to PATH if they exist
    [[ -d /snap/bin ]] && export PATH="/snap/bin:$PATH"
    [[ -d /var/lib/snapd/snap/bin ]] && export PATH="/var/lib/snapd/snap/bin:$PATH"
  fi
fi

# Set browser to wslview if in WSL (provided by ~/.local/bin/wslview, a thin
# explorer.exe wrapper -- no wslu package required)
if grep -qi wsl /proc/version 2>/dev/null; then
    export BROWSER=wslview
fi

# pnpm: global binaries live in $PNPM_HOME/bin from pnpm 11.0.0 on
# (pnpm/pnpm#10986) and in $PNPM_HOME itself before that, and every global
# command -- `pnpm bin -g` included -- refuses to run unless exactly the right
# one is on PATH, so pnpm cannot be asked. The era pins carry pnpm 8 and 10
# as well as 11 and 12, so both layouts are live; the major version decides.
# It comes from brew's opt link (../Cellar/pnpm/<version>) when brew has pnpm,
# which starts no process, and from `pnpm --version` otherwise. Unknown (pnpm
# not installed yet) means the current layout.
_pnpm_version=
if [ -n "${HOMEBREW_PREFIX:-}" ] && [ -L "$HOMEBREW_PREFIX/opt/pnpm" ]; then
  _pnpm_version="$(readlink "$HOMEBREW_PREFIX/opt/pnpm")"
  _pnpm_version="${_pnpm_version##*/}"
elif command -v pnpm >/dev/null 2>&1; then
  _pnpm_version="$(pnpm --version 2>/dev/null)"
fi
_pnpm_bin="$PNPM_HOME/bin"
case "${_pnpm_version%%.*}" in
  '' | *[!0-9]*) ;;
  *) if [ "${_pnpm_version%%.*}" -lt 11 ]; then _pnpm_bin="$PNPM_HOME"; fi ;;
esac
case ":$PATH:" in
  *":$_pnpm_bin:"*) ;;
  *) export PATH="$_pnpm_bin:$PATH" ;;
esac
unset _pnpm_version _pnpm_bin
# pnpm end

# deno
export DENO_INSTALL="$HOME/.deno"
export DENO_NO_UPDATE_CHECK=1
export PATH="$DENO_INSTALL/bin:$PATH"
# deno end

# cargo on rustup systems
if [ -n "$(command -v rustup-init)" ]; then
    . "$HOME/.cargo/env"
else
    export PATH="$HOME/.cargo/bin:$PATH"
fi

# GO
export PATH="$HOME/go/bin:$PATH"

# Theos, the iOS toolchain. Set unconditionally, and deliberately *before*
# anything installs it: bin/install-theos only leaves shell rc files alone when
# it finds THEOS already exported, and every rc it would otherwise append to is
# managed by this repo. See .chezmoitemplates/theos.sh.
export THEOS="$HOME/theos"
[ -d "$THEOS/bin" ] && export PATH="$THEOS/bin:$PATH"

# ssh daemon
unset _bw_sock
case "$(uname -s)" in
  Darwin)
    for _agent_sock in \
      "$HOME/.bitwarden-ssh-agent.sock" \
      "$HOME/Library/Containers/com.bitwarden.desktop/Data/.bitwarden-ssh-agent.sock"
    do
      [ -S "$_agent_sock" ] && export SSH_AUTH_SOCK="$_agent_sock" && break
    done
    ;;
  Linux)
    if [ -n "${WSL_DISTRO_NAME:-}" ]; then
      # WSL: always the Windows agent, relayed from the openssh-ssh-agent
      # named pipe into .wsl-ssh-agent.sock by ssh-agent-relay.service (see
      # .chezmoiscripts/00-linux/007-ssh-agent-relay.sh); agent-agnostic on
      # the Windows side (Bitwarden, native OpenSSH, 1Password, ... whatever
      # is bound to that pipe). Set unconditionally, not probed: the relay is
      # a user unit that starts alongside the first login shell after a
      # boot, so the socket may not exist yet at this point -- it will by the
      # time anything connects to it. WSL_DISTRO_NAME rather than
      # /proc/version, which containers on a WSL-backed host share.
      export SSH_AUTH_SOCK="$HOME/.wsl-ssh-agent.sock"
    else
      for _agent_sock in \
        "$HOME/.bitwarden-ssh-agent.sock" \
        "$HOME/snap/bitwarden/current/.bitwarden-ssh-agent.sock" \
        "$HOME/.var/app/com.bitwarden.desktop/data/.bitwarden-ssh-agent.sock"
      do
        [ -S "$_agent_sock" ] && export SSH_AUTH_SOCK="$_agent_sock" && break
      done
    fi
    ;;
esac
unset _bw_sock

export VISUAL="$(command -v nvim || command -v vim)"
# Telemetry opt-outs, mirrored for Windows in registry-user.reg. Claude Code
# takes DO_NOT_TRACK as an opt-out too, which also stops its feature-flag
# fetching and so the features gated on it; that cost is accepted. Vercel's
# tools mostly ignore DO_NOT_TRACK (only turbo, `npx skills` and `npx plugins`
# read it), so each gets its own.
export DO_NOT_TRACK=1
export VERCEL_PLUGIN_TELEMETRY=off  # the Claude Code / Codex plugin's hooks
export VERCEL_TELEMETRY_DISABLED=1  # vercel CLI, also the sandbox CLI and SDK
export VERCEL_SANDBOX_TELEMETRY_DISABLED=1
export NEXT_TELEMETRY_DISABLED=1  # next, next-devtools-mcp (which wants exactly 1)
export TURBO_TELEMETRY_DISABLED=1
export EVE_TELEMETRY_DISABLED=1
export HOMEBREW_NO_ENV_HINTS=1

# keychain is the fallback for a host with no agent socket. Never on WSL: the
# relay socket above is the agent there even before it exists, and the WSL
# images ship without keychain (see .github/workflows/wsl-package.yml).
if [ -z "${WSL_DISTRO_NAME:-}" ] && { [ -z "${SSH_AUTH_SOCK:-}" ] || [ ! -S "${SSH_AUTH_SOCK:-}" ]; }; then
  if command -v keychain >/dev/null 2>&1; then
    eval "$(keychain --eval --quiet --noask)"
  else
    echo "warning: no Bitwarden SSH agent socket found, and keychain is not installed; SSH_AUTH_SOCK not set" >&2
  fi
fi

# AWS
export AWS_ENDPOINT_URL=https://s3.regulad.xyz
export AWS_PROFILE=ceph
