# Configuration
IgnoreUnknown WarnWeakCrypto,UseKeychain
AddKeysToAgent yes
HashKnownHosts yes
VerifyHostKeyDNS yes

# In name order, and ssh keeps the first value it reads for each option, so an
# earlier file wins: 98-homelab, generated by regulad/homelab
# (docs/homelab-exports.md), comes before the hand-written 99-* files.
Include config.d/*

Host *
    # Try to use the user regulad on all systems
    User regulad
    # Every host offers id_rsa3072 unless an earlier block tagged it otherwise
    # (jetkvm's rsa4096): Tag, like the rest, keeps its first value. Hosts
    # whose user isn't regulad, as root on most of 98-homelab's, need no Tag
    # line of their own.
    Tag rsa3072
    # ~/.ssh/known_hosts is this machine's state, unmanaged, and ssh writes
    # the keys accepted here to it, the first file. The known_hosts.d files
    # are managed and only read: homelab's host keys, under each host's
    # inventory name, which 98-homelab sets as its HostKeyAlias; and
    # github.com's. Listed by name: UserKnownHostsFile takes no globs.
    UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/known_hosts.d/homelab ~/.ssh/known_hosts.d/github
    PreferredAuthentications publickey
    EnableEscapeCommandline yes
    # Bitwarden's SSH agent signs RSA keys with SHA-512 no matter which
    # algorithm the sign request asks for (bitwarden/clients#16681, still
    # broken in Desktop 2026.8.0). Fedora's crypto-policies put rsa-sha2-256
    # ahead of rsa-sha2-512, so ssh asks for -256, gets -512, and rejects it:
    # "agent key RSA ... returned incorrect signature type". `^` just hoists
    # rsa-sha2-512 to the front of whatever list is in effect -- the same
    # order upstream OpenSSH ships, nothing added or removed.
    PubkeyAcceptedAlgorithms ^rsa-sha2-512

# General idea of the fallback:
#    1. Try to get the agent's private key by the public key
#    2. If the private key isn't in the agent, and it exists on disk, load it. Else, crash.
Match tagged rsa3072
{{- if not .useDummySecrets }}
    IdentityFile ~/.ssh/id_rsa3072.pub
    IdentityFile ~/.ssh/id_rsa3072  # fallback
{{- end }}
    IdentitiesOnly yes

Match tagged rsa4096
{{- if not .useDummySecrets }}
    IdentityFile ~/.ssh/id_rsa4096.pub
    IdentityFile ~/.ssh/id_rsa4096  # fallback
{{- end }}
    IdentitiesOnly yes