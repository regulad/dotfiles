{{- /* What 155-syncthing applies on this OS, from .chezmoidata/syncthing.toml:
       the hub's name and addresses; each folder with this OS's path and the
       lines to keep in its .stignore (none for a folder with ownStignore);
       and the options. The hub's ID is not in it: the scripts decrypt that at
       run time. */ -}}
{{- $os := .chezmoi.os -}}
{{- $ignores := prepend .syncthing.ignores "// From dotfiles' .chezmoidata/syncthing.toml, by 155-syncthing" -}}
{{- $folders := list -}}
{{- range .syncthing.folders -}}
{{-   $lines := $ignores -}}
{{-   if get . "ownStignore" }}{{ $lines = list }}{{ end -}}
{{-   $folders = append $folders (dict "id" .id "label" .label "path" (index .path $os) "ignores" $lines) -}}
{{- end -}}
{{- dict "hub" (dict "name" .syncthing.hub.name "addresses" (list .syncthing.hub.address)) "folders" $folders "options" .syncthing.options | toPrettyJson -}}
