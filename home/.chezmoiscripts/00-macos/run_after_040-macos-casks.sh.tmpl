{{- end }}
{{- if eq $brewEra "sonoma" }}
	"kde-connect"  # arm64-only upstream and needs Ventura; cask added 2026
{{- else if eq $brewEra "" }}
	"kde-connect"
{{- end }}
{{- /* No syncthing-app (`syncthing` on the pre-2025 eras): Syncthing is the
       brew formula on every Mac, run by launchd as the user's agent, which
       155-syncthing starts and which uninstalls the app. Started at login,
       the app would run a second Syncthing on the same configuration. */}}
{{- if not $pre2025 }}
	"discord"  # proprietary freeware # needs macOS 13.0, as the cask declares; 080-vencord injects Vencord into it
{{- end }}
	"regulad/tap/epson-et8500" # super proprietary 😈 # Epson lists the package for 10.7 through 27
{{- if not $pre2024 }}
	"regulad/tap/cricut-design-space" # super proprietary 😈 # Cricut's own requirement is macOS 12 or later, as the cask now declares (depends_on macos: :monterey)
{{- end }}
{{- if or (eq $brewEra "") (has $brewEra (list "current" "sonoma")) }}
	"Gcenx/wine/game-porting-toolkit"  # the cask requires Sonoma
{{- end }}
{{- end }}
)

if [ "$HAS_BREW" = "true" ]; then
	# Non-official taps in the list above must be trusted before brew will
	# load anything from them -- the replacement for the deprecated
	# HOMEBREW_NO_REQUIRE_TAP_TRUST=1 (see 00-linux/030-brew-extras.sh).
	# Trusting by tap name works before the tap is installed and is
	# idempotent, so it runs every apply. brew_trust (preamble) is a no-op on
	# an era-pinned brew old enough to have no `trust` subcommand.
	brew_trust --tap regulad/tap
	brew_trust --tap Gcenx/wine

	# Migration: nextcloud-vfs was deprecated 2026-04-01 (discontinued upstream).
	# Since desktop client 33.0 the classic and VFS (File Provider) clients are one
	# package, tracked by the plain `nextcloud` cask. The two casks conflict, so an
	# older host has to drop the -vfs one before the loop below can install its
	# replacement. Account config lives in ~/Library and survives the swap.
	if brew list --cask nextcloud-vfs &>/dev/null; then
		echo "debug: replacing deprecated nextcloud-vfs cask with nextcloud" >&2
		brew uninstall --cask -q nextcloud-vfs
	fi

	# Migration: Vesktop gave way to Discord itself, with Vencord injected into
	# it by 080-vencord, since Vesktop cannot receive rich presence. Dropping
	# the cask from the list never uninstalled it. Its data, ~/.config/vesktop
	# behind the Application Support link, stays.
	if brew list --cask vesktop &>/dev/null; then
		echo "notice: uninstalling the vesktop cask; Discord with Vencord injected replaces it (080-vencord)" >&2
		brew uninstall --cask -q vesktop
	fi

	# Tailscale ships two macOS builds that cannot coexist: the App Store app
	# (id 1475387142, bundle io.tailscale.ipn.macos, network extension) and the
	# standalone pkg (bundle io.tailscale.ipn.macsys, system extension) -- the
	# same pkg the tailscale-app cask installs. Neither puts the CLI on PATH by
	# itself: the pkg ships only the bundle, and the standalone app's CLI
	# integration setting, which writes /usr/local/bin/tailscale, needs Ventura;
	# dot_commonrc.tmpl aliases the bundled binary where nothing else has. Either
	# may already be on a host without brew knowing: the App Store one never is,
	# and the standalone one isn't when it was installed by hand. Skip the cask in
	# both cases rather than letting `brew install --cask -f` re-run the pkg
	# installer (and prompt for sudo) over a working install. mas comes from
	# 020-brew-packages, so it is on PATH.
	if mas list 2>/dev/null | grep -q '^1475387142 '; then
		echo "debug: tailscale present from the App Store; skipping the tailscale-app cask" >&2
		TAILSCALE_PRESENT=1
	elif pkgutil --pkg-info com.tailscale.ipn.macsys &>/dev/null; then
		echo "debug: standalone tailscale pkg already installed; skipping the tailscale-app cask" >&2
		TAILSCALE_PRESENT=1
	else
		TAILSCALE_PRESENT=0
	fi

	# The parsec cask is the same parsec-macos.pkg Parsec's site offers, and
	# the app updates itself in place, so a host where it was installed by hand
	# has the pkg's receipt but no brew record. As with tailscale above, skip
	# the cask there rather than re-run the pkg installer under sudo.
	if pkgutil --pkg-info tv.parsec.www &>/dev/null; then
		PARSEC_PRESENT=1
	else
		PARSEC_PRESENT=0
	fi

	# tailscale-app is `tailscale` on the pre-2025 eras, hence the two spellings.
	for cask in "${BREW_CASKS_MACOS[@]}"; do
		case "$cask" in
			tailscale-app | tailscale)
				[ "$TAILSCALE_PRESENT" -eq 1 ] && continue
				;;
			parsec)
				if [ "$PARSEC_PRESENT" -eq 1 ]; then
					echo "debug: parsec pkg already installed; skipping the parsec cask" >&2
					continue
				fi
				;;
		esac
		if ! brew list --cask "$cask" &>/dev/null; then
			brew install --cask -q "$cask" -f
		fi
	done
fi
{{- if not .useHeadless }}

# Parsec has no start-at-login setting on macOS (only its Windows build does),
# so it becomes a login item here. That opens it once the user logs in, not at
# boot: with FileVault on there is no automatic login, so after a restart
# someone unlocks the Mac first (at the screen, or over Screen Sharing).
#
# Login items go through System Events, which takes Automation consent for
# whatever runs osascript. macOS asks for it with a prompt on the Mac's
# screen; an SSH session has nowhere to show it, and the AppleEvent sits until
# it times out (two minutes by default, hence the shorter timeout). Either
# failure is a warning, and the next apply from the Mac's own session adds the
# item. Gated like the cask above, on useHeadless; the app itself is checked
# at run time because a hand-installed or not-yet-installed Parsec is possible
# either way.
PARSEC_APP="/Applications/Parsec.app"

# Prints true or false; fails when System Events can't be asked.
parsec_is_login_item() {
	osascript \
		-e 'with timeout of 20 seconds' \
		-e "tell application \"System Events\" to return (path of every login item) contains \"$PARSEC_APP\"" \
		-e 'end timeout'
}

if [ ! -d "$PARSEC_APP" ]; then
	echo "notice: $PARSEC_APP not found, skipping its login item" >&2
elif ! PARSEC_LOGIN_ITEM="$(parsec_is_login_item 2>&1)"; then
	echo "warning: could not read the login items to add Parsec ($PARSEC_LOGIN_ITEM); allow Automation of System Events, or apply from the Mac's own session" >&2
elif [ "$PARSEC_LOGIN_ITEM" = "true" ]; then
	echo "debug: Parsec is already a login item" >&2
elif ! PARSEC_LOGIN_ITEM="$(osascript \
		-e 'with timeout of 20 seconds' \
		-e "tell application \"System Events\" to make login item at end with properties {path:\"$PARSEC_APP\", hidden:true}" \
		-e 'end timeout' 2>&1)"; then
	echo "warning: could not add Parsec as a login item ($PARSEC_LOGIN_ITEM)" >&2
elif [ "$(parsec_is_login_item 2>&1)" = "true" ]; then
	echo "notice: added Parsec as a login item; it opens the next time you log in" >&2
else
	echo "warning: added Parsec as a login item, but the login items read back without it" >&2
fi
{{- end }}
