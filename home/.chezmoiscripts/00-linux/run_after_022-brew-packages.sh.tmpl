{{ template "posix-preamble.sh" . }}
{{ template "fedora-packages.sh" . }}
# An atomic Fedora's (Bluefin's) CLI tools, with brew: the formula each entry of
# .chezmoidata/fedora-packages.toml names (FEDORA_BREW_FORMULAE). The same
# entries give package-mode Fedora its dnf packages (020-dnf-packages) and an
# atomic host its layered ones (02-bluefin/020-rpm-ostree-packages), so the
# kinds of Fedora can't drift apart: an entry the image already ships, or that
# has no formula, says so there instead of in a list of omissions here.
#
# The dnf and apt runners cannot work here: /usr belongs to the bootc image and
# is read-only. brew is the supported route for CLI tooling, per Bluefin's own
# docs. Masked everywhere but Bluefin (.chezmoiignore.tmpl).

if [ "$HAS_BREW" != "true" ]; then
	# Bluefin does not bake brew into the image; brew-setup.service lays it down
	# in /var/home/linuxbrew on first boot. If that hasn't finished yet, the
	# preamble's own fallback would race it by pointing Homebrew's installer at
	# the same prefix, so refuse rather than fight the unit.
	echo "error: no brew on an atomic host, can't install system packages" >&2
	echo "notice: brew-setup.service provisions it on first boot; check with" >&2
	echo "notice:   systemctl status brew-setup.service" >&2
	exit 1
fi

brew install -q --formula "${FEDORA_BREW_FORMULAE[@]}"

# NOTE: no `brew upgrade` here, deliberately. Bluefin drives upgrades itself on
# a schedule via brew-update.timer and brew-upgrade.timer; racing those from an
# apply would just duplicate work and can leave a half-upgraded prefix behind.
