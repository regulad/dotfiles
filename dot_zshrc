# run once: sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
# ohmyzsh
export ZSH="$HOME/.oh-my-zsh"
# ZSH_THEME="crcandy"
plugins=(
    git
    macos
    npm
    gradle
    gh
    zsh-autosuggestions
)
zstyle ':omz:alpha:lib:git' async-prompt no
zstyle ':omz:update' mode disabled
source $ZSH/oh-my-zsh.sh
# ohmyzsh end

# load common
source ~/.commonrc

# prompt
#
# This is only the base: user@host, cwd, and the prompt character. The git
# segment and the OSC 133 shell-integration marker are spliced in afterwards by
# ~/.config/zsh/20-git-prompt.zsh and ~/.config/zsh/90-osc133.zsh, which the
# loop at the bottom of this file sources once each, in numeric order. That
# ordering is the whole mechanism -- 20 lands the git segment before the
# terminator, 90 then appends the marker that has to come last.
PROMPT=$(cat << 'EOF'
%{$fg_bold[green]%}%n@%m%{$reset_color%}:%{$reset_color%}%B%F{blue}%~%f%b%(#.#.$) 
EOF
)

# override with short prompt on Android
if [ "$(uname -o)" = "Android" ]; then
    PROMPT="%# "
    # 20-git-prompt.zsh runs after this and would happily splice the branch
    # into "%# ", which defeats the point of the override.
    ZSH_GIT_PROMPT_DISABLE=1
fi

# source other zsh files
for f in ~/.config/zsh/*.zsh(N); do
  source "$f"
done
