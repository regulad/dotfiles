#!{{ .homebrewPrefix }}/bin/bash
# Terminal.app's startup command, set in its profile (Shell > Run command):
# /Users/regulad/.cargo/bin/terminal_polyfill /Users/regulad/.bootstrap.sh
# terminal_polyfill (.chezmoidata/cargo-tools.toml) carries out the OSC 52
# copies and OSC 777 notifications Terminal.app lacks.
exec {{ .homebrewPrefix }}/bin/tmux new-session -A -s term-${TERM_SESSION_ID:0:8}
