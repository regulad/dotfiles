#!/usr/bin/env bash
set -euo pipefail

# Minimal replacement for wslu's wslview: opens a URL/path in the Windows
# side of a WSL2 install via explorer.exe. explorer.exe always exits 1
# regardless of outcome, so that's swallowed here rather than propagated.

target="$1"

case "$target" in
	*://*) ;;
	*) target="$(wslpath -w "$target")" ;;
esac

# Windows PATH inheritance is disabled by default in our WSL images.
explorer="$(command -v explorer.exe || true)"
explorer="${explorer:-/mnt/c/Windows/explorer.exe}"
if [ ! -x "$explorer" ]; then
	echo "error: explorer.exe not found at $explorer" >&2
	exit 1
fi
"$explorer" "$target" || true
