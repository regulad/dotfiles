{{- /* The managed slice of ~/.claude.json -- mcpServers only. Claude Code
       keeps ~70 keys of mutable state (oauth, machineID, per-repo history,
       caches) in the same file; the modify_ stub merges this document over
       it. Config that Claude Code itself treats as settings belongs in
       ~/.claude/settings.json (claude-settings.json). */ -}}
{
  "mcpServers": {
    "ddg-search": {
      "type": "stdio",
      "command": "uvx",
      "args": ["duckduckgo-mcp-server"],
      "env": {}
    },
{{- /* MDN's hosted MCP server (mdn/mcp): MDN's search, pages and browser
       compatibility data, with no sign-in. Mozilla labels it experimental and
       keeps queries for first-party analytics unless this header is sent, as
       its README says. The repo carries no marketplace, so there is no plugin
       to install. Codex's entry is in dot_codex/modify_private_config.toml. */}}
    "mdn": {
      "type": "http",
      "url": "https://mcp.mdn.mozilla.net/",
      "headers": {
        "X-Moz-1st-Party-Data-Opt-Out": "1"
      }
    }
{{- if not .useDummySecrets }},
{{- /* Sentry's hosted MCP server, with the Bitwarden token that
       ~/.sentryclirc carries too (private_dot_sentryclirc.tmpl). The server
       takes a Sentry API token directly under the `Sentry-Bearer` scheme, and
       a configured Authorization header turns Claude Code's OAuth fallback
       off, so no machine signs in through /mcp.

       The URL is the sentry plugin's own (its .claude-plugin/plugin.json,
       installed by claude-plugins.sh for its skills), query string and all:
       Claude Code takes a plugin server that points at the same endpoint as
       a user-scope one for a duplicate and connects only this definition.
       A different path or query would make two servers, the plugin's
       signing in with OAuth. Unscoped, as the CLIs are: the token's own
       access is the limit. The same server for Codex, which has no plugin
       to match, is in dot_codex/modify_private_config.toml. */}}
{{- $sentry := bitwardenFields "item" "sentry.io" }}
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp?utm_source=plugin",
      "headers": {
        "Authorization": {{ printf "Sentry-Bearer %s" $sentry.token.value | toJson }}
      }
    },
{{- /* Supabase's hosted MCP server, with the access token that
       ~/.supabase/access-token carries too (dot_supabase). The server takes
       it as a plain bearer token, which turns the OAuth fallback off as the
       Sentry entry above does. The URL is the supabase plugin's own
       (agents/claude/.mcp.json in supabase-community/supabase-plugin), so
       this definition stands in for the plugin's OAuth copy. Supabase's
       read_only and project_ref switches are query parameters, which would
       break that match; the token's own access is the limit instead. Codex's
       entry is in dot_codex/modify_private_config.toml. */}}
{{- $supabase := bitwardenFields "item" "supabase.com" }}
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp",
      "headers": {
        "Authorization": {{ printf "Bearer %s" $supabase.token.value | toJson }}
      }
    },
{{- /* GitHub's hosted MCP server (github/github-mcp-server), with the
       github.com item's `dotfiles` token. Read-only (X-MCP-Readonly), and
       only the actions and github_support_docs_search toolsets
       (X-MCP-Toolsets): workflow runs and job logs, and a search of GitHub's
       docs, which `gh` has no command for. Everything else stays with `gh`.
       The configured Authorization header keeps Claude Code from an OAuth
       sign-in. Codex's entry is in dot_codex/modify_private_config.toml. */}}
{{- $github := bitwardenFields "item" "b05e2c79-05ca-430c-9221-789ec9bc5564" }}
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": {{ printf "Bearer %s" $github.dotfiles.value | toJson }},
        "X-MCP-Toolsets": "actions,github_support_docs_search",
        "X-MCP-Readonly": "true"
      }
    },
{{- /* Google's Developer Knowledge MCP server: search and retrieval over
       Google's developer docs (web.dev, developer.chrome.com, Android,
       Firebase, Google Cloud, Go, the Gemini API and more), with the
       developers.google.com item's `token`. That is an API key homelab's
       tofu/gcp makes in the regulad project (developer-knowledge-mcp),
       restricted to the Developer Knowledge API alone and to no
       application, since several machines use it. Google takes it as
       X-Goog-Api-Key and never in the URL. Configured directly, not
       through Google's google-cloud-developer plugin (google/skills),
       whose other skills are Google Cloud tooling. Codex's entry is in
       dot_codex/modify_private_config.toml. */}}
{{- $devknowledge := bitwardenFields "item" "developers.google.com" }}
    "google-developer-knowledge": {
      "type": "http",
      "url": "https://developerknowledge.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": {{ $devknowledge.token.value | toJson }}
      }
    },
{{- /* The shared memory server: basic-memory behind regulad/homelab's
       memory.regulad.xyz, with the static client token that homelab's
       ingress checks. claude.ai's custom connector of the same URL reaches
       it through OAuth; this user-scope definition, at the same URL, stands
       in for that connector in Claude Code, so no session signs in and one
       without a claude.ai login gets it too. The token is the
       memory.regulad.xyz item's token field, copied there from homelab's
       SOPS (memory_client_token); rotate both together. Codex's entry is in
       dot_codex/modify_private_config.toml. */}}
{{- $memory := bitwardenFields "item" "memory.regulad.xyz" }}
    "memory": {
      "type": "http",
      "url": "https://memory.regulad.xyz/mcp",
      "headers": {
        "Authorization": {{ printf "Bearer %s" $memory.token.value | toJson }}
      }
    }
{{- end }}
{{- if and (eq .chezmoi.os "windows") (eq .chezmoi.arch "amd64") }},
{{- /* Claude's own headless Ghidra: the pyghidra-mcp server that
       00-nt/503-pyghidra-mcp keeps running, gated the same way as that
       script and pyghidra-mcp in .chezmoidata/python-tools.toml. HTTP, not a
       stdio server per session: Ghidra locks a project to one process. The
       name replaces an older, hand-added `ghidra` entry of the same shape. */}}
    "ghidra": {
      "type": "http",
      "url": "http://127.0.0.1:{{ .pyghidraMcp.port }}/mcp"
    }
{{- end }}
  }
}
