{{- /* The managed slice of ~/.config/Claude/claude_desktop_config.json.
       preferences.epitaxyPrefs is deliberately absent: starred sessions and
       pinned order are state the old full-file template blanked on every
       apply. */ -}}
{
  "preferences": {
    "coworkScheduledTasksEnabled": false,
    "ccdScheduledTasksEnabled": false,
    "coworkWebSearchEnabled": true,
    "remoteToolsDeviceName": "{{ .chezmoi.hostname }}"
  },
  "mcpServers": {
{{- if not .useDummySecrets }}
    "nextcloud-caldav": {
{{- if eq .chezmoi.os "darwin" }}
      "command": "/opt/homebrew/bin/pnpx",
{{- else if eq .chezmoi.os "windows" }}
      "command": "{{ env "USERPROFILE" | replace "\\" "\\\\" }}\\scoop\\shims\\pnpx.EXE",
{{- else }}
      "command": "/home/linuxbrew/.linuxbrew/bin/pnpx",
{{- end }}
      "args": ["caldav-mcp"],
      "env": {
        "CALDAV_BASE_URL": "https://nextcloud.regulad.xyz/remote.php/dav/calendars/{{ (bitwarden "item" "7bc3cc6e-0ae5-4140-98b8-c7b3f65c9d44").login.username }}/",
        "CALDAV_USERNAME": "{{ (bitwarden "item" "7bc3cc6e-0ae5-4140-98b8-c7b3f65c9d44").login.username }}",
        "CALDAV_PASSWORD": "{{ (index (bitwardenFields "item" "7bc3cc6e-0ae5-4140-98b8-c7b3f65c9d44") "caldav-mcp").value }}"
      }
    }
{{- end }}
  }
}
