{
	"terminal.integrated.persistentSessionReviveProcess": "never",
	"terminal.integrated.automationProfile.windows": {
  	"path": "C:\\Windows\\System32\\cmd.exe"
	},
	"terminal.integrated.profiles.windows": {
  	"Command Prompt": {
    	"path": [
      	"${env:windir}\\Sysnative\\cmd.exe",
      	"${env:windir}\\System32\\cmd.exe"
    	],
    	"args": [],
    	"icon": "terminal-cmd"
  	}
	},
	"terminal.integrated.defaultProfile.windows": "Command Prompt",
	"editor.formatOnSave": true,
	"explorer.confirmDelete": false,
	"editor.suggestSelection": "first",
	"vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
	"java.configuration.checkProjectSettingsExclusions": false,
	"python.languageServer": "Pylance",
	"git.enableSmartCommit": true,
	"git.autofetch": true,
	"git.confirmSync": false,
	"telemetry.enableCrashReporter": false,
	"telemetry.enableTelemetry": false,
	"editor.cursorBlinking": "smooth",
	"files.autoSave": "afterDelay",
	"files.autoSaveDelay": 2000,
	"editor.wordWrap": "on",
	"diffEditor.codeLens": true,
	"spellright.documentTypes": ["markdown", "latex", "plaintext"],
	"spellright.notificationClass": "warning",
	"xml.codeLens.enabled": true,
	"lime.browser": "firefox",
	"markdownlint.config": {},
	"liquid.format": true,
	"window.closeWhenEmpty": true,
	"files.eol": "\n",
	"redhat.telemetry.enabled": false,
	"java.project.importOnFirstTimeStartup": "automatic",
	"workbench.editorAssociations": {
		"*.ipynb": "jupyter.notebook.ipynb"
	},
	"python.showStartPage": false,
	"terminal.integrated.tabs.enabled": true,
	"remote.extensionKind": {
		"asvetliakov.vscode-neovim": ["workspace"]
	},
	"explorer.confirmDragAndDrop": false,
	"[dart]": {
		"editor.formatOnSave": true,
		"editor.formatOnType": true,
		"editor.rulers": [80],
		"editor.selectionHighlight": false,
		"editor.suggest.snippetsPreventQuickSuggestions": false,
		"editor.suggestSelection": "first",
		"editor.tabCompletion": "onlySnippets",
		"editor.wordBasedSuggestions": "off"
	},
	"github.copilot.enable": {
		"*": false
	},
{{- /* chat.disableAIFeatures: "Disable and hide built-in AI features provided
       by GitHub Copilot, including chat and inline suggestions." Copilot is
       built into VS Code (GitHub.copilot-chat, under resources/app/extensions),
       so it can only be switched off, not uninstalled; this takes its chat
       and agents view, and the "Sign in" it puts in the title bar, out of the
       way. Claude Code (anthropic.claude-code, .chezmoidata/vscode.toml) is a
       Marketplace extension of its own and is not one of them.
       https://github.com/microsoft/vscode/blob/4d906305fff57359e107c5013fab0d2bb8c82984/src/vs/workbench/contrib/chat/browser/chat.shared.contribution.ts#L2423-L2428 */}}
	"chat.disableAIFeatures": true,
	"[markdown]": {
		"editor.defaultFormatter": "yzhang.markdown-all-in-one"
	},
	"githubPullRequests.createOnPublishBranch": "never",
	"window.autoDetectColorScheme": true,
	"cmake.configureOnOpen": true,
	"workbench.colorTheme": "Visual Studio Light",
	"liveServer.settings.donotShowInfoMsg": true,
	"prettier.useTabs": true,
	"update.showReleaseNotes": false,
	"javascript.updateImportsOnFileMove.enabled": "always",
	"typescript.updateImportsOnFileMove.enabled": "always",
	"debug.javascript.debugByLinkOptions": "on",
	"cSpell.userWords": [
		"animatronic",
		"animatronics",
		"Chica",
		"followees",
		"Webzone",
		"xkcd"
	],
	"mypy-type-checker.importStrategy": "fromEnvironment",
	"mypy-type-checker.preferDaemon": true,
	"mypy-type-checker.reportingScope": "workspace",
	"extensions.experimental.affinity": {
		"asvetliakov.vscode-neovim": 1
	}
{{- /* WSL only, detected as .chezmoiignore.tmpl does: there VS Code is a
       Wayland window under WSLg (XDG_SESSION_TYPE, registry-user.reg), drawn
       at the 2x ~/.wslgconfig rounds Windows' scale up to.
       window.zoomLevel brings it to 150% of Windows' scale, as QT_SCALE_FACTOR
       and GDK_DPI_SCALE do for Qt and GTK: each step is x1.2, and
       1.2^-1.58 = 0.75. window.controlsStyle "custom" has VS Code draw its own
       minimize/maximize/close: the native ones, which Electron draws there,
       come up without maximize under WSLg's Weston.
       https://github.com/microsoft/vscode/blob/4d906305fff57359e107c5013fab0d2bb8c82984/src/vs/workbench/electron-browser/desktop.contribution.ts#L202-L256 */}}
{{- if ne (env "WSL_DISTRO_NAME") "" }},
	"window.zoomLevel": -1.58,
	"window.controlsStyle": "custom"
{{- end }}
}
