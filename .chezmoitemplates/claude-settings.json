{{- /* The managed slice of ~/.claude/settings.json. permissions.allow is
       deliberately absent: it is the per-machine accumulation of approved
       commands (state), and the permissions map deep-merges so the live
       allow list survives every apply. deny IS managed: Bash only on
       Windows, and the empty list elsewhere is deliberate -- arrays replace
       wholesale on merge, so it scrubs a previously-applied Bash deny from
       non-Windows machines. */ -}}
{
  "permissions": {
    "deny": [
{{- if eq .chezmoi.os "windows" }}
      "Bash"
{{- end }}
    ],
    "defaultMode": "auto"
  },
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "theme": "auto",
  "editorMode": "vim",
{{- /* Claude Code's default, pinned: Syncthing's claude folder
       (.chezmoidata/syncthing.toml) carries each machine's transcript sweep to
       every other, so all of them must keep transcripts equally long. */}}
  "cleanupPeriodDays": 30,
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true
}
