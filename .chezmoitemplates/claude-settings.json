{{- /* The managed slice of ~/.claude/settings.json. permissions.allow is
       deliberately absent: it is the per-machine accumulation of approved
       commands (state), and the permissions map deep-merges so the live
       allow list survives every apply. deny IS managed: Bash only on
       Windows, and the empty list elsewhere is deliberate -- arrays replace
       wholesale on merge, so it scrubs a previously-applied Bash deny from
       non-Windows machines. */ -}}
{{- /* ask is managed too, wholesale like deny: the actions that leave the
       machine or touch another service's state, which open a permission
       dialog even in auto mode, instead of the classifier refusing them and
       Parker re-granting them in chat. git push is deliberately absent:
       Parker approves pushes in chat, often ahead of time, and an ask rule
       would prompt even then, since ask outranks allow. A deny or ask rule
       matches any subcommand of a compound command, past leading variable
       assignments, but only the shape written; an implicit POST (`gh api`
       with -f fields and no method) is left to the classifier. The
       rules are PowerShell's on Windows, where Bash is denied, and Bash's
       elsewhere. Secrets, DSNs and provider resources belong to
       regulad/homelab, so the gh secret/variable, wrangler and vercel
       rules mostly catch an agent trying to do homelab's job. */ -}}
{{- $shell := "Bash" -}}
{{- if eq .chezmoi.os "windows" }}{{ $shell = "PowerShell" }}{{ end -}}
{{- $ask := list -}}
{{- range list
      "gh pr create *" "gh pr edit *" "gh pr comment *" "gh pr review *"
      "gh pr merge *" "gh pr close *" "gh pr reopen *"
      "gh issue create *" "gh issue edit *" "gh issue comment *"
      "gh issue close *" "gh issue reopen *" "gh issue delete *"
      "gh release create *" "gh release edit *" "gh release upload *" "gh release delete *"
      "gh repo create *" "gh repo edit *" "gh repo rename *" "gh repo archive *" "gh repo delete *"
      "gh secret set *" "gh secret delete *" "gh variable set *" "gh variable delete *"
      "gh api *POST*" "gh api *PATCH*" "gh api *PUT*" "gh api *DELETE*" "gh api graphql *mutation*"
      "wrangler secret *" "vercel env add *" "vercel env rm *" -}}
{{-   $ask = append $ask (printf "%s(%s)" $shell .) -}}
{{- end }}
{
  "permissions": {
    "deny": [
{{- if eq .chezmoi.os "windows" }}
      "Bash"
{{- end }}
    ],
    "ask": {{ $ask | toJson }},
    "defaultMode": "auto"
  },
  "worktree": {
    "baseRef": "head"
  },
{{- /* No "Generated with Claude Code" line in PR descriptions: the
       regulad-llm-usage skill's footer stands in for it. attribution.commit
       is left at its default, so commits keep the Co-Authored-By trailer.
       sessionUrl is true on purpose, not by default: a commit or PR made
       from a web or Remote Control session keeps its Claude-Session trailer
       and session link, so it can be traced to the conversation. */}}
  "attribution": {
    "pr": "",
    "sessionUrl": true
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "theme": "auto",
  "editorMode": "vim",
{{- /* Claude Code's default, pinned: Syncthing's claude folder
       (.chezmoidata/syncthing.toml) carries each machine's transcript sweep to
       every other, so all of them must keep transcripts equally long. */}}
  "cleanupPeriodDays": 30,
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true,
{{- /* Every interactive session connects Remote Control when it starts, so
       Parker can follow and steer it from another device. "true" means
       always; unset would defer to an organization default. Needs Claude
       Code 2.1.119 or later. */}}
  "remoteControlAtStartup": true
}
