# Sourced by every zsh, before anything else -- and in particular before
# /etc/zprofile, which is the point of this file.
#
# Fedora's keychain package ships /etc/profile.d/keychain.sh, which every login
# shell runs (/etc/zprofile -> /etc/profile -> profile.d). It calls
# `keychain --quiet --immediate` with every private key in ~/.ssh, and its
# agent is empty after a `wsl --shutdown`, so the first login shell sat on an
# invisible passphrase prompt until ^C. Under WSL there is nothing for it to
# do: ssh-agent-relay.service relays the Windows agent into
# ~/.wsl-ssh-agent.sock (see .chezmoiscripts/00-linux/007-ssh-agent-relay.sh),
# and .commonprofile points SSH_AUTH_SOCK at that. The hook's first line
# returns when KEYCHAIN_DONE is set, so set it whenever the relay answers.
#
# The relay starts with the user manager, i.e. alongside the first login shell
# after a boot, so its socket gets up to 3 s to appear. `ssh-add -l` exits 0
# (keys loaded) or 1 (agent reachable, no keys); anything else -- 2, or 124
# from timeout -- means the pipe is not working and keychain is left to run.
# The probe costs about a second (npiperelay.exe starting on the Windows side),
# once per login shell.
if [[ -o login && -n "${WSL_DISTRO_NAME:-}" && -z "${KEYCHAIN_DONE:-}" ]]; then
  () {
    local sock="$HOME/.wsl-ssh-agent.sock" i
    [[ -e "$HOME/.config/systemd/user/default.target.wants/ssh-agent-relay.service" ]] || return
    for i in {1..30}; do
      [[ -S "$sock" ]] && break
      sleep 0.1
    done
    [[ -S "$sock" ]] || return
    SSH_AUTH_SOCK="$sock" timeout 3 ssh-add -l >/dev/null 2>&1
    (( $? < 2 )) && export KEYCHAIN_DONE=1
  }
fi
