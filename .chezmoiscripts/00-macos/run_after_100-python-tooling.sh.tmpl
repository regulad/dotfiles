{{ template "posix-preamble.sh" . }}
{{- /* Era-pinned host (see .chezmoidata/brew-tiers.toml)? uv itself is still
       installed -- from brew, or from MacPorts (017-macports-packages) on the
       eras before it reached homebrew-core in 2024 -- but nothing is
       installed *through* it there: the `uv tool install` set below is
       specialised tooling, not part of the general environment an old Mac
       is brought up for, and every entry carries its own Python-version
       story. hatch (homebrew-core 2022) is left out on Mojave. $brewEra is
       "" on a Tier 1 host. */ -}}
{{- $brewEra := "" }}
{{- if eq .chezmoi.os "darwin" }}
{{-   $p := index .brewTiers.legacy (printf "%s-%s" .macos.series .chezmoi.arch) | default dict }}
{{-   if $p }}{{ $brewEra = $p.era }}{{ end }}
{{- end }}
{{- $pinned := ne $brewEra "" }}
{{- $pre2022 := has $brewEra (list "mojave") }}
{{- $pre2024 := has $brewEra (list "mojave" "catalina" "bigsur") }}
# poetry and uv are both always brew-installed here: MANAGER is guaranteed to be
# "brew" on macOS by posix-preamble.sh, since dnf/apt require Linux-only files.
brew install -q poetry
{{- if $pre2024 }}
# uv is a MacPorts package on this era (017); make sure it is there.
if ! command -v uv &>/dev/null; then
	echo "error: uv is missing; 017-macports-packages should have installed it" >&2
	exit 1
fi
{{- else }}
brew install -q uv
{{- end }}
{{- if $pinned }}
echo "notice: era-pinned brew ({{ $brewEra }}); uv is installed but no tools are installed through it on this host" >&2
{{- else }}

# NOTE: poetry is for legacy workflows.
# NOTE: `uv tool install` replaces pipx
# can install with `pipx i <package>`
# or `uv tool install <package>`
# NOTE: uv deliberately ignores upper bounds on requires-python,
#       which boosts speed since pip likes to "backstep" and take
#       the highest package version which supports the python version.
#
#       This leads to issues with code that requires stable ABI presence.
#
#       I have chosen to only download tools with uv against known-good python versions.
#
#       to native package managers that test against specific python versions.
#
#       This can be changed if the python-requires spec at https://packaging.python.org/en/latest/specifications/core-metadata/#core-metadata-requires-python
#       is ever updated to better accomidate the Python ecosystem with its alternative implementations and ABIs.
#
#       Until then, for cli apps, I will be using the latest version of Cpython that the app has been tested against.
#       For example, pre-commit tests against https://github.com/pre-commit/pre-commit/blob/main/.github/workflows/main.yml 3.13 as its newest supported python version.
#
#       Some tools here like "mangadex-downloader" have a pre-prepared Dockerfile that uses a pinned Python version.
#       Those versions are mirrored in the selected version for the tools.
uv tool install -q ruff # astral-backed
uv tool install -q ty   # astral-backed

uv tool install --python "pypy@3.11" -q --with "bgutil-ytdlp-pot-provider" "yt-dlp[pin,pin-curl-cffi,pin-secretstorage,pin-deno]"
uv tool install --python cp314 -q keydive
uv tool install --python cp313 -q pre-commit
uv tool install --python cp313 -q "mangadex-downloader[optional]"
uv tool install --python cp310 -q "git+https://github.com/regulad/keymap-renderer.git@master"

# NOTE: pinned to the frida-server version the device actually runs -- the
#       binding and the server only speak to each other at the same version, and
#       16.7.0 is the newest re.frida.server hosted for roothide devices at
#       https://miticollo.github.io/repos/roothide/Packages, since the 17.x major
#       family has yet to be ported there. frida-tools' own frida>=16.2.2,<17.0.0
#       is loose enough to drift to 16.7.19, so the --with is what holds it. See
#       the long NOTE in 00-linux/run_after_100-python-tooling.sh.tmpl.
uv tool install --python cp312 -q --with "frida==16.7.0" "frida-tools==13.7.1"

# NOTE: 2.3 onward are LLM slop, and 2.2 is the last version that didn't change
#       the schema. cp313 because 2.2 wants pydantic-core 2.27.2, which has no
#       cp314 wheel. The --with pins cap rendercv 2.2's transitive deps that it
#       left loose -- rendercv-fonts, click, rich and jinja2 -- because 2.2 is
#       frozen while `uv tool upgrade --all` re-resolves anything unpinned. See
#       the long NOTE in 00-linux/run_after_100-python-tooling.sh.tmpl for what
#       each cap prevents.
uv tool install --python cp313 -q \
	--with "rendercv-fonts<0.5" \
	--with "click<8.2" \
	--with "rich<11" \
	--with "jinja2<4" \
	"rendercv[full]@2.2"

uv tool install --python cp314 -q pymobiledevice3
uv tool install --python cp314 -q claude-swap
{{- end }}

# like in the JS ecosystem, some python tools are available as tools/bottles from brew
brew install -q \
{{- if not $pre2022 }}
	hatch \
{{- end }}
	autopep8
{{- if not $pinned }}

uv tool upgrade --quiet --all
{{- end }}
