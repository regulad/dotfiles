{{ template "posix-preamble.sh" . }}
# Certificate installation
CERT_PATHS=(
	"$HOME/.x509/ipa-ca.crt"          # home.arpa
	"$HOME/.x509/regulad.internal.crt"        # regulad.internal
	"$HOME/.x509/cohensstore003.internal.crt" # cohensstore003.internal
	"$HOME/.x509/pve-root-ca.pem"     # gonkputer nonspecific
)

for CERT_PATH in "${CERT_PATHS[@]}"; do
	# Check if certificate is already trusted
	if ! security verify-cert -c "$CERT_PATH" &>/dev/null; then
		if [ "$CAN_SUDO" = "true" ]; then
			sudo security add-trusted-cert -d -r trustRoot -k /Library/Keychains/System.keychain "$CERT_PATH"
		else
			security add-trusted-cert -d -r trustRoot -k ~/Library/Keychains/login.keychain-db "$CERT_PATH"
			echo "warning: added certificate to user keychain only (no sudo available)" >&2
		fi
	fi
done

{{ if not .useDummySecrets -}}
# Client certificate (matches the "My" store import on NT). `security import`
# has no idempotent "already present" check of its own, but reliably exits 45
# (errSecDuplicateItem, -25299 truncated to a Unix exit status) when the
# identity is already in the keychain -- treat that as success, anything else
# as a real failure.
#
# Templated out entirely under useDummySecrets, matching the GNU/Linux script:
# the source file is dot_x509/encrypted_dotfiles.p12.age, so the decrypted .p12
# is absent wherever the state was applied with --exclude encrypted.
if ! security import "$HOME/.x509/dotfiles.p12" -k ~/Library/Keychains/login.keychain-db -P ""; then
	import_status=$?
	if [ "$import_status" -ne 45 ]; then
		echo "error: failed to import client certificate (exit $import_status)" >&2
		exit 1
	fi
	echo "note: client certificate already present in keychain" >&2
fi
{{- end }}
