{{ template "posix-preamble.sh" . }}
# The Apple-shipped prerequisites, before anything that needs a compiler or
# git: 005-homebrew (its git checkout, and on Intel every bottle install needs
# the developer tools), 016-macports, and the source builds further down.
# Anything missing that cannot be put right here stops the apply: every
# script after this one would otherwise fail in its own, less obvious way.
#
# The Xcode Command Line Tools, at no older a version than brew accepts on
# this macOS, whether or not an Xcode.app is the active developer directory.
# A macOS upgrade leaves the previous release's CLT behind, and brew then
# refuses every source build ("Your Command Line Tools are too outdated") --
# from inside a `brew` that can still exit 0 when the build was an
# auto-update's reinstall, so the apply used to carry on past it.
#
# Installed the way Homebrew's own installer does it: a placeholder file
# makes `softwareupdate` list the Command Line Tools package, which is then
# installed by label, and softwareupdate blocks until that is done. Not
# `xcode-select --install`: it only opens Apple's prompt and returns at once.
#
# The license of an Xcode.app. Until it is accepted brew refuses to run at
# all (brew.sh checks it on every command), and each Xcode update asks again.
# Accepted for the active Xcode, or else for /Applications/Xcode.app, which
# 125-theos makes active later in the same apply.
#
# Rosetta 2 lives here too, on Apple Silicon: the other Apple-shipped
# prerequisite that comes through softwareupdate, needed before any Intel-only
# cask or binary is run.
#
# Idempotent and sudo-free once all of it is in place. Runs every apply so a
# macOS upgrade or an Xcode update is caught on the next one.

CLT_DIR=/Library/Developer/CommandLineTools

# The oldest CLT brew accepts on this macOS: MacOS::CLT.minimum_version in
# brew's os/mac/xcode.rb. From 26 on the CLT version is the macOS version.
case "$VERSION_ID" in
	11) clt_minimum=12.5 ;;
	12) clt_minimum=13.0 ;;
	13) clt_minimum=14.0 ;;
	14) clt_minimum=15.0 ;;
	15) clt_minimum=16.0 ;;
	*) clt_minimum="$VERSION_ID" ;;
esac

# The installed CLT's major.minor, read the way brew reads it: from the
# package receipt, but only while the tools are on disk (removing the
# directory leaves the receipt behind). Empty when there are none.
clt_version() {
	[ -x "$CLT_DIR/usr/bin/clang" ] || return 0
	pkgutil --pkg-info=com.apple.pkg.CLTools_Executables 2>/dev/null \
		| awk '/^version:/ {print $2}' | cut -d. -f1-2
}

clt_ok() {
	local version
	version="$(clt_version)"
	[ -n "$version" ] && macos_version_ge "$version" "$clt_minimum"
}

if clt_ok; then
	echo "debug: Command Line Tools $(clt_version) present" >&2
else
	require_sudo "003-macos-prereqs"
	installed="$(clt_version)"
	if [ -n "$installed" ]; then
		echo "notice: Command Line Tools $installed are older than the $clt_minimum brew requires on macOS $VERSION_ID; updating them via softwareupdate" >&2
	else
		echo "debug: installing the Xcode Command Line Tools via softwareupdate" >&2
	fi

	# softwareupdate only checks that the placeholder exists, so it is the
	# user's: removing it then needs no sudo, which may have timed out by the
	# time a half-gigabyte install finishes. One left by someone else is left.
	placeholder=/tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress
	if [ ! -e "$placeholder" ]; then
		touch "$placeholder"
		trap 'rm -f "$placeholder"' EXIT
	fi
	# Both label formats softwareupdate has used: "* Label: Command Line
	# Tools for Xcode 27.0-27.0" and "   * Command Line Tools (macOS Mojave
	# version 10.14) for Xcode-10.3". Newest wins when several are listed,
	# by the version that ends the label (numeric sort on it, not `sort -V`).
	label="$(softwareupdate -l 2>/dev/null \
		| grep -B 1 -E 'Command Line Tools' \
		| awk -F'*' '/^ *\*/ {print $2}' \
		| sed -e 's/^ *Label: //' -e 's/^ *//' -e 's/ *$//' \
		| awk '{ v = $0; sub(/.*[^0-9.]/, "", v); print v "\t" $0 }' \
		| sort -t. -k1,1n -k2,2n | tail -n1 | cut -f2-)"
	if [ -z "$label" ]; then
		echo "error: softwareupdate offers no Command Line Tools for macOS $VERSION_ID; install the Command Line Tools for Xcode $clt_minimum or newer from https://developer.apple.com/download/all/ and apply again" >&2
		exit 1
	fi
	echo "debug: softwareupdate installing $label" >&2
	sudo softwareupdate -i "$label"

	if ! clt_ok; then
		echo "error: Command Line Tools are at ${installed:-nothing} after installing $label, still older than the $clt_minimum brew requires on macOS $VERSION_ID" >&2
		exit 1
	fi
	echo "notice: Command Line Tools $(clt_version) ready at $CLT_DIR" >&2

	# An Xcode.app that is already active stays so (125-theos needs it); a
	# missing or vanished developer directory becomes the CLT.
	if [ ! -d "$(xcode-select -p 2>/dev/null)" ]; then
		sudo xcode-select --switch "$CLT_DIR"
	fi
fi

active_dev_dir="$(xcode-select -p 2>/dev/null || true)"
case "$active_dev_dir" in
	*.app/Contents/Developer) xcode_dev="$active_dev_dir" ;;
	*) xcode_dev=/Applications/Xcode.app/Contents/Developer ;;
esac
# Its own xcodebuild, not the /usr/bin shim, which only knows the active one.
xcodebuild="$xcode_dev/usr/bin/xcodebuild"
if [ -x "$xcodebuild" ]; then
	if "$xcodebuild" -license check &>/dev/null; then
		echo "debug: Xcode license accepted for ${xcode_dev%/Contents/Developer}" >&2
	else
		require_sudo "003-macos-prereqs"
		echo "notice: accepting the Xcode license for ${xcode_dev%/Contents/Developer}" >&2
		sudo "$xcodebuild" -license accept
		if ! "$xcodebuild" -license check &>/dev/null; then
			echo "error: the Xcode license for ${xcode_dev%/Contents/Developer} is still not accepted; run: sudo $xcodebuild -license" >&2
			exit 1
		fi
	fi
fi

if [ "$(uname -m)" = "arm64" ]; then
	if arch -x86_64 /usr/bin/true 2>/dev/null; then
		echo "debug: Rosetta 2 present" >&2
	else
		# despite being an sbin, this is usable by non-root users. til
		echo "debug: installing Rosetta 2" >&2
		/usr/sbin/softwareupdate --install-rosetta --agree-to-license
	fi
fi
