{{ template "posix-preamble.sh" . }}
{{- $login := (bitwarden "item" .smtp.bitwardenItem).login }}
# Puts git send-email's SMTP password, from Bitwarden (.chezmoidata/smtp.toml),
# into the login keychain through git-credential-osxkeychain, the helper
# .gitconfig pins for smtp://<host>:<port>, so send-email never prompts for
# it. The Windows twin is 00-nt/240-git-smtp-credential.ps1. Masked under
# useDummySecrets in .chezmoiignore.
#
# Apple's git by absolute path (/usr/bin/git: the Command Line Tools' or
# Xcode's), not whatever is first on PATH. send-email runs under Apple's git
# as well, brew's being kept unlinked (brew-packages-macos.sh), and a keychain
# item's access list trusts the program that created it, so an item written by
# Apple's helper is read back by Apple's helper without a prompt.
#
# run_after_, every apply. The keychain is asked first, so an apply with
# nothing to do writes nothing, and a password rotated in Bitwarden goes in on
# the next apply.
#
# Reading or writing the item needs the login keychain unlocked, and an SSH
# session sees it locked even while someone is logged in at the Mac (see
# 141-client-cert). Locked is a warning, leaving the credential for an apply
# after `security unlock-keychain` or from the Mac's own session.
#
# The credential is rendered into this script, so it passes through chezmoi's
# temporary copy of it for the length of the run, as 145-gpg-keys's passphrase
# does. It reaches the helper on stdin through printf, a builtin, never as an
# argument.
KEYCHAIN="$HOME/Library/Keychains/login.keychain-db"
URL='smtp://{{ .smtp.host }}:{{ .smtp.port }}'
SMTP_USER='{{ $login.username | replace "'" "'\\''" }}'
SMTP_PASSWORD='{{ $login.password | replace "'" "'\\''" }}'
QUERY="$(printf 'protocol=smtp\nhost=%s\nusername=%s' '{{ .smtp.host }}:{{ .smtp.port }}' "$SMTP_USER")"

osxkeychain() {
	/usr/bin/git credential-osxkeychain "$@"
}

stored_password() {
	printf '%s\n' "$QUERY" | osxkeychain get 2>/dev/null | sed -n 's/^password=//p'
}

if security show-keychain-info "$KEYCHAIN" 2>&1 | grep -q "User interaction is not allowed"; then
	echo "warning: the login keychain is locked in this session (SSH?) and cannot be unlocked without the Mac's GUI; SMTP credential for $URL not stored. Run security unlock-keychain and apply again, or apply from the Mac's own session" >&2
	exit 0
fi

stored="$(stored_password)"
if [ "$stored" = "$SMTP_PASSWORD" ]; then
	echo "debug: SMTP credential for $URL already in the login keychain" >&2
	exit 0
fi

# Apple's osxkeychain before git 2.45 leaves an existing item alone on
# `store` rather than updating it, so a stale password is erased first.
if [ -n "$stored" ]; then
	printf '%s\n' "$QUERY" | osxkeychain erase
fi
if ! printf '%s\npassword=%s\n' "$QUERY" "$SMTP_PASSWORD" | osxkeychain store \
	|| [ "$(stored_password)" != "$SMTP_PASSWORD" ]; then
	echo "error: git-credential-osxkeychain did not keep the SMTP credential for $URL" >&2
	exit 1
fi
if [ -z "$stored" ]; then
	echo "notice: stored the SMTP credential for $URL in the login keychain" >&2
else
	echo "notice: updated the SMTP credential for $URL in the login keychain (the password changed in Bitwarden)" >&2
fi
