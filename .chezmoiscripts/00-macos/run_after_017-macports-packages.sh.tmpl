{{ template "posix-preamble.sh" . }}
{{- /* Ports that stand in for formulae the era's homebrew-core checkout
       cannot supply (see 020-brew-packages, 030-brew-extras and the shared
       python-tooling.sh template). MacPorts supplies modern runtimes for
       old macOS, using its binary archives where available. Checked
       2026-10-17: uv and Python 3.14 have archives down to Catalina and
       earlier. Runtime dependencies are native, not Rosetta substitutes.
       $brewEra is "" on a Tier 1 host, and the array is then empty. */ -}}
{{- $brewEra := "" }}
{{- if eq .chezmoi.os "darwin" }}
{{-   $p := index .brewTiers.legacy (printf "%s-%s" .macos.series .chezmoi.arch) | default dict }}
{{-   if $p }}{{ $brewEra = $p.era }}{{ end }}
{{- end }}
{{- $pre2024 := has $brewEra (list "catalina" "bigsur") }}
{{- $pre2025 := has $brewEra (list "catalina" "bigsur" "monterey") }}
{{- $pre2026 := has $brewEra (list "catalina" "bigsur" "monterey" "ventura") }}
# MacPorts packages: only what brew cannot provide on this era, nothing else.
MACPORTS_PACKAGES=(
{{- if $pre2024 }}
	retry    # not in homebrew-core until 2024
	sshpass  # not in homebrew-core until 2024
	python312  # Frida's runtime; these snapshots stop at Python 3.10/3.11
{{- end }}
{{- if $pre2025 }}
	uv       # Monterey has uv 0.1.21, which predates `uv tool`; earlier eras lack it
	python313  # RenderCV's runtime; no 3.13 formula in these snapshots
{{- end }}
{{- if $pre2026 }}
	python314  # 100-python-tooling explicitly selects /opt/local/bin/python3.14
{{- end }}
)

if [ "${#MACPORTS_PACKAGES[@]}" -eq 0 ]; then
	echo "debug: brew covers everything on this host; no MacPorts packages" >&2
	exit 0
fi

if [ ! -x /opt/local/bin/port ]; then
	echo "error: MacPorts is not installed (016-macports should have run)" >&2
	exit 1
fi

require_sudo "017-macports-packages"
# -N: non-interactive. Already-installed ports are a no-op.
sudo /opt/local/bin/port -q -N install "${MACPORTS_PACKAGES[@]}"
