## Mac App Store applications (mas comes from brew, hence the brew preamble)

# Xcode is never touched by this script. Beyond mas not installing it cleanly,
# the installed version is deliberately left alone: Xcode is often pinned to a
# specific release for toolchain/SDK compatibility, and a blanket `mas update`
# would silently bump it along with everything else.
XCODE_APP_ID="497799835"

MAS_APP_IDS=(
	"937984704"   # Amphetamine
	"1352778147"  # Bitwarden
	"462058435"   # Microsoft Excel
	"462062816"   # Microsoft PowerPoint
	"462054704"   # Microsoft Word
	"946399090"   # Telegram Lite
	"6745342698"  # uBlock Origin Lite
	"1472432422"  # Wayback Machine
	"1295203466"  # Windows App
#	"$XCODE_APP_ID"   # Xcode  # xcode doesn't work right through mas
)

if ! command -v mas &>/dev/null; then
	# mas comes from 020-brew-packages, which leaves it out on the Mojave era:
	# its bottles start at Catalina. No mas, no App Store installs.
	echo "note: mas is not installed on this host; skipping App Store apps" >&2
elif [ "$HAS_BREW" = "true" ]; then
	# mas is distributed via brew
	#
	# `mas update` with no arguments upgrades every outdated App Store app,
	# Xcode included, so build the list ourselves and leave Xcode out.
	# `mas outdated` prints one "<id> <name> (<installed> -> <available>)" per
	# line; the first field is the numeric app id. `mas update <id>...` then
	# upgrades only the named apps.
	outdated_ids=$(mas outdated | awk -v xcode="$XCODE_APP_ID" '$1 ~ /^[0-9]+$/ && $1 != xcode { print $1 }')
	if [ -n "$outdated_ids" ]; then
		# shellcheck disable=SC2086  # one numeric id per word; splitting is the point
		mas update $outdated_ids
	else
		echo "note: no App Store apps to update (Xcode is excluded on purpose)" >&2
	fi
	# `mas install` only re-downloads apps that are already in the signed-in
	# Apple Account's purchase history: it sends the store a redownload
	# request (pricingParameters=STDRDL, isRedownload), and for an app this
	# account has never gotten the store answers with no downloads and mas
	# exits non-zero ("No downloads began" in 1.x, "No downloads initiated"
	# in 7.x). `mas purchase` -- `mas get` since 5.x, with `purchase` kept as
	# an alias, so the old spelling works on every era -- sends a real
	# zero-price purchase instead (STDQ, macappinstalledconfirmed=1), which
	# adds the app to the account and then downloads it. Free apps only:
	# paid ones have to be bought in the App Store app (mas-cli/mas#558).
	# Depending on System Settings (Touch ID for purchases, or Free
	# Downloads: Always Require) the store may prompt for Apple Account
	# authentication per app, and mas 4.x+ needs root for both commands and
	# sudo's itself. Already-installed apps are a warning and exit 0, so they
	# never reach the fallback.
	#
	# Era caveat: mas 1.8.4 through 1.8.6 refuse `purchase` outright on
	# 10.15+ ("not supported on this macOS version"); 1.8.7 (2024-11)
	# re-enabled it. The Catalina, Big Sur and Monterey pins carry 1.8.6, so
	# there the fallback fails too and the app has to be gotten once by hand
	# in the App Store; after that `mas install` works. Mojave's 1.8.3 and
	# the 2025+ pins are fine.
	for mas_id in "${MAS_APP_IDS[@]}"; do
		if mas install "$mas_id"; then
			continue
		fi
		echo "note: mas install $mas_id failed; trying to get it as a free purchase with the signed-in Apple Account" >&2
		if ! mas purchase "$mas_id"; then
			echo "warning: could not get app $mas_id; if it is free, click Get on https://apps.apple.com/app/id$mas_id in the App Store and re-run this script" >&2
		fi
	done
fi

