{{ template "posix-preamble.sh" . }}
# run_after_, every apply: the policy document is written inline below and
# compared with the deployed copy before sudo is touched, so an apply with
# nothing to do costs one cmp. It used to be run_onchange_, keyed on the policy
# text, which never came back after Firefox's updater replaced the bundle (and
# the copy inside it), nor after an apply that could not write it (below).
#
# macOS has no system-wide policies.json path -- unlike Linux, which also reads
# /etc/firefox/policies, the only location Mozilla supports here is the copy
# inside the app bundle. It lives under the cask-installed Firefox.app from
# 040-macos-casks.
#
# Writing into an app bundle takes App Management (Ventura on), sudo or not,
# and macOS asks for it only with a prompt on the Mac's screen. A Terminal
# there has it once allowed (brew's cask upgrades want it too); an SSH session
# has nowhere to show the prompt and is refused ("Operation not permitted")
# unless Remote Login was given Full Disk Access. Over SSH that refusal is a
# warning, and the next apply from the Mac's own session deploys the policies.
POLICY_JSON="$(mktemp)"
trap 'rm -f "$POLICY_JSON"' EXIT
cat >"$POLICY_JSON" <<'FIREFOX_POLICIES_JSON'
{{ template "firefox-policies.json" . }}
FIREFOX_POLICIES_JSON

FIREFOX_APP="/Applications/Firefox.app"
DEST="$FIREFOX_APP/Contents/Resources/distribution/policies.json"

if [ ! -d "$FIREFOX_APP" ]; then
	echo "notice: $FIREFOX_APP not found, skipping policy deployment" >&2
elif cmp -s "$POLICY_JSON" "$DEST"; then
	# Answered before sudo is touched: on a machine that has been applied to
	# before this is already true, and the old ordering prompted for a password
	# just to discover there was nothing to do.
	echo "debug: firefox policies already up to date" >&2
elif can_sudo; then
	# `install -D` is a GNU extension that BSD install does not have, so the
	# directory is created separately rather than by the copy itself.
	#
	# chmod is not optional: mktemp creates at 0600 and cp takes its mode from
	# the source, which would leave a policies.json only root can read -- and
	# Firefox reads it as the browsing user.
	write_status=0
	write_output="$({
		sudo mkdir -p "$(dirname "$DEST")" &&
			sudo cp "$POLICY_JSON" "$DEST" &&
			sudo chmod 0644 "$DEST"
	} 2>&1)" || write_status=$?
	if [ "$write_status" -eq 0 ]; then
		echo "notice: deployed firefox policies to $DEST" >&2
	elif [ -n "${SSH_CONNECTION:-}" ] && [[ "$write_output" == *"Operation not permitted"* ]]; then
		echo "warning: macOS kept this SSH session out of $FIREFOX_APP (App Management); firefox policies not deployed. Apply from a Terminal on the Mac's screen, or allow full disk access for remote users under Remote Login in System Settings" >&2
	else
		printf '%s\n' "$write_output" >&2
		echo "error: could not write $DEST" >&2
		exit 1
	fi
else
	# Not an SSH limitation, so it stays an error.
	#
	# Worth knowing when this fires: can_sudo probes with `sudo -l &>/dev/null`,
	# which suppresses the password prompt along with everything else, so an
	# expired sudo timestamp looks like a silent skip rather than a prompt. Run
	# `sudo -v` before the apply to avoid it.
	echo "error: sudo required to write $DEST; re-run once sudo is available" >&2
	exit 1
fi
