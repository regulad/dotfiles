{{ template "posix-preamble.sh" . }}
# One-time macOS host prerequisites: third-party taps, Rosetta, Xcode CLT.
#
# This used to live in posix-preamble.sh, which every macOS hookscript includes
# and each of which is its own process -- so three `brew tap`s, a
# softwareupdate call and an xcode-select probe ran ~20 times per apply for
# work that only ever needs doing once per machine. run_onchange_ runs it on the
# first apply and again only when this file changes (e.g. a tap is added).
#
# Ordering: after 010-pam-sudo-touchid (which needs nothing from here) and
# before 020-brew-packages / 040-macos-casks, which install from these taps.

# kde-mac/kde is disabled until Homebrew fixes a 7.0 regression. Its
# tools/do-caveats.sh runs `brew services restart dbus`, and brew 7.0.x fails
# that with "Formula `dbus` has not implemented #plist, #service or provided a
# locatable service file": FormulaStruct.deserialize decides whether a formula
# has a service block from `service_args` alone, but serialize drops that key
# when empty, so a name-only `service do` block (dbus, netatalk, xinit) loads
# with service? == false and brew looks for sh.brew.dbus.plist instead of the
# org.freedesktop.dbus-session.plist the keg ships. Fix is a one-liner in
# Library/Homebrew/api/formula_struct.rb (also set service_present when
# service_run_args/service_name_args are present). Re-enable once
# `brew services info dbus --json` reports service_name
# org.freedesktop.dbus-session.
#brew tap kde-mac/kde https://invent.kde.org/packaging/homebrew-kde.git && "$(brew --repo kde-mac/kde)/tools/do-caveats.sh"
brew tap regulad/homebrew-tap
brew tap Gcenx/wine https://github.com/Gcenx/homebrew-wine

# software updates
if [ "$(arch)" = "arm64" ]; then
	# despite being an sbin, this is usable by non-root users. til
	/usr/sbin/softwareupdate --install-rosetta --agree-to-license
fi
xcode-select --install || true  # returns exit code 1 when tools are already installed
