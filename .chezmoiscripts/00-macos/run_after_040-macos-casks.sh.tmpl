{{ template "posix-preamble.sh" . }}
## addl. brew things packaged as casks
BREW_CASKS_MACOS=(
	"retroarch-metal@nightly"
	"airserver"  # proprietary paid
	"nx-studio"  # proprietary freeware
	"thetimemachinemechanic"
	"lulu"
	"ghostty"
	"prusaslicer"
	"wakatime"  # proprietary freeware
	"zoom"  # proprietary trialware
	"firefox"  # for extension dev; i hate firefox for regular browsing
	"xquartz"  # for X server forwarding
	"suspicious-package"  # proprietary freeware
	"adobe-digital-editions"  # proprietary freeware
	"handbrake-app"
	"grandperspective"
	"claude-code"  # proprietary freeware
	"jetbrains-toolbox"  # proprietary freeware
	"gimp"
	"signal"
	"tailscale-app"  # proprietary! ... kinda?
	"appcleaner"  # no idea
	"google-chrome"  # proprietary freeware (you can't make me use anything other than chrome)
	"nextcloud"  # the -vfs cask is deprecated; File Provider ships in the main pkg since 33.0
	"docker-desktop"  # proprietary trialware
	"obs"
	"utm"
	"bartender" # proprietary trialware # i have a license
	"stats"
	"claude"
	"element"
	"forklift"
	"prismlauncher"
	"spotify"
	"steam"
	"vagrant"
	"raspberry-pi-imager"
	"vlc"
	"calibre"
	"hex-fiend"
	"google-drive"  # proprietary trialware
	"visual-studio-code"  # partially proprietary
	"autodesk-fusion"  # proprietary trialware # i have a license
	"thunderbird@esr"
	"safe-exam-browser"  # partially proprietary
	"kde-connect"
	"android-platform-tools"
	"android-commandlinetools"
	"syncthing-app"
	"vesktop"
	"macfuse" # we finally have `-o backend=fskit`! no kext!
	"regulad/tap/epson-et8500" # super proprietary 😈
	"regulad/tap/cricut-design-space" # super proprietary 😈
	"Gcenx/wine/game-porting-toolkit"
)

if [ "$HAS_BREW" = "true" ]; then
	# Non-official taps in the list above must be trusted before brew will
	# load anything from them -- the replacement for the deprecated
	# HOMEBREW_NO_REQUIRE_TAP_TRUST=1 (see 00-linux/030-brew-extras.sh).
	# Trusting by tap name works before the tap is installed and is
	# idempotent, so it runs every apply.
	brew trust --tap regulad/tap
	brew trust --tap Gcenx/wine

	# Migration: nextcloud-vfs was deprecated 2026-04-01 (discontinued upstream).
	# Since desktop client 33.0 the classic and VFS (File Provider) clients are one
	# package, tracked by the plain `nextcloud` cask. The two casks conflict, so an
	# older host has to drop the -vfs one before the loop below can install its
	# replacement. Account config lives in ~/Library and survives the swap.
	if brew list --cask nextcloud-vfs &>/dev/null; then
		echo "debug: replacing deprecated nextcloud-vfs cask with nextcloud" >&2
		brew uninstall --cask -q nextcloud-vfs
	fi

	# Tailscale ships two macOS builds that cannot coexist: the App Store app
	# (id 1475387142, bundle io.tailscale.ipn.macos, network extension) and the
	# standalone .app the tailscale-app cask installs (system extension). A host
	# that already has the App Store build keeps it; only install the cask when
	# mas doesn't list it. mas comes from 020-brew-packages, so it is on PATH here.
	if mas list 2>/dev/null | grep -q '^1475387142 '; then
		echo "debug: tailscale present from the App Store; skipping the tailscale-app cask" >&2
		TAILSCALE_FROM_MAS=1
	else
		TAILSCALE_FROM_MAS=0
	fi

	for cask in "${BREW_CASKS_MACOS[@]}"; do
		if [ "$cask" = "tailscale-app" ] && [ "$TAILSCALE_FROM_MAS" -eq 1 ]; then
			continue
		fi
		if ! brew list --cask "$cask" &>/dev/null; then
			brew install --cask -q "$cask" -f
		fi
	done
fi
