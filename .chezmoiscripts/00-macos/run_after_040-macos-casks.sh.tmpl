{{ template "posix-preamble-brew.sh" . }}
{{- /* Era-pinned host (see .chezmoidata/brew-tiers.toml)? Entries below pick
       the name the same cask had at that checkout, or are left out because
       the cask did not exist there yet or declares a macOS floor / arch the
       host cannot meet, inline and keyed on the era name. $brewEra is "" on
       a Tier 1 host. */ -}}
{{- $brewEra := "" }}
{{- if eq .chezmoi.os "darwin" }}
{{-   $p := index .brewTiers.legacy (printf "%s-%s" .macos.series .chezmoi.arch) | default dict }}
{{-   if $p }}{{ $brewEra = $p.era }}{{ end }}
{{- end }}
{{- /* eras whose tap checkout predates the given year */ -}}
{{- $pre2022 := has $brewEra (list "mojave") }}
{{- $pre2023 := has $brewEra (list "mojave" "catalina") }}
{{- $pre2024 := has $brewEra (list "mojave" "catalina" "bigsur") }}
{{- $pre2025 := has $brewEra (list "mojave" "catalina" "bigsur" "monterey") }}
{{- $pre2026 := has $brewEra (list "mojave" "catalina" "bigsur" "monterey" "ventura") }}
{{- $preApp := $pre2025 }}
## addl. brew things packaged as casks
BREW_CASKS_MACOS=(
{{- if not $pre2024 }}
	"retroarch-metal@nightly"  # cask added 2024
{{- end }}
{{- if not $pre2026 }}
	"nx-studio"  # proprietary freeware; cask added 2024, and Nikon has since removed the archive URLs the Monterey and Ventura pins point at (URL audit 2026-09-28)
{{- end }}
	"thetimemachinemechanic"
{{- if not $pre2022 }}
	"lulu"  # the 2021 cask required Catalina
{{- end }}
{{- if not $pre2025 }}
	"ghostty"  # needs Ventura
{{- end }}
	"prusaslicer"
{{- if not $pre2024 }}
	"wakatime"  # proprietary freeware; cask added 2024
{{- end }}
	"zoom"  # proprietary trialware
	"firefox"  # for extension dev; i hate firefox for regular browsing
	"xquartz"  # for X server forwarding
{{- if not $pre2026 }}
	"suspicious-package"  # proprietary freeware # needs macOS 14.0; the cask is improperly missing a depends_on macos line, so this gate stands in for it
{{- end }}
	"adobe-digital-editions"  # proprietary freeware
{{- if $preApp }}
	"handbrake"  # the -app renames of handbrake/docker/tailscale/syncthing landed in 2025
{{- else }}
	"handbrake-app"
{{- end }}
	"grandperspective"
{{- if not $pre2025 }}
	"claude-code"  # proprietary freeware; cask added 2025
{{- end }}
{{- if not $pre2026 }}
	"codex"  # cask added 2026
	"chatgpt"  # proprietary freeware; the cask required Sonoma + Apple Silicon until 2026
{{- end }}
	"jetbrains-toolbox"  # proprietary freeware
	"gimp"
	"signal"
{{- if $pre2022 }}
{{- /* no tailscale cask yet in 2021 */ -}}
{{- else if $preApp }}
	"tailscale"  # proprietary! ... kinda?
{{- else }}
	"tailscale-app"  # proprietary! ... kinda?
{{- end }}
	"appcleaner"  # no idea
{{- if not $pre2025 }}
	"google-chrome"  # proprietary freeware (you can't make me use anything other than chrome) # needs macOS 13.0; the cask is improperly missing a depends_on macos line, so this gate stands in for it
{{- end }}
	"nextcloud"  # the -vfs cask is deprecated; File Provider ships in the main pkg since 33.0
	"obs"
	"utm"
{{- if not $pre2026 }}
	"bartender" # proprietary trialware # i have a license # every pin before 2026 points at macbartender.com/B2/updates, which is gone (404); only the 2026 pins have the live downloads.macbartender.com URL (URL audit 2026-09-28)
{{- end }}
	"stats"
{{- if not $pre2025 }}
	"claude"  # cask added 2025
{{- end }}
{{- if not $pre2025 }}
	"element"  # needs macOS 13.0; the pinned casks lack a depends_on macos line, so this gate stands in for it
{{- end }}
{{- if not (has $brewEra (list "bigsur" "ventura")) }}
	"forklift"  # the 2025 cask requires Sonoma; the 2024 one did not, and the current one runs on Sonoma+. The 2023 pin checksums an unversioned ForkLift4.zip that the vendor has since replaced (sha256 mismatch, checksum audit 2026-09-28)
{{- end }}
{{- if and (not $pre2023) (ne $brewEra "bigsur") }}
	"prismlauncher"  # cask added late 2022. The 7.2 release asset the 2023 pin checksums was re-uploaded upstream (sha256 mismatch, checksum audit 2026-09-28)
{{- end }}
{{- if not $pre2025 }}
	"spotify"  # needs macOS 13.0; the pinned casks lack a depends_on macos line, so this gate stands in for it
{{- end }}
	"steam"
	"vagrant"
	"raspberry-pi-imager"
	"vlc"
{{- if ne $brewEra "bigsur" }}
	"calibre"  # the 6.27.0 dmg the 2023 pin checksums was re-uploaded upstream (sha256 mismatch, checksum audit 2026-09-28)
{{- end }}
	"hex-fiend"
	"google-drive"  # proprietary trialware
	"visual-studio-code"  # partially proprietary
{{- if not $pre2024 }}
	"autodesk-fusion"  # proprietary trialware # i have a license # cask added 2024
{{- end }}
{{- if not $pre2025 }}
	"thunderbird@esr"  # cask added 2025 (never in cask-versions either)
{{- end }}
{{- if not $pre2026 }}
	"safe-exam-browser"  # partially proprietary # the GitHub release assets for the 3.x versions every pre-2026 pin references have been deleted (URL audit 2026-09-28)
{{- end }}
{{- if eq $brewEra "sonoma" }}
	"kde-connect"  # arm64-only upstream and needs Ventura; cask added 2026
{{- else if eq $brewEra "" }}
	"kde-connect"
{{- end }}
	"android-platform-tools"
	"android-commandlinetools"
{{- if $preApp }}
	"syncthing"
{{- else }}
	"syncthing-app"
{{- end }}
{{- if not $pre2025 }}
	"vesktop"  # cask added 2025
{{- end }}
	"macfuse" # we finally have `-o backend=fskit`! no kext!
{{- if not $pre2022 }}
	"regulad/tap/epson-et8500" # super proprietary 😈 # Epson lists the package for 10.7 through 27; only the Mojave era's brew 3.2.17 cannot parse its requires_rosetta caveat
{{- end }}
{{- if not $pre2024 }}
	"regulad/tap/cricut-design-space" # super proprietary 😈 # Cricut's own requirement is macOS 12 or later; the cask declares no floor
{{- end }}
{{- if or (eq $brewEra "") (has $brewEra (list "current" "sonoma")) }}
	"Gcenx/wine/game-porting-toolkit"  # the cask requires Sonoma
{{- end }}
)

if [ "$HAS_BREW" = "true" ]; then
	# Non-official taps in the list above must be trusted before brew will
	# load anything from them -- the replacement for the deprecated
	# HOMEBREW_NO_REQUIRE_TAP_TRUST=1 (see 00-linux/030-brew-extras.sh).
	# Trusting by tap name works before the tap is installed and is
	# idempotent, so it runs every apply. brew_trust (preamble) is a no-op on
	# an era-pinned brew old enough to have no `trust` subcommand.
	brew_trust --tap regulad/tap
	brew_trust --tap Gcenx/wine

	# Migration: nextcloud-vfs was deprecated 2026-04-01 (discontinued upstream).
	# Since desktop client 33.0 the classic and VFS (File Provider) clients are one
	# package, tracked by the plain `nextcloud` cask. The two casks conflict, so an
	# older host has to drop the -vfs one before the loop below can install its
	# replacement. Account config lives in ~/Library and survives the swap.
	if brew list --cask nextcloud-vfs &>/dev/null; then
		echo "debug: replacing deprecated nextcloud-vfs cask with nextcloud" >&2
		brew uninstall --cask -q nextcloud-vfs
	fi

	# Tailscale ships two macOS builds that cannot coexist: the App Store app
	# (id 1475387142, bundle io.tailscale.ipn.macos, network extension) and the
	# standalone pkg (bundle io.tailscale.ipn.macsys, system extension) -- the
	# same pkg the tailscale-app cask installs, and the one that drops the CLI at
	# /usr/local/bin/tailscale. Either may already be on a host without brew
	# knowing: the App Store one never is, and the standalone one isn't when it
	# was installed by hand. Skip the cask in both cases rather than letting
	# `brew install --cask -f` re-run the pkg installer (and prompt for sudo)
	# over a working install. mas comes from 020-brew-packages, so it is on PATH.
	if mas list 2>/dev/null | grep -q '^1475387142 '; then
		echo "debug: tailscale present from the App Store; skipping the tailscale-app cask" >&2
		TAILSCALE_PRESENT=1
	elif pkgutil --pkg-info com.tailscale.ipn.macsys &>/dev/null; then
		echo "debug: standalone tailscale pkg already installed; skipping the tailscale-app cask" >&2
		TAILSCALE_PRESENT=1
	else
		TAILSCALE_PRESENT=0
	fi

	# tailscale-app is `tailscale` on the pre-2025 eras, hence the two spellings.
	for cask in "${BREW_CASKS_MACOS[@]}"; do
		case "$cask" in
			tailscale-app | tailscale)
				[ "$TAILSCALE_PRESENT" -eq 1 ] && continue
				;;
		esac
		if ! brew list --cask "$cask" &>/dev/null; then
			brew install --cask -q "$cask" -f
		fi
	done
fi
