# system-level binary dependencies for Debian/Ubuntu hosts (apt).
# these are typically very stable applications that MUST be provided by a
# package manager; they are not particularly version-sensitive and are all f(l)oss.
APT_PACKAGES=(
	# =+= CORE
	build-essential
	bash
	tmux
	fastfetch
	telnet
	retry
	zsh
	xxd
	binwalk
	ncdu
	htop
	nmap
	curl
	age

	# =+= CONTAINERIZATION
	podman
	podman-compose

	# =+= BUILD TOOLS
	ninja-build
	pkgconf
	cmake

	# =+= DEPENDENCIES
	libcairo2-dev  # needed by cairo PyPi package
	libxml2-dev
	libfreetype-dev
	libjpeg-dev  # libjpeg62-turbo-dev provides this
	libdevmapper-dev  # needed by thin-provisioning-tools build
	pciutils  # needed by llama.cpp
	libcurl4-openssl-dev
	## libolm is depreciated upstream but still needed to build the mautrix tools
	libolm-dev
	libsimdjson-dev

	# =+= MISC
	thin-provisioning-tools  # not natively available redhat
	nyx
	vainfo
	mesa-utils

	# =+= EDITOR
	neovim
	vim
	shellcheck
	tree-sitter-cli
	ripgrep
	imagemagick

	# =+= DESKTOP
	mpv

	# =+= SERIAL
	minicom

	# =+= UTILS
	systemd  # provides utils even when in docker
	# Replaces the old 10-autowatch.zsh chpwd hook, which sourced and eval'd a
	# .watchrc out of whatever directory you cd'd into. direnv does the same job
	# behind an explicit per-directory `direnv allow`, so cloning a repo that
	# ships an .envrc no longer runs its contents. Hooked up in
	# dot_config/zsh/10-direnv.zsh.
	direnv
	socat
	inetutils-telnet
	# iputils-ping, NOT inetutils-ping. Both provide the `ping` virtual package
	# and inetutils-ping declares Conflicts:/Replaces: against iputils-ping, so
	# asking for it makes apt *remove* the iputils-ping that ships in the base
	# system (it's Priority: important and present on every Ubuntu install) and
	# swap in a different implementation behind the same name. This also puts
	# the list back in parity with the Fedora side, which pulls `iputils`.
	iputils-ping
	inetutils-ftp
	binutils
	net-tools
	# dig. `dnsutils` is only a transitional shim on resolute and pulls this in
	# anyway, so depend on the real package. Note this ships dig and nslookup
	# but NOT host, which Debian splits into bind9-host -- unlike the Fedora
	# side, where bind-utils carries all three.
	bind9-dnsutils
	perl
	sshpass
	git
	git-lfs
	git-filter-repo
	gnupg # gpg
	openssh-client
	keychain
	gh # GitHub
	restic
	ffmpeg
	syncthing
	libnss3-tools  # pk12util/certutil, needed to import the client cert into the NSS DB

	# =+= JS/TS
	nodejs
	npm # just to install pnpm

	# =+= JVM
	default-jdk
	maven

	# =+= RUST
	rustup

	# =+= PYTHON (>= 3.12)
	python3
	python3-pip
	python3-venv

	# =+= GO
	golang

	# =+= RUBY
	ruby

	# =+= LUA
	lua5.5
	luarocks
)

require_sudo "apt package installation"

sudo apt update -qq
sudo apt install -qq -y "${APT_PACKAGES[@]}"
sudo apt upgrade -qq -y

# Setup Rust toolchain if needed
if command -v rustup-init &>/dev/null && [[ ! -d "$HOME/.cargo" ]]; then
	rustup-init -y --default-toolchain stable --profile default
	source "$HOME/.cargo/env"
	rustup component add rust-analyzer
elif command -v rustup &>/dev/null && rustup toolchain list 2>&1 | grep -qE "(no installed toolchains|^$)"; then
	rustup default stable
	rustup set profile default
	rustup toolchain install stable
	rustup component add rust-analyzer
fi
