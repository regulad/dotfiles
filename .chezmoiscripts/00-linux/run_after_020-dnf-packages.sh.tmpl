{{ template "posix-preamble.sh" . }}
# system-level binary dependencies for Fedora/RHEL-family hosts (dnf).
# these are typically very stable applications that MUST be provided by a
# package manager; they are not particularly version-sensitive and are all f(l)oss.
DNF_PACKAGES=(
	# =+= CORE
	bash
	nu
	tmux
	fastfetch
	telnet
	retry
	zsh
	xxd
	binwalk
	ncdu
	htop
	nmap
	curl
	age

	# =+= CONTAINERIZATION
	podman
	podman-compose

	# =+= BUILD TOOLS
	ninja-build
	pkgconf
	cmake

	# =+= DEPENDENCIES
	cairo-devel  # needed by cairo PyPi package
	libxml2-devel
	freetype-devel
	libjpeg-turbo-devel
	device-mapper-devel  # needed by thin-provisioning-tools build
	pciutils  # needed by llama.cpp
	libcurl-devel
	## libolm is depreciated upstream but still needed to build the mautrix tools
	libolm-devel
	simdjson-devel

	# =+= MISC
	nyx
	libva-utils  # vainfo; VA-API works on a bare DRM render node, display or not
{{- if not .useHeadless }}
	glx-utils  # glxinfo, glxgears: X11 programs
{{- end }}

	# =+= EDITOR
	clang-tools-extra  # clangd for Vim/Neovim C/C++ LSP
	neovim
	vim
	tree-sitter-cli
	ShellCheck
	ripgrep
	ImageMagick

	# =+= DESKTOP
	# mpv and vlc are deliberately absent here: on the Fedora family GUI media
	# apps are provided by flatpak (io.mpv.Mpv, org.videolan.VLC), installed by
	# 01-fedora/020-flatpak-packages.sh, keeping exactly one install mechanism
	# per app per platform.
{{- if not .useHeadless }}
	# The desktop portal's GTK backend, with xdg-desktop-portal itself: the
	# Settings portal apps read light/dark from. It used to be here only as
	# something else's weak dependency. WSL's runs as 00-linux/151 sets it up.
	xdg-desktop-portal-gtk
{{- end }}

	# =+= SERIAL
	minicom

	# =+= UTILS
	systemd  # provides utils even when in docker
	gawk  # not bundled by default
	direnv  # see the note on the apt side; replaces the old .watchrc hook
	jq
	socat
	iputils
	binutils
	net-tools
	bind-utils  # dig, host, nslookup -- apt splits these, see the note there
	perl
	sshpass
	git
	git-lfs
	git-filter-repo
	gnupg2 # gpg
	openssh # ssh-agent & ssh
	# keychain: off WSL only, appended below
	gh # GitHub
	restic
	# NOTE: ffmpeg is deliberately absent from this list -- it needs
	# --allowerasing, which must not be applied to the whole list. It's
	# installed on its own after the main transaction below.
	syncthing
	nss-tools  # pk12util/certutil, needed to import the client cert into the NSS DB

	# =+= JS/TS
	nodejs
	npm # just to install pnpm

	# =+= JVM
	java-latest-openjdk
	maven

	# =+= RUST
	cargo
	rustfmt
	rust
	rust-analyzer

	# =+= PYTHON (>= 3.12)
	python3
	python3-pip

	# =+= GO
	golang

	# =+= RUBY
	ruby

	# =+= LUA
	lua
	luarocks
)

require_sudo "dnf package installation"

# keychain is the fallback SSH agent for hosts that have none (.commonprofile
# only reaches for it when no agent socket exists). Not on WSL, where
# ssh-agent-relay.service relays the Windows agent in. Fedora's keychain
# package also ships /etc/profile.d/keychain.sh, which runs
# `keychain --immediate` over every key in ~/.ssh in every login shell; after
# a `wsl --shutdown` that sat on an invisible passphrase prompt until ^C.
#
# Only installing is decided here. The images are built in Docker, where WSL
# cannot be told apart, so they carry keychain; .github/workflows/wsl-package.yml
# removes it from the WSL tarball in a chroot, and leaving it out on WSL is
# what keeps the first apply inside the instance from putting it back.
if [ "$IS_WSL" -ne 1 ]; then
	DNF_PACKAGES+=(keychain)
fi

# Since WSL 3.0.2 (a pre-release; 3.0.3 is the first stable one), WSL
# bind-mounts a perf built for its own kernel read-only over /usr/bin/perf,
# from its system disk (/dev/sdb[/<kernel>/perf/bin/perf]). It came with
#   https://github.com/microsoft/WSL/pull/41400
# ("Expose kernel headers and perf to distributions"), which 3.0.1 does not
# contain. rpm can never replace that path -- the rename onto the mount fails
# with "cpio: rename failed - No data available" -- so every update to
# Fedora's perf (from the image's c-development group; nothing here asks for
# it) failed the `dnf upgrade` below, and the apply with it. While the mount
# is there, dnf leaves perf alone, for every dnf command rather than just this
# script's, by way of a libdnf5 drop-in; WSL's perf is the one matching the
# running kernel anyway. The fix upstream, open as of 2026-10-14, moves it to
# a WSL-owned path instead:
#   https://github.com/microsoft/WSL/pull/41904
# Once WSL stops mounting it, the drop-in goes and Fedora's perf is upgraded
# as before.
#
# The WSL version comes from wslinfo: --version since 3.0.x, --wsl-version (now
# a legacy alias) since 2.2.3. Anything that is not a version -- an older
# wslinfo's "Invalid command line argument" -- counts as older than 3.0.2.
WSL_PERF_DROPIN=/etc/dnf/libdnf5.conf.d/90-wsl-perf.conf
wsl_version=""
if [ "$IS_WSL" -eq 1 ]; then
	for flag in --version --wsl-version; do
		wsl_version="$(wslinfo "$flag" 2>/dev/null)" || wsl_version=""
		case "$wsl_version" in
		'' | *[!0-9.]*) wsl_version="" ;;
		*) break ;;
		esac
	done
fi
wsl_version_at_least() { # $1: minimum, e.g. 3.0.2.0
	[ -n "$wsl_version" ] &&
		[ "$(printf '%s\n%s\n' "$1" "$wsl_version" | sort -V | head -n1)" = "$1" ]
}
if [ "$IS_WSL" -eq 1 ] && wsl_version_at_least 3.0.2.0 && mountpoint -q /usr/bin/perf; then
	wsl_perf_conf="$(printf '%s\n' \
		'# Written by chezmoi (00-linux/020-dnf-packages): WSL mounts its own perf' \
		'# read-only over /usr/bin/perf, which rpm can never replace.' \
		'[main]' \
		'excludepkgs=perf')"
	if [ "$(cat "$WSL_PERF_DROPIN" 2>/dev/null)" = "$wsl_perf_conf" ]; then
		echo "debug: dnf already excludes perf, which WSL mounts over /usr/bin/perf" >&2
	else
		printf '%s\n' "$wsl_perf_conf" | sudo tee "$WSL_PERF_DROPIN" >/dev/null
		echo "notice: WSL mounts its own perf over /usr/bin/perf, so dnf now excludes the perf package ($WSL_PERF_DROPIN)" >&2
	fi
elif [ -f "$WSL_PERF_DROPIN" ]; then
	sudo rm -f "$WSL_PERF_DROPIN"
	echo "notice: removed $WSL_PERF_DROPIN (WSL ${wsl_version:-version unknown}, not 3.0.2+ with perf mounted over /usr/bin/perf); dnf upgrades the perf package again" >&2
fi

sudo dnf group install -q -y "development-tools"
sudo dnf install -q -y "${DNF_PACKAGES[@]}"

# RPM Fusion's ffmpeg is a *replacement* for Fedora's ffmpeg-free, not an
# addition: it declares `Conflicts: ffmpeg-free`, and its ffmpeg-libs likewise
# conflicts with each of the split libav*-free / libsw*-free packages. That is
# by design and will never "resolve upstream" -- the TODO this replaced was
# waiting on an RPM Fusion rebuild that is never coming, because the packages
# are mutually exclusive on purpose. Erasing the free build in the same
# transaction is the documented fix.
#
# Kept out of DNF_PACKAGES so --allowerasing applies to this one package only
# and can't silently erase something else to satisfy the main transaction.
# Verified on Fedora 44: ffmpeg-libs provides the same sonames the libav*-free
# split packages did, so their consumers keep working, and the libx264 /
# libx265 / libfdk_aac encoders that ffmpeg-free lacks become available --
# which is the whole point of `brew unlink ffmpeg` in 050-linux-casks
# preferring the system build "with codecs".
sudo dnf install -q -y --allowerasing ffmpeg

sudo dnf upgrade --refresh -y
