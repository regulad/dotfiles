# system-level binary dependencies for Fedora/RHEL-family hosts (dnf).
# these are typically very stable applications that MUST be provided by a
# package manager; they are not particularly version-sensitive and are all f(l)oss.
DNF_PACKAGES=(
	# =+= CORE
	bash
	nu
	tmux
	fastfetch
	telnet
	retry
	zsh
	xxd
	binwalk
	ncdu
	htop
	nmap
	curl
	age

	# =+= CONTAINERIZATION
	podman
	podman-compose

	# =+= BUILD TOOLS
	ninja-build
	pkgconf
	cmake

	# =+= DEPENDENCIES
	cairo-devel  # needed by cairo PyPi package
	libxml2-devel
	freetype-devel
	libjpeg-turbo-devel
	device-mapper-devel  # needed by thin-provisioning-tools build
	pciutils  # needed by llama.cpp
	libcurl-devel
	## libolm is depreciated upstream but still needed to build the mautrix tools
	libolm-devel
	simdjson-devel

	# =+= MISC
	nyx
	libva-utils
	glx-utils

	# =+= EDITOR
	clang-tools-extra  # clangd for Vim/Neovim C/C++ LSP
	neovim
	vim
	tree-sitter-cli
	ShellCheck
	ripgrep
	ImageMagick

	# =+= DESKTOP
	# mpv and vlc are deliberately absent here: on the Fedora family GUI media
	# apps are provided by flatpak (io.mpv.Mpv, org.videolan.VLC), installed by
	# 01-fedora/020-flatpak-packages.sh, keeping exactly one install mechanism
	# per app per platform.

	# =+= SERIAL
	minicom

	# =+= UTILS
	systemd  # provides utils even when in docker
	gawk  # not bundled by default
	direnv  # see the note on the apt side; replaces the old .watchrc hook
	socat
	iputils
	binutils
	net-tools
	bind-utils  # dig, host, nslookup -- apt splits these, see the note there
	perl
	sshpass
	git
	git-lfs
	git-filter-repo
	gnupg2 # gpg
	openssh # ssh-agent & ssh
	# keychain: off WSL only, appended below
	gh # GitHub
	restic
	# NOTE: ffmpeg is deliberately absent from this list -- it needs
	# --allowerasing, which must not be applied to the whole list. It's
	# installed on its own after the main transaction below.
	syncthing
	nss-tools  # pk12util/certutil, needed to import the client cert into the NSS DB

	# =+= JS/TS
	nodejs
	npm # just to install pnpm

	# =+= JVM
	java-latest-openjdk
	maven

	# =+= RUST
	cargo
	rustfmt
	rust
	rust-analyzer

	# =+= PYTHON (>= 3.12)
	python3
	python3-pip

	# =+= GO
	golang

	# =+= RUBY
	ruby

	# =+= LUA
	lua
	luarocks
)

require_sudo "dnf package installation"

# keychain is the fallback SSH agent for hosts that have none (.commonprofile
# only reaches for it when no agent socket exists). Not on WSL, where
# ssh-agent-relay.service relays the Windows agent in. Fedora's keychain
# package also ships /etc/profile.d/keychain.sh, which runs
# `keychain --immediate` over every key in ~/.ssh in every login shell; after
# a `wsl --shutdown` that sat on an invisible passphrase prompt until ^C.
#
# Only installing is decided here. The images are built in Docker, where WSL
# cannot be told apart, so they carry keychain; .github/workflows/wsl-package.yml
# removes it from the WSL tarball in a chroot, and leaving it out on WSL is
# what keeps the first apply inside the instance from putting it back.
if [ "$IS_WSL" -ne 1 ]; then
	DNF_PACKAGES+=(keychain)
fi

sudo dnf group install -q -y "development-tools"
sudo dnf install -q -y "${DNF_PACKAGES[@]}"

# RPM Fusion's ffmpeg is a *replacement* for Fedora's ffmpeg-free, not an
# addition: it declares `Conflicts: ffmpeg-free`, and its ffmpeg-libs likewise
# conflicts with each of the split libav*-free / libsw*-free packages. That is
# by design and will never "resolve upstream" -- the TODO this replaced was
# waiting on an RPM Fusion rebuild that is never coming, because the packages
# are mutually exclusive on purpose. Erasing the free build in the same
# transaction is the documented fix.
#
# Kept out of DNF_PACKAGES so --allowerasing applies to this one package only
# and can't silently erase something else to satisfy the main transaction.
# Verified on Fedora 44: ffmpeg-libs provides the same sonames the libav*-free
# split packages did, so their consumers keep working, and the libx264 /
# libx265 / libfdk_aac encoders that ffmpeg-free lacks become available --
# which is the whole point of `brew unlink ffmpeg` in 050-linux-casks
# preferring the system build "with codecs".
sudo dnf install -q -y --allowerasing ffmpeg

sudo dnf upgrade --refresh -y
