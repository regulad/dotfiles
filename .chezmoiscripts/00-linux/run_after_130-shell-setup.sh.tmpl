{{ template "posix-preamble.sh" . }}
# oh my zsh
if ! [ -d ~/.oh-my-zsh ]; then
	# oh my zsh install process mutates the user's ~/.zshrc and there is no way to disable this behaviour
	touch ~/.zshrc
	mv ~/.zshrc ~/.zshrc.pre-oh-my-zsh
	sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended >/dev/null
	rm ~/.zshrc
	mv ~/.zshrc.pre-oh-my-zsh ~/.zshrc
else
	~/.oh-my-zsh/tools/upgrade.sh
fi

if [ -d ~/.oh-my-zsh/custom/plugins/zsh-autosuggestions ]; then
	git -C ~/.oh-my-zsh/custom/plugins/zsh-autosuggestions pull
else
	git clone https://github.com/zsh-users/zsh-autosuggestions ~/.oh-my-zsh/custom/plugins/zsh-autosuggestions
fi

# these commands only run on non-cattle hosts (persistent)
# load zsh as primary shell
ZSH_PATH=$(command -v zsh)

if command -v chsh &>/dev/null; then
	# Check if detected zsh is in /etc/shells
	if [ -n "$ZSH_PATH" ] && ! grep -q "^$ZSH_PATH$" /etc/shells; then
		echo "warning: $ZSH_PATH not in /etc/shells, using zsh in /etc/shells if exists" >&2
		ZSH_PATH=$(grep -m1 '/zsh$' /etc/shells)
	fi

	# If no zsh in /etc/shells, fall back to bash
	if [ -z "$ZSH_PATH" ]; then
		echo "warning: falling back to bash since zsh isn't available in /etc/shells" >&2

		BASH_PATH=$(command -v bash)

		if [ -n "$BASH_PATH" ] && ! grep -q "^$BASH_PATH$" /etc/shells; then
			echo "warning: $BASH_PATH not in /etc/shells, using bash in /etc/shells if exists" >&2
			BASH_PATH=$(grep -m1 '/bash$' /etc/shells)
		fi

		if [ -z "$BASH_PATH" ]; then
			echo "error: no valid shell found in /etc/shells" >&2
			exit 1
		fi

		SHELL_PATH="$BASH_PATH"
	else
		SHELL_PATH="$ZSH_PATH"
	fi

	# Change shell if not already set
	if [ "$SHELL" != "$SHELL_PATH" ]; then
		if [ "$CAN_SUDO" = "true" ]; then
			# The username is NOT optional under sudo. util-linux chsh resolves
			# its target with `const uid_t uid = getuid();` and only falls back
			# to that uid when no username was given -- and under sudo the real
			# uid is 0, so a bare `sudo chsh -s ...` silently rewrites *root's*
			# shell and leaves this account on whatever it already had. That
			# failed quietly: the account stayed on bash, kept reading
			# ~/.profile instead of ~/.zprofile at login, and the shell never
			# actually changed no matter how many times an apply ran.
			# id -un rather than $USER: $USER is set by login shells and can be
			# absent when an apply is driven from a non-login context.
			sudo chsh -s "$SHELL_PATH" "$(id -un)"
		else
			chsh -s "$SHELL_PATH"
		fi
		echo "note: shell was changed" >&2
	fi
else
	echo "error: chsh not found, could not autoset shell" >&2
	exit 1
fi
