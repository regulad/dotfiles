{{ template "posix-preamble.sh" . }}
## cask library on linux is SUBSTANTIALLY different than the cask library on macos
BREW_CASKS_LINUX=(
	"claude-code" # proprietary!
{{- if eq .chezmoi.arch "amd64" }}
	# the linux cask ships Google's Intel-only SDK platform-tools build and
	# refuses to install on aarch64
	"android-platform-tools"
{{- end }}
	"android-commandlinetools"
)

if [ "$HAS_BREW" = "true" ]; then
	for cask in "${BREW_CASKS_LINUX[@]}"; do
		if ! brew list --cask "$cask" &>/dev/null; then
			brew install --cask -q "$cask" -f
		fi
	done

	# final work for brew on linux: unlink ffmpeg so it uses the system version with codecs
	#
	# Atomic hosts are the exception. There the "system version with codecs"
	# doesn't exist: the image ships Fedora's codec-stripped ffmpeg-free, and
	# the RPM Fusion swap that 020-dnf-packages.sh does with --allowerasing
	# can't be replayed against a read-only /usr without rebuilding the image.
	# So 022-brew-packages.sh installs brew's ffmpeg *as* the one with codecs,
	# and unlinking it here would leave no usable ffmpeg on the box at all.
	if [ "$IS_ATOMIC" -eq 0 ]; then
		brew unlink ffmpeg
	fi
fi
