{{ template "posix-preamble.sh" . }}
# install user services
if ! [ "$CONTAINERIZED" -eq 1 ]; then
	if systemctl --user is-system-running &>/dev/null || systemctl --user status &>/dev/null; then
		systemctl --user enable --now tmux@default.socket
		systemctl --user enable --now podman.socket
		# gpg-agent.service ships static (Requires=gpg-agent.socket,
		# `--supervised` in its ExecStart), so systemd -- not gpg's own
		# opportunistic autospawn-on-first-use -- owns its lifecycle from
		# login onward once the socket is enabled. `enable` alone would just
		# persist it for the next login; `--now` also creates the listening
		# socket in this session immediately rather than waiting for the
		# first gpg/ssh invocation to trigger gpg's own autospawn.
		#
		# Not on WSL, where gpg uses the Windows agent through
		# gpg-agent-relay.service on the same socket, and
		# 008-wsl-agent-relays has masked these.
		if [ "$IS_WSL" -eq 0 ]; then
			systemctl --user enable --now gpg-agent.socket
		fi
		# Attaches the wslpersist volume again at each start of the WSL VM
		# (docs/wsl.md#wslpersist). During an apply it is already mounted,
		# which 000-wslpersist made sure of, so --now only marks it started.
		if [ "$IS_WSL" -eq 1 ]; then
			systemctl --user daemon-reload
			systemctl --user enable --now wslpersist.service
		fi
		# NOTE: tailscale-ephemeral.service is deliberately NOT enabled here.
		# It is shipped inside WSL as an option, not as a default: joining a
		# tailnet is a side effect nobody should get merely from running an
		# apply. Bring it up by hand when you want it:
		#   systemctl --user enable --now tailscale-ephemeral.service
		# syncthing, on native GNU/Linux and in WSL alike. A WSL instance is a
		# node of its own, with its own ~/.claude beside the Windows host's,
		# and runs it while the instance is up. Under WSL's NAT it reaches
		# the hub through the host, so the hub's joining service sees the
		# host's tailnet address and admits it by the same owner rule
		# (docs/syncthing.md).
		#
		# Where syncthing came from decides how it gets started. The distro
		# packages ship a systemd user unit; the brew formula does not, so
		# on hosts where 022-brew-packages.sh is what provided it there is
		# no syncthing.service to enable and this would just fail.
		#
		# This isn't a systemd-vs-not split: `brew services` on Linux
		# generates its own ~/.config/systemd/user/homebrew.syncthing.service
		# and drives systemctl --user, so either branch lands on a systemd
		# user service. It just has to be the one that owns the unit.
		#
		# Safe to re-run: Services::Cli.start skips an already-running
		# service with a message and returns 0 rather than erroring, so this
		# won't trip the -e in the preamble on a repeat apply.
		if [ "$HAS_BREW" = "true" ] && brew list --formula syncthing &>/dev/null; then
			brew services start syncthing
		else
			systemctl --user enable --now syncthing.service
		fi
	else
		echo "error: user session broken (couldn't run systemd --user)" >&2
		exit 1
	fi
fi

echo "warning: exiting hookscript. don't buy it if something after this point asks for sudo!" >&2
