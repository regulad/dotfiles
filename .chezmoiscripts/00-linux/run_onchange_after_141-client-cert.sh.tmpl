{{ template "posix-preamble.sh" . }}
{{- if .useDummySecrets }}
echo "debug: useDummySecrets is set, skipping client certificate import" >&2
{{- else }}
if ! command -v pk12util &>/dev/null; then
    echo "error: pk12util not available, can't import client certificate" >&2
    exit 1
fi
{{ template "private-import-temp.sh" . }}
{{ template "decrypt-import.sh" (dict "root" . "name" "client.p12.age") }}
mkdir -p "$HOME/.pki/nssdb"
if [ ! -f "$HOME/.pki/nssdb/cert9.db" ]; then
    certutil -N -d "sql:$HOME/.pki/nssdb" --empty-password
fi
pk12util -d "sql:$HOME/.pki/nssdb" -i "$private_import_dir/client.p12" -W ""
{{- end }}
