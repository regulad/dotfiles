{{ template "posix-preamble.sh" . }}
# user-level binary dependencies
# these dependencies aren't provided by the system package manager, for whatever reason
# these packages do NOT require compilation and are distributed as binaries.
# they may be closed-source/non-libre (although I don't think any are).
# brew distributes these on GNU/Linux and Darwin. no attempt is made on other platforms
# most of them are needed for specific workflows (i.e. kotlin, python, java)
SECONDARY_BINARY_DEPENDENCIES=(
	"awscli"
	"go"  # needed for newer versions of toolchain
	"languagetool"
	"cloudflared"
	"wakatime-cli"
	"tokei"
	"minio-mc"
	"s3cmd"
	"wasm-tools"
	"kotlin"
	"kotlin-language-server"
	"fernflower"
	"jdtls"
	"emscripten"
	"harper"
	# NOTE: lima was dropped here and on macOS. Its 87 MB of binaries drag in an
	# exclusive 4.29 GB dependency subtree (llvm, qemu, mesa, gtk+3, z3, libclc,
	# spirv-*) -- 37% of the brew Cellar in the published container images, for a
	# VM manager inside a VM. The `quarantine` script that used limactl was
	# removed along with it.
	"deno"
	"shfmt"
	"ghidra"
	"poppler"
	"tesseract"
	"ocrmypdf"
	"rclone"
	"git-xet"
	"hf"
	"brew-gem"
	"bash-completion@2"
  "nushell"  # not available on ubuntu
)

if [ "$HAS_BREW" = "true" ]; then
	# use brew-managed ruby
	export PATH="$(brew --prefix ruby)/bin:$PATH"
	export PATH="$HOMEBREW_PREFIX/lib/ruby/gems/4.0.0/bin:$PATH"

	brew install -q "${SECONDARY_BINARY_DEPENDENCIES[@]}"

	# rclone above pulls in libfuse as a Linux dependency, and brew links it
	# unless told otherwise. Its fusermount3 is not setuid -- brew never marks
	# anything setuid -- so it cannot mount for anyone but root, making it pure
	# dead weight on PATH at best and a confusing shadow of the real,
	# setuid-root /usr/bin/fusermount3 at worst. Keep it unlinked, every apply,
	# unconditionally: unlike ffmpeg in 050-linux-casks.sh there is no atomic-host
	# case where brew's copy is the one that should win.
	if brew list --formula libfuse &>/dev/null; then
		brew unlink libfuse
	fi

	# Same shape of problem as libfuse above, discovered via
	# veracrypt-hc-mount (02-bluefin): util-linux comes in transitively as a
	# dependency of several formulae (systemd, podman, git, ...) and brew
	# links its lsblk/losetup/blkid/etc. ahead of the system copies on PATH.
	# Brew's build isn't wired into this host's live udev/blkid database the
	# way the system one is -- `lsblk -no LABEL` on a device the kernel
	# clearly has a label for comes back empty through brew's binary and
	# correct through /usr/bin's. A script relying on PATH resolution for
	# these gets silently wrong data instead of a loud failure, which is a
	# worse outcome than libfuse's merely-inert shadow.
	if brew list --formula util-linux &>/dev/null; then
		brew unlink util-linux
	fi

	# Same shape of problem again, discovered while setting up gpg-agent:
	# gpgme (a podman dependency) pulls in gnupg transitively, and brew links
	# its gpg/gpg-agent/gpgconf ahead of the system copies on PATH. The two
	# builds aren't just cosmetically different -- this host had brew's gnupg
	# 2.5.x installed against the system's 2.4.9 scdaemon/pinentry, a version
	# pairing nobody tested. `gpg-connect-agent` silently autostarting brew's
	# gpg-agent instead of the system one is exactly the kind of wrong-binary
	# bug util-linux caused for lsblk, just with a bigger blast radius since
	# gpg-agent.conf's pinentry-program/scdaemon-program choices assume the
	# system agent is the one reading them.
	if brew list --formula gnupg &>/dev/null; then
		brew unlink gnupg
	fi

	# brew-gem global gems (like cargo/go/uv)
	brew gem install ruby-lsp
	# neovim: the ruby provider bridge gem (:checkhealth vim.provider).
	# The Windows counterpart for both gems is 00-nt/580-ruby-tooling.cmd.
	brew gem install neovim

	if ! [ "$CONTAINERIZED" -eq 1 ]; then
		echo "debug: installing brew services" >&2
		brew services start languagetool
	fi
else
	echo "error: no brew for misc. binary deps" >&2
	exit 1
fi
