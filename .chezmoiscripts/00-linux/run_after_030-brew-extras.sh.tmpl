{{ template "posix-preamble.sh" . }}
# user-level binary dependencies
# these dependencies aren't provided by the system package manager, for whatever reason
# these packages do NOT require compilation and are distributed as binaries.
# they may be closed-source/non-libre (although I don't think any are).
# brew distributes these on GNU/Linux and Darwin. no attempt is made on other platforms
# most of them are needed for specific workflows (i.e. kotlin, python, java)
SECONDARY_BINARY_DEPENDENCIES=(
	"awscli"
	"go"  # needed for newer versions of toolchain
	"languagetool"
	"cloudflared"
	"wakatime-cli"
	"tokei"
	# minio-mc dropped: formula deprecated 2026-07-17 (repo archived); see the
	# OMITTED block in 022-brew-packages. rclone/awscli/s3cmd cover S3.
	"s3cmd"
	"wasm-tools"
	"kotlin"
	"kotlin-language-server"
	"fernflower"
	"jdtls"
	"emscripten"
	"harper"
	# NOTE: lima was dropped here and on macOS. Its 87 MB of binaries drag in an
	# exclusive 4.29 GB dependency subtree (llvm, qemu, mesa, gtk+3, z3, libclc,
	# spirv-*) -- 37% of the brew Cellar in the published container images, for a
	# VM manager inside a VM. The `quarantine` script that used limactl was
	# removed along with it.
	"deno"
	"shfmt"
	"ghidra"
	"poppler"
	"tesseract"
	"ocrmypdf"
	"rclone"
	"git-xet"
	"hf"
	"brew-gem"
	"bash-completion@2"
  "nushell"  # not available on ubuntu
)

if [ "$HAS_BREW" = "true" ]; then
	# use brew-managed ruby
	export PATH="$(brew --prefix ruby)/bin:$PATH"
	export PATH="$HOMEBREW_PREFIX/lib/ruby/gems/4.0.0/bin:$PATH"

	brew install -q "${SECONDARY_BINARY_DEPENDENCIES[@]}"

	# rclone above pulls in libfuse as a Linux dependency, and brew links it
	# unless told otherwise. Its fusermount3 is not setuid -- brew never marks
	# anything setuid -- so it cannot mount for anyone but root, making it pure
	# dead weight on PATH at best and a confusing shadow of the real,
	# setuid-root /usr/bin/fusermount3 at worst. Keep it unlinked, every apply,
	# unconditionally: unlike ffmpeg in 050-linux-casks.sh there is no atomic-host
	# case where brew's copy is the one that should win.
	if brew list --formula libfuse &>/dev/null; then
		brew unlink libfuse
	fi

	# Same shape of problem as libfuse above, discovered via
	# veracrypt-hc-mount (02-bluefin): util-linux comes in transitively as a
	# dependency of several formulae (systemd, podman, git, ...) and brew
	# links its lsblk/losetup/blkid/etc. ahead of the system copies on PATH.
	# Brew's build isn't wired into this host's live udev/blkid database the
	# way the system one is -- `lsblk -no LABEL` on a device the kernel
	# clearly has a label for comes back empty through brew's binary and
	# correct through /usr/bin's. A script relying on PATH resolution for
	# these gets silently wrong data instead of a loud failure, which is a
	# worse outcome than libfuse's merely-inert shadow.
	if brew list --formula util-linux &>/dev/null; then
		brew unlink util-linux
	fi

	# Same shape of problem again, discovered while setting up gpg-agent:
	# gpgme (a podman dependency) pulls in gnupg transitively, and brew links
	# its gpg/gpg-agent/gpgconf ahead of the system copies on PATH. The two
	# builds aren't just cosmetically different -- this host had brew's gnupg
	# 2.5.x installed against the system's 2.4.9 scdaemon/pinentry, a version
	# pairing nobody tested. `gpg-connect-agent` silently autostarting brew's
	# gpg-agent instead of the system one is exactly the kind of wrong-binary
	# bug util-linux caused for lsblk, just with a bigger blast radius since
	# gpg-agent.conf's pinentry-program/scdaemon-program choices assume the
	# system agent is the one reading them.
	if brew list --formula gnupg &>/dev/null; then
		brew unlink gnupg
	fi

	# Same shape of problem, one level up the same dependency chain: on
	# atomic hosts 022-brew-packages.sh installs podman-compose, whose formula
	# depends on brew's podman, and brew links that ahead of the podman that
	# Bluefin ships in its image (/usr/bin/podman). The two are not the same
	# release line -- this host had brew's 6.x linked over the image's 5.8 --
	# and brew's build knows nothing about the image's containers.conf,
	# helper directories, or the podman.socket unit that 150-user-services
	# enables, which is the image's podman, not brew's. podman-compose only
	# ever calls `podman` off PATH, so it is perfectly happy with the system
	# copy once brew's is out of the way. Unconditional like libfuse: on dnf
	# and apt hosts podman comes from the system package manager too, so there
	# is no platform where brew's podman should be the one on PATH.
	if brew list --formula podman &>/dev/null; then
		brew unlink podman
	fi

	# The fusermount3 problem again, this time in the formula 022 installs
	# for telnet: inetutils links ping6 and traceroute unprefixed (its other
	# tools get a `g`), and both need a raw socket. The image's copies carry
	# CAP_NET_RAW; brew's cannot -- ping6 dies with "raw socket: Operation not
	# permitted" and traceroute prints a row of stars for every hop. Unlink
	# the whole keg; .commonprofile appends its bin to the *tail* of PATH so
	# telnet/ftp/rsh stay reachable while /usr/bin wins for anything it has.
	if brew list --formula inetutils &>/dev/null; then
		brew unlink inetutils
	fi

	# Desktop-plumbing formulae that ride in as dependencies (glib via nearly
	# everything, dbus via glib, p11-kit via gnutls/gnupg). Their libraries
	# are fine -- every brew binary finds them through an opt/<formula> rpath,
	# not the linked lib dir -- but their CLI tools are wired to brew's prefix
	# instead of the host's:
	#   gio        no gvfs modules, so `gio mount -l` sees nothing while the
	#              host's lists every udisks drive; `gio mount smb://` is a
	#              silent no-op
	#   dbus-*     dbus-launch/dbus-run-session read brew's session.conf and
	#              start a bus with none of the host's activatable services
	#   trust      p11-kit's `trust list` reads brew's ca-certificates bundle:
	#              153 anchors here against the host store's 395, and none of
	#              the private CAs 140-ca-certs installs
	# Unlinking also drops their pkg-config files from the prefix; a from-
	# source build that wants brew's glib can point PKG_CONFIG_PATH at
	# `brew --prefix glib`/lib/pkgconfig explicitly.
	for _shadow in glib dbus p11-kit; do
		if brew list --formula "$_shadow" &>/dev/null; then
			brew unlink "$_shadow"
		fi
	done
	unset _shadow

	# git is the one where the answer depends on the host. On Bluefin the
	# image's /usr/bin/git is the wanted one: it reads /etc/gitconfig, where
	# the image registers the git-lfs filters, and it can see the libsecret
	# credential helper in /usr/libexec/git-core. brew's git reads
	# $HOMEBREW_PREFIX/etc/gitconfig instead and has neither -- and it only
	# ever arrives transitively, via git-filter-repo, so nothing in this repo
	# asked for it. Everywhere else brew's newer git is wanted on PATH, so
	# ask for it by name rather than leaving that to a dependency edge that
	# could vanish in a formula update. (git-filter-repo is a script that git
	# finds on PATH, so it works under either git.)
	if [ "$OS" = "bluefin" ]; then
		if brew list --formula git &>/dev/null; then
			brew unlink git
		fi
	else
		brew install -q git
	fi

	# chafa was pulled in alongside fastfetch for runtime PNG-to-text logo
	# conversion in the MOTD (see the OMITTED block in 022-brew-packages.sh);
	# that path never worked and the logos are pre-rendered now. brew's
	# fastfetch stays -- it is newer than the image's and harmless -- but
	# chafa is a leaf with no remaining user.
	if brew list --formula chafa &>/dev/null; then
		brew uninstall -q chafa
	fi

	# brew-gem global gems (like cargo/go/uv)
	#
	# brew-gem writes each gem's formula into its own brew-gem/gems tap and
	# installs it by fully-qualified name, which brew allows through without
	# trust because the name is right there in argv. Every later load of the
	# installed formula -- `brew upgrade`, `brew outdated`, Bluefin's
	# brew-upgrade.timer -- has no such argv and refuses an untrusted tap
	# formula. `brew trust` is idempotent and is the replacement brew names
	# for the now-deprecated HOMEBREW_NO_REQUIRE_TAP_TRUST=1 this repo used
	# to export from the preamble and .commonprofile.
	brew trust --formula brew-gem/gems/gem-ruby-lsp
	brew gem install ruby-lsp
	# neovim: the ruby provider bridge gem (:checkhealth vim.provider).
	# The Windows counterpart for both gems is 00-nt/580-ruby-tooling.cmd.
	brew trust --formula brew-gem/gems/gem-neovim
	brew gem install neovim

	if ! [ "$CONTAINERIZED" -eq 1 ]; then
		echo "debug: installing brew services" >&2
		brew services start languagetool
	fi
else
	echo "error: no brew for misc. binary deps" >&2
	exit 1
fi
