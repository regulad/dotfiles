#!/bin/bash -e

# for Fedora {{ .chezmoi.osRelease.versionID }}

# https://rpmfusion.org/Configuration
sudo dnf install -y https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm
sudo dnf config-manager setopt fedora-cisco-openh264.enabled=1
# dnf check-update exits 100 when updates are available, which isn't a failure;
# it's only run here to refresh metadata before the following install.
dnf check-update || [ $? -eq 100 ]
sudo dnf install -y rpmfusion-\*-appstream-data

# NOTE: the VSCode repo + install moved to 012-vscode-dnf-repo.sh so it can be
# masked independently of the RPM Fusion setup above, which every target needs.
