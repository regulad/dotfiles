{{ template "posix-preamble.sh" . }}
# pnpm
if [ "$HAS_BREW" = "true" ]; then
	brew install -q pnpm
elif can_sudo; then
	sudo npm i -g -q pnpm@latest
else
	npm install -g --prefix ~/.local -q pnpm@latest
fi

# `pnpm setup`'s self-managed-copy step is flaky when pnpm is already installed
# via brew/npm (fails to link its own bundled binary), so just set PNPM_HOME
# directly instead of relying on it (same default as .commonprofile).
#
# pnpm's global bin directory is $PNPM_HOME/bin from pnpm 11.0.0 on
# (pnpm/pnpm#10986) and $PNPM_HOME itself before that, and every global
# command -- `pnpm bin -g` included, so pnpm cannot be asked -- refuses to run
# unless exactly that directory is on PATH. The major version picks it, as in
# .commonprofile.
export PNPM_HOME="${PNPM_HOME:-$HOME/.local/share/pnpm}"
PNPM_MAJOR="$(pnpm --version | cut -d. -f1)"
if [ "$PNPM_MAJOR" -ge 11 ]; then
	PNPM_BIN="$PNPM_HOME/bin"
else
	PNPM_BIN="$PNPM_HOME"
fi
case ":$PATH:" in
	*":$PNPM_BIN:"*) ;;
	*) export PATH="$PNPM_BIN:$PATH" ;;
esac
mkdir -p "$PNPM_BIN"

PNPM_CLI_PACKAGES=(
	"@mermaid-js/mermaid-cli@latest"
	"go-ios@latest"
	# The CLIs behind the vercel and cloudflare agent plugins' skills. Neither
	# has a homebrew-core formula: brew's `cf` is an unrelated timestamp
	# filter, so it must not be installed alongside this one.
	"vercel@latest"
	"cf@latest"
)

## packages available on brew are preferred over their pnpm packages (may have binary bottles pre-built)
if [ "$HAS_BREW" = "true" ]; then
	brew install -q \
		bitwarden-cli \
		typescript \
		typescript-language-server \
		bash-language-server \
		yaml-language-server \
		cloudflare-wrangler
else
	PNPM_CLI_PACKAGES+=(
		"@bitwarden/cli@latest"
		"typescript@latest"
		"typescript-language-server@latest"
		"bash-language-server@latest"
		"yaml-language-server@latest"
		"wrangler@latest"
	)
fi

# pnpm blocks dependency build scripts by default and prompts to approve them
# interactively -- including for transitive deps (e.g. mermaid-cli's puppeteer)
# -- which stalls an unattended apply. Opt out, but scoped to the global
# install directory (pnpm reads its settings from there) so ordinary projects
# keep the safe default. Matches the NT script.
PNPM_GLOBAL_DIR="$(pnpm root -g)"
mkdir -p "$PNPM_GLOBAL_DIR"
pnpm -C "$PNPM_GLOBAL_DIR" config set --location project dangerouslyAllowAllBuilds true

# go-ios' postinstall places its binary the way npm would, reading
# npm_config_prefix to find the target directory. pnpm doesn't set that, so the
# postinstall throws and fails the whole global install transaction -- leaving
# every other package unlinked. Point it at the parent of pnpm's global bin,
# which is what npm's prefix means on unix. Kept local to this script; npm
# shouldn't inherit it.
export npm_config_prefix="$(dirname "$(pnpm bin -g)")"

# deliberately not --silent: it suppresses fatal errors too, which is how the
# failing go-ios postinstall went unnoticed on the NT side.
pnpm i -g "${PNPM_CLI_PACKAGES[@]}"
pnpm update --global

# deno
export DENO_INSTALL="$HOME/.deno"
export PATH="$DENO_INSTALL/bin:$PATH"
