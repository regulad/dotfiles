{{ template "posix-preamble.sh" . }}
CHEZMOI_USE_DUMMY={{ if .useDummySecrets }}1{{ else }}0{{ end }}

# The clone lives with the other repositories, in ~/repositories/Vencord.
# ~/.vencord, where it lived until 2026-11, is a symlink to it now, so whatever
# points at that path keeps working. An existing ~/.vencord clone is moved into
# place rather than cloned again.
REPOS_DIR="$HOME/repositories"
VENCORD_DIR="$REPOS_DIR/Vencord"
VENCORD_LINK="$HOME/.vencord"

if [[ "$CHEZMOI_USE_DUMMY" -eq 1 ]]; then
    VENCORD_REMOTE_URL="https://github.com/regulad/Vencord.git"
    UP_WAKATIME_REMOTE_URL="https://github.com/wakatime/vencord-wakatime.git"
else
    VENCORD_REMOTE_URL="git@github.com:regulad/Vencord.git"
    UP_WAKATIME_REMOTE_URL="git@github.com:wakatime/vencord-wakatime.git"
fi

# Clones $2 into $1, or brings main in $1 up to origin/main. main only follows
# origin: when origin/main was rewritten under it, main is moved over, but only
# if a branch of origin still has every commit on it. That happened on
# 2026-11-12, when the fork's own commits went to
# plugin/deterministicUserPanning and main was reset to upstream's.
#
# A checkout on any other branch is someone's work, plugin work through
# `vencord-discord dev` for one: it is left on that branch, and SKIPPED keeps
# the build below from replacing what that work last built.
#
# Each clone and fetch gets three tries, as go-tooling.sh's go installs; a
# failed clone removes the directory it made. retry replays stdin, which git
# wants none of.
SKIPPED=0
sync_clone() {
    local dir="$1" url="$2" branch
    if [[ ! -d "$dir" ]]; then
        retry -t 3 -d 10,30 -- git clone "$url" "$dir" </dev/null
        return
    fi
    branch="$(git -C "$dir" branch --show-current)"
    if [[ "$branch" != main ]]; then
        echo "notice: $dir is on ${branch:-a detached HEAD}, not main; leaving it and the build as they are" >&2
        SKIPPED=1
        return
    fi
    git -C "$dir" remote set-url origin "$url"
    retry -t 3 -d 10,30 -- git -C "$dir" fetch origin </dev/null
    if ! git -C "$dir" merge --ff-only origin/main; then
        if [[ -z "$(git -C "$dir" branch -r --list 'origin/*' --contains main)" ]]; then
            echo "warning: main in $dir has commits no branch of origin has; building it as it is" >&2
        elif git -C "$dir" reset --keep origin/main; then
            echo "notice: main in $dir had left origin/main, and origin still has all of it; moved main to origin/main" >&2
        else
            echo "warning: could not move main in $dir to origin/main over local changes; building it as it is" >&2
        fi
    fi
}

mkdir -p "$REPOS_DIR"

if [[ -d "$VENCORD_LINK" && ! -L "$VENCORD_LINK" ]]; then
    if [[ -e "$VENCORD_DIR" || -L "$VENCORD_DIR" ]]; then
        echo "warning: $VENCORD_LINK is a directory and $VENCORD_DIR exists too; building $VENCORD_DIR and leaving $VENCORD_LINK for you to remove" >&2
    else
        echo "notice: moving the Vencord clone from $VENCORD_LINK to $VENCORD_DIR" >&2
        mv "$VENCORD_LINK" "$VENCORD_DIR"
    fi
fi

sync_clone "$VENCORD_DIR" "$VENCORD_REMOTE_URL"
mkdir -p "$VENCORD_DIR/src/userplugins"
sync_clone "$VENCORD_DIR/src/userplugins/vencord-wakatime" "$UP_WAKATIME_REMOTE_URL"

if [[ ! -e "$VENCORD_LINK" && ! -L "$VENCORD_LINK" ]]; then
    ln -s repositories/Vencord "$VENCORD_LINK"
    echo "notice: linked $VENCORD_LINK to $VENCORD_DIR" >&2
fi

# A skill beside upstream's in .skills, for agents working in the clone: how
# vencord-discord builds and reloads this machine's Discord. It describes this
# machine, not Vencord, so the clone's own .git/info/exclude keeps it out of
# git, and it is written on a branch too.
# Through a temporary file: bash 3.2 misparses a heredoc inside $(...) once
# the text has an apostrophe in it.
SKILL_NAME=desktop-discord.local.md
SKILL="$VENCORD_DIR/.skills/$SKILL_NAME"
SKILL_NEW="$(mktemp)"
cat >"$SKILL_NEW" <<'SKILL_EOF'
{{ includeTemplate "vencord-desktop-skill.md" . | trim }}
SKILL_EOF
mkdir -p "$VENCORD_DIR/.skills"
if ! cmp -s "$SKILL_NEW" "$SKILL"; then
    cat "$SKILL_NEW" >"$SKILL"
    echo "notice: wrote $SKILL" >&2
fi
rm -f "$SKILL_NEW"
EXCLUDE="$VENCORD_DIR/.git/info/exclude"
if ! grep -qxF "/.skills/$SKILL_NAME" "$EXCLUDE" 2>/dev/null; then
    mkdir -p "$VENCORD_DIR/.git/info"
    # A last line without its newline would run into this one.
    if [[ -s "$EXCLUDE" && -n "$(tail -c 1 "$EXCLUDE")" ]]; then
        echo >>"$EXCLUDE"
    fi
    echo "/.skills/$SKILL_NAME" >>"$EXCLUDE"
fi

if [[ "$SKIPPED" -eq 0 ]]; then
    # pnpm i purges node_modules when a different pnpm or lockfile laid it
    # down, as the step from Vencord 1.14 to 1.15 does. Without a TTY it
    # refuses unless told it may, and with one it stops to ask.
    (cd "$VENCORD_DIR" && pnpm i --config.confirmModulesPurge=false && pnpm build)
fi

# Into Discord stable, not Vesktop, which cannot receive rich presence: the
# discord cask on macOS, the --user Flatpak from 01-fedora/020-flatpak-packages
# on Linux. ~/.local/bin/vencord-discord holds the how. A checkout left alone
# above still gets injected: whatever it last built is what Discord loads.
if ! "$HOME/.local/bin/vencord-discord" inject; then
    echo "warning: Vencord is not injected into Discord; see above" >&2
fi
