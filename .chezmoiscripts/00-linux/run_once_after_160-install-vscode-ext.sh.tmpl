#!/bin/bash -e
# {{ include "dot_vscode-extensions.txt" | sha256sum }}
# code's own WSL-kernel detection otherwise prompts interactively (like the
# chezmoiignore WSL check, it treats any WSL2-flavored uname -r as real WSL,
# even on a container whose host merely happens to be WSL2-backed).
export DONT_PROMPT_WSL_INSTALL=1
if command -v code &>/dev/null; then
    # Install all extensions in a single `code` invocation. Spawning one `code`
    # process per extension (e.g. via `xargs -I {} code --install-extension {}`)
    # causes every invocation after the first to fail instantly as "not found"
    # instead of querying the marketplace, likely due to instance-lock/IPC
    # contention between the rapid-fire Electron CLI processes.
    # strip \r: dot_vscode-extensions.txt gets CRLF line endings on Windows
    # checkouts (core.autocrlf), and a trailing \r turns every extension ID
    # into one the marketplace has never heard of, failing every install.
    mapfile -t extensions < <(tr -d '\r' < ~/.vscode-extensions.txt)
    flags=()
    for extension in "${extensions[@]}"; do
        flags+=(--install-extension "$extension")
    done
    # Non-fatal: some requested extensions (e.g. github.copilot-chat, pulled in
    # as a hard dependency of github.copilot) may already ship built-in at a
    # newer version than the marketplace has, which `code` reports as a
    # permanent, unretryable failure. Don't let that abort the whole apply.
    retry -t 5 -d 2 -m 60 -- code "${flags[@]}" --force || echo "warning: some extensions failed to install (see above)" >&2

    # Uninstall anything installed that isn't in dot_vscode-extensions.txt.
    is_wanted() {
        local candidate="${1,,}" w
        for w in "${extensions[@]}"; do
            [[ "${w,,}" == "$candidate" ]] && return 0
        done
        return 1
    }
    mapfile -t installed < <(code --list-extensions)
    uninstall_flags=()
    for extension in "${installed[@]}"; do
        is_wanted "$extension" || uninstall_flags+=(--uninstall-extension "$extension")
    done
    if [ "${#uninstall_flags[@]}" -gt 0 ]; then
        retry -t 5 -d 2 -m 60 -- code "${uninstall_flags[@]}" --force || echo "warning: some extensions failed to uninstall (see above)" >&2
    fi
else
    echo "error: VSCode 'code' command not found in PATH" >&2
    exit 1
fi
