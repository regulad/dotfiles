{{ template "posix-preamble.sh" . }}
# Certificate installation
CERT_PATHS=(
	"$HOME/.x509/ipa-ca.crt"          # home.arpa
	"$HOME/.x509/regulad.internal.crt"        # regulad.internal
	"$HOME/.x509/cohensstore003.internal.crt" # cohensstore003.internal
	"$HOME/.x509/pve-root-ca.pem"     # gonkputer nonspecific
)

if [ "$CAN_SUDO" = "true" ]; then
	NEEDS_UPDATE=0

	for CERT_PATH in "${CERT_PATHS[@]}"; do
		# Check if certificate is already in system trust store
		if ! openssl verify -CApath /etc/ssl/certs "$CERT_PATH" &>/dev/null; then
			CERT_NAME=$(basename "$CERT_PATH")

			if [ -d /etc/pki/ca-trust/source/anchors ]; then
				# Fedora
				sudo cp "$CERT_PATH" "/etc/pki/ca-trust/source/anchors/$CERT_NAME"
				NEEDS_UPDATE=1
			elif [ -d /usr/local/share/ca-certificates ]; then
				# Debian/Ubuntu
				sudo cp "$CERT_PATH" "/usr/local/share/ca-certificates/$CERT_NAME"
				NEEDS_UPDATE=1
			fi
		fi
	done

	# Update trust store only if new certs were added
	if [ "$NEEDS_UPDATE" -eq 1 ]; then
		if [ -d /etc/pki/ca-trust/source/anchors ]; then
			sudo update-ca-trust
		elif [ -d /usr/local/share/ca-certificates ]; then
			sudo update-ca-certificates
		fi
	fi
else
	echo "warning: sudo required to install system certificate on Linux, skipping" >&2
fi

{{ if not .useDummySecrets -}}
# Client certificate (matches the "My" store import on NT); imported into the
# per-user NSS database that Chrome and other NSS-based tools read from.
#
# Templated out entirely under useDummySecrets: the source file is
# dot_x509/encrypted_dotfiles.p12.age, and the container images build with
# `CHEZMOI_USE_DUMMY=1 ... chezmoi apply --exclude encrypted`, so the decrypted
# .p12 never lands there. Emitting the import anyway made pk12util fail with
# PR_FILE_NOT_FOUND_ERROR and took the whole image build down with it, ~11
# minutes into the run.
if command -v pk12util &>/dev/null; then
	mkdir -p "$HOME/.pki/nssdb"
	if [ ! -f "$HOME/.pki/nssdb/cert9.db" ]; then
		certutil -N -d "sql:$HOME/.pki/nssdb" --empty-password
	fi
	# pk12util re-importing an already-present cert+key is a verified no-op
	# (exit 0, no stderr output) -- no idempotency guard needed here.
	pk12util -d "sql:$HOME/.pki/nssdb" -i "$HOME/.x509/dotfiles.p12" -W ""
else
	echo "error: pk12util not available, can't import client certificate" >&2
	exit 1
fi
{{- end }}
