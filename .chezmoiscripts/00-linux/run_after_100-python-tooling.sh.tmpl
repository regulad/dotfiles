{{ template "posix-preamble.sh" . }}
# Poetry
# NOTE: redhat repositories provide poetry-core but not the CLI
# The can_sudo test is what used to be guaranteed by the preamble, which
# refused to run at all on an apt host without sudo. That blanket check is
# gone (it was probing sudo in all 26 scripts), so ask here -- and on an apt
# host that can't sudo, fall through to brew or pip rather than dying.
if [ "$MANAGER" = "apt" ] && can_sudo; then
	sudo apt install -qq -y python3-poetry
elif [ "$HAS_BREW" = "true" ]; then
	brew install -q poetry
else
	pip install --user -q poetry
fi

# UV
if [ "$HAS_BREW" = "true" ]; then
	brew install -q uv
else
	pip install --user -q uv
fi

# NOTE: poetry is for legacy workflows.
# NOTE: `uv tool install` replaces pipx
# can install with `pipx i <package>`
# or `uv tool install <package>`
# NOTE: uv deliberately ignores upper bounds on requires-python,
#       which boosts speed since pip likes to "backstep" and take
#       the highest package version which supports the python version.
#
#       This leads to issues with code that requires stable ABI presence.
#
#       I have chosen to only download tools with uv against known-good python versions.
#
#       to native package managers that test against specific python versions.
#
#       This can be changed if the python-requires spec at https://packaging.python.org/en/latest/specifications/core-metadata/#core-metadata-requires-python
#       is ever updated to better accomidate the Python ecosystem with its alternative implementations and ABIs.
#
#       Until then, for cli apps, I will be using the latest version of Cpython that the app has been tested against.
#       For example, pre-commit tests against https://github.com/pre-commit/pre-commit/blob/main/.github/workflows/main.yml 3.13 as its newest supported python version.
#
#       Some tools here like "mangadex-downloader" have a pre-prepared Dockerfile that uses a pinned Python version.
#       Those versions are mirrored in the selected version for the tools.
uv tool install -q ruff # astral-backed
uv tool install -q ty   # astral-backed

uv tool install --python "pypy@3.11" -q --with "bgutil-ytdlp-pot-provider" "yt-dlp[pin,pin-curl-cffi,pin-secretstorage,pin-deno]"
uv tool install --python cp314 -q keydive
uv tool install --python cp313 -q pre-commit
uv tool install --python cp313 -q "mangadex-downloader[optional]"
uv tool install --python cp310 -q "git+https://github.com/regulad/keymap-renderer.git@master"

# NOTE: the frida python binding speaks a wire protocol to frida-server on the
#       device, and the two only understand each other at the same version. A
#       mismatch fails at connect time with an "unsupported version" and nothing
#       more actionable, so the binding is what has to be pinned -- and it has to
#       be pinned to whatever the device is actually running, not to whatever is
#       newest.
#
#       That version is 16.7.0, and it is not a free choice in either direction:
#
#         roothide  https://miticollo.github.io/repos/roothide/Packages is the
#                   repo carrying re.frida.server for roothide devices, and
#                   16.7.0 is the newest build hosted there. The 17.x major
#                   family has not been ported to roothide at all, so there is
#                   no newer server to match even if this wanted one.
#         16.7      is also the end of the line upstream. frida moves major and
#                   minor together as a single unit rather than as semver's
#                   major/minor pair -- 16.7 is its own family, not a
#                   backwards-compatible step up from 16.6 -- and 16.7 is the
#                   last such family before the 17.x break. 16.7.19 is the newest
#                   patch within it, but patch is the only axis that could move
#                   here without the server having to move in lockstep.
#
#       frida-tools asks for frida>=16.2.2,<17.0.0. That range is loose enough to
#       resolve to 16.7.19 today and to drift again on any later install, so the
#       --with intersects it down to the one version that matches the device.
#       Both pins land in the tool receipt, which is what makes them survive the
#       `uv tool upgrade --all` at the bottom of this script -- it reports
#       nothing to upgrade rather than quietly re-resolving the binding out from
#       under the device.
#
#       13.7.1 is the CLI generation that goes with that binding. It publishes an
#       sdist only, so it is built locally, but it is pure python and builds
#       anywhere. cp312 is therefore an ordinary known-good interpreter choice
#       rather than a constraint: frida's own wheels are cp37 abi3, so the
#       stable-ABI concern in the note above is the one case here it does not
#       apply to.
#
#       The line this replaces -- an unpinned `--python cp310 -q frida-tools` --
#       was already broken, and silently so. It resolved to frida-tools 14.10.4
#       against frida 17.17.0, whose __init__ imports typing.NotRequired and so
#       needs 3.11+; every frida CLI on the box then died at import with an
#       ImportError under 3.10. That is the requires-python drift described in
#       the note above actually happening, and pinning both halves is what stops
#       it recurring.
uv tool install --python cp312 -q --with "frida==16.7.0" "frida-tools==13.7.1"

# NOTE: 2.3 onward are LLM slop, and 2.2 is the last version that didn't change
#       the schema. cp313 because 2.2 wants pydantic-core 2.27.2, which has no
#       cp314 wheel.
#
#       The --with pins exist because 2.2 is frozen and `uv tool upgrade --all`
#       at the bottom of this script re-resolves everything that isn't nailed
#       down. rendercv 2.2 pins its own direct deps with ==, but two of them are
#       loose, and the packages it pins have loose deps of their own -- so the
#       exposure is one level down, where nothing can ever be upgraded to a fix:
#
#         rendercv-fonts  no version bound whatsoever. 0.5.0 stopped shipping
#                         "Font Awesome 6" and 2.2 does an unguarded
#                         available_font_families.remove() of it -> ValueError
#                         at import.
#         click, rich     rendercv pins typer==0.15.1 exactly, so typer can
#                         never move, yet typer asks for click>=8.0.0 and
#                         rich>=10.11.0 with no ceiling on either. click 8.2
#                         changed Parameter.make_metavar() to require ctx and
#                         broke every --help path.
#
#                         rich is the same trap with the trigger unpulled, and
#                         it is capped at the bound typer actually asked for:
#                         rich's CHANGELOG declares adherence to semver, so
#                         ">=10.11.0" means "10.11.0 or later, within major 10"
#                         and <11 is simply that promise written down. This
#                         resolves to 10.16.2 -- old, but frozen, so unlike a
#                         floating cap it cannot spring a surprise at all.
#
#                         Two consequences worth knowing. rich 10 predates the
#                         markdown-it-py switch, so the tree gains commonmark,
#                         which is itself unmaintained -- harmless here because
#                         nothing in this CLI renders Markdown through rich.
#                         And typer 0.15.1 is from Dec 2024, when rich 13.9 was
#                         current, so its 10.11.0 floor is stale rather than
#                         tested; <14 would track what typer actually shipped
#                         against if the old console chrome ever grates.
#         jinja2          rendercv's own jinja2>=3.1.3, its only uncapped
#                         runtime dep besides the fonts. Template rendering is
#                         the whole program, so a jinja2 4.0 is not something to
#                         meet by surprise.
#
#       Audited and deliberately left uncapped: typing-extensions, annotated-
#       types, shellingham, idna, dnspython, markupsafe -- all additive-by-policy
#       or trivially small. pycountry looks alarming (2.2 pins 24.6.1, latest is
#       26.x) but pydantic-extra-types only asks for >=23, so rendercv's == wins
#       and nothing floats. commonmark is frozen and abandoned, which is exactly
#       why it needs no bound.
uv tool install --python cp313 -q \
	--with "rendercv-fonts<0.5" \
	--with "click<8.2" \
	--with "rich<11" \
	--with "jinja2<4" \
	"rendercv[full]@2.2"

uv tool install --python cp314 -q pymobiledevice3
uv tool install --python cp314 -q claude-swap

# like in the JS ecosystem, some python tools are available as tools/bottles from brew
if [ "$HAS_BREW" = "true" ]; then
	brew install -q \
		hatch \
		autopep8
else
	uv tool install -q hatch
	uv tool install -q autopep8
fi

uv tool upgrade --quiet --all
