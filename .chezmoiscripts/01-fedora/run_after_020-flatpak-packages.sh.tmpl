{{ template "posix-preamble.sh" . }}

# Generic flatpak package runner for the Fedora family (fedora + bluefin --
# this whole directory is masked to those IDs in .chezmoiignore.tmpl). Same
# paradigm as 00-nt/run_after_100-winget.ps1: a declared list of app IDs,
# updated when already present and installed otherwise. No remote is named on
# install -- flatpak resolves each ID against whatever remotes the system has
# configured (Fedora ships fedora + flathub, Bluefin ships flathub), so the
# source belongs to the system, not this script.

# Flatpaks are session-scoped GUI apps; a container has no session to serve
# and usually no flatpak/dbus/polkit stack to install through either.
if [ "$CONTAINERIZED" -eq 1 ]; then
	echo "notice: containerized, skipping flatpak packages" >&2
	exit 0
fi
# A WSL instance is the container image repackaged, so it has no flatpak
# either; without this the check below failed every WSL apply.
if [ "$IS_WSL" -eq 1 ]; then
	echo "notice: WSL (built from the container image, no flatpak), skipping flatpak packages" >&2
	exit 0
fi

if ! command -v flatpak &>/dev/null; then
	echo "error: flatpak not on PATH; it ships in every Fedora-family install" >&2
	exit 1
fi

FLATPAK_PACKAGES=(
	# =+= DESKTOP
	# mpv and vlc live here, not in 00-linux/020-dnf-packages.sh or
	# 022-brew-packages.sh: GUI media apps on the Fedora family are flatpaks,
	# and this is their single install mechanism. Their configs are wired into
	# the sandboxes by 021-flatpak-media-config.sh.
	io.mpv.Mpv
	org.videolan.VLC
)

for app in "${FLATPAK_PACKAGES[@]}"; do
	if flatpak info "$app" &>/dev/null; then
		echo "debug: updating flatpak $app" >&2
		flatpak update -y --noninteractive "$app"
	else
		echo "debug: installing flatpak $app" >&2
		flatpak install -y --noninteractive "$app"
	fi
done

# Per-user flatpaks. Discord runs from its Flatpak deployment, and that is
# where ~/.local/bin/vencord-discord puts the stub that loads Vencord. A
# --user install keeps the deployment the user's to write; a system one would
# need root for every injection. A user installation sees no system remote,
# hence its own flathub.
FLATPAK_USER_PACKAGES=(
	com.discordapp.Discord
)

flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
for app in "${FLATPAK_USER_PACKAGES[@]}"; do
	if flatpak info --user "$app" &>/dev/null; then
		echo "debug: updating user flatpak $app" >&2
		flatpak update --user -y --noninteractive "$app"
	else
		echo "debug: installing user flatpak $app" >&2
		flatpak install --user -y --noninteractive flathub "$app"
	fi
done
if flatpak info --system com.discordapp.Discord &>/dev/null; then
	echo "notice: Discord is also installed system-wide, where Vencord is not injected; remove that copy with: flatpak uninstall --system com.discordapp.Discord" >&2
fi

# An install or update above is a new deployment, without the stub. Updates
# from anywhere else (GNOME Software, Bluefin's background ones) wake
# vencord-discord-inject.path instead.
if ! "$HOME/.local/bin/vencord-discord" inject; then
	echo "warning: Vencord is not injected into Discord; see above" >&2
fi
systemctl --user enable --now vencord-discord-inject.path
