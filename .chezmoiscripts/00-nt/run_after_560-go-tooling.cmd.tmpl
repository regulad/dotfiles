@echo off
setlocal enabledelayedexpansion

REM matches unix script (minus osc52pty, which is darwin-only there too)

if defined GOPATH (
    set "GO_BIN=%GOPATH%\bin"
) else (
    set "GO_BIN=%USERPROFILE%\go\bin"
)

echo ;%PATH%; | find /I ";%GO_BIN%;" >nul
if errorlevel 1 set "PATH=%PATH%;%GO_BIN%"

REM append to the User-scope PATH specifically -- reusing %PATH% here would fold
REM the Machine-scope entries into the user's own copy of it.
set "GO_USER_PATH="
for /f "delims=" %%i in ('powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "[Environment]::GetEnvironmentVariable('PATH','User')"') do set "GO_USER_PATH=%%i"
echo ;!GO_USER_PATH!; | find /I ";%GO_BIN%;" >nul
if errorlevel 1 (
    call :neosetx PATH "!GO_USER_PATH!;%GO_BIN%"
    echo Added %GO_BIN% to PATH.
) else (
    echo %GO_BIN% is already in PATH.
)

call refreshenv >nul 2>&1

where go >nul 2>&1
if errorlevel 1 (
    echo error: go not resolvable on PATH 1>&2
    exit /b 1
)

REM auto lets Go fetch a newer toolchain on demand if a tool (like gopls) needs one
set "GOTOOLCHAIN=auto"

REM the unix scripts run under `bash -e`, so a failing `go install` aborts the
REM apply there. cmd carries on regardless, so check each one explicitly.
echo debug: installing go tooling
call :goinstall mvdan.cc/sh/v3/cmd/shfmt@latest || goto :go_install_failed
call :goinstall golang.org/x/tools/gopls@latest || goto :go_install_failed
call :goinstall golang.org/x/tools/cmd/goimports@latest || goto :go_install_failed
call :goinstall honnef.co/go/tools/cmd/staticcheck@latest || goto :go_install_failed
call :goinstall github.com/twpayne/find-duplicates@latest || goto :go_install_failed
call :goinstall github.com/swaggo/swag/cmd/swag@latest || goto :go_install_failed

goto :eof

:goinstall
go install %1
if errorlevel 1 (
    echo error: go install %1 failed 1>&2
    exit /b 1
)
exit /b 0

:go_install_failed
echo error: go tooling install failed, aborting 1>&2
exit /b 1

{{ template "neosetx.cmd" . }}
