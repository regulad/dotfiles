{{- $clientP12 := joinPath .chezmoi.sourceDir "dot_x509" "client" "encrypted_dotfiles.p12.age" -}}
@echo off

REM Client certificate, split out from the CA install (020-x509-ca) so that the
REM two re-run independently and so .chezmoiignore can mask *only* this script
REM under useDummySecrets -- the CAs are not secrets and stay installed there.
REM
REM run_onchange_ trigger: the digest is of the age *ciphertext*, since the
REM `include` template function does not decrypt. That means no age identity is
REM needed to render this script, and rotating the client cert re-runs it.
REM
REM Client cert source digest:
REM     dot_x509/client/encrypted_dotfiles.p12.age {{ include $clientP12 | sha256sum }}

echo debug: installing client certificate
certutil -user -p "" -importpfx "My" "%USERPROFILE%\.x509\client\dotfiles.p12"

REM Chrome's AutoSelectCertificateForUrls rules, which present this certificate
REM without a prompt, live in .chezmoitemplates/registry-system.reg and are
REM imported by 000-registry with the rest of the machine-wide registry values.
