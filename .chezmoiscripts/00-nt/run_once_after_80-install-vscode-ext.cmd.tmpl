@echo off
REM {{ include "dot_vscode-extensions.txt" | sha256sum }}
where code >nul 2>nul
if %ERRORLEVEL% EQU 0 (
    REM Install all extensions in a single `code` invocation. Spawning one
    REM `code` process per extension causes every invocation after the first
    REM to fail instantly as "not found" instead of querying the marketplace,
    REM likely due to instance-lock/IPC contention between the rapid-fire
    REM Electron CLI processes.
    setlocal enabledelayedexpansion
    set "FLAGS="
    for /F "tokens=*" %%A in (%USERPROFILE%\.vscode-extensions.txt) do (
        set "FLAGS=!FLAGS! --install-extension %%A"
    )
    call code !FLAGS! --force

    REM Uninstall anything installed that isn't in dot_vscode-extensions.txt.
    set "UNINSTALL_FLAGS="
    for /F "tokens=*" %%B in ('call code --list-extensions') do (
        findstr /I /X /C:"%%B" "%USERPROFILE%\.vscode-extensions.txt" >nul 2>nul
        if errorlevel 1 (
            set "UNINSTALL_FLAGS=!UNINSTALL_FLAGS! --uninstall-extension %%B"
        )
    )
    if defined UNINSTALL_FLAGS (
        call code !UNINSTALL_FLAGS! --force
    )
    endlocal
) else (
    echo error: VSCode 'code' command not found in PATH 1>&2
    exit /b 1
)

