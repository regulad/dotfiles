{{- $login := (bitwarden "item" .smtp.bitwardenItem).login -}}
# Puts git send-email's SMTP password, from Bitwarden (.chezmoidata/smtp.toml),
# into Windows Credential Manager through Git Credential Manager, the helper
# .gitconfig pins for smtp://<host>:<port>, so send-email never prompts for
# it. WSL's git reads the same entry through the same GCM. The macOS twin is
# 00-macos/146-git-smtp-credential.sh. Masked under useDummySecrets in
# .chezmoiignore.
#
# After scoop (200/210), which is where git and GCM come from.
#
# run_after_, every apply. GCM is asked first, so an apply with nothing to do
# writes nothing, and a password rotated in Bitwarden goes in on the next
# apply. run_onchange_ would record an apply that ran before git was on PATH
# as done.
#
# The credential is rendered into this script, so it passes through chezmoi's
# temporary copy of it for the length of the run, as 145-gpg-keys's passphrase
# does. It is base64 there, so no character in it can close the string
# literal, and it reaches GCM on stdin, never as an argument. stdin is UTF-8
# explicitly: Windows PowerShell 5.1 otherwise writes ASCII to a native
# command, turning anything outside it into '?'.
$Url = 'smtp://{{ .smtp.host }}:{{ .smtp.port }}'

if (-not (Get-Command git -ErrorAction SilentlyContinue)) {
    Write-Host "warning: git is not on PATH in this apply (scoop's shims only reach shells started after it), so the SMTP credential for $Url waits for the next apply"
    exit 0
}

$Utf8NoBom = New-Object System.Text.UTF8Encoding $false
$OutputEncoding = $Utf8NoBom
[Console]::OutputEncoding = $Utf8NoBom

function ConvertFrom-Base64([string]$Text) {
    [System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String($Text))
}
$User = ConvertFrom-Base64 '{{ $login.username | b64enc }}'
$Password = ConvertFrom-Base64 '{{ $login.password | b64enc }}'
$Query = "protocol=smtp`nhost={{ .smtp.host }}:{{ .smtp.port }}`nusername=$User`n"

# With nothing stored, GCM would open its sign-in dialog; never makes it fail
# instead.
$env:GCM_INTERACTIVE = 'never'
function Get-StoredPassword {
    foreach ($Line in @($Query | git credential-manager get 2>$null)) {
        if ($Line.StartsWith('password=')) { return $Line.Substring('password='.Length) }
    }
    return $null
}

$Stored = Get-StoredPassword
if ($Stored -ceq $Password) {
    Write-Host "debug: SMTP credential for $Url already in Windows Credential Manager"
    exit 0
}

"${Query}password=$Password`n" | git credential-manager store 2>$null
if ((Get-StoredPassword) -cne $Password) {
    Write-Host "error: Git Credential Manager did not keep the SMTP credential for $Url"
    exit 1
}
if ($null -eq $Stored) {
    Write-Host "notice: stored the SMTP credential for $Url in Windows Credential Manager"
} else {
    Write-Host "notice: updated the SMTP credential for $Url in Windows Credential Manager (the password changed in Bitwarden)"
}
