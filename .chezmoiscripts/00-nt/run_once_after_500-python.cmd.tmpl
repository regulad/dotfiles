@echo off
setlocal enabledelayedexpansion

{{ template "uv-env.cmd" . }}

echo debug: installing python tooling
REM The tools are .chezmoidata/python-tools.toml, shared with the unix scripts
REM (.chezmoitemplates/python-tooling.sh), which take some from brew. Here
REM every one comes from uv, with the interpreter its entry pins: its
REM pythonWindows, else cp3xx for a "3.xx" python, else that python as it is.
REM Why each is pinned, and what Windows does without, is in that file.
REM run_once keys on the script contents, so a change there changes the hash
REM and this re-runs -- the list stays self-healing without reinstalling
REM everything on every apply. Upgrading what is already installed lives in
REM 501-python.cmd, which runs on every apply.

REM the unix scripts run under `bash -e`, so a failing `uv tool install` aborts
REM the apply there. cmd carries on regardless, so check each one explicitly.
{{- range .pythonTools.packages }}
{{-   $os := get . "os" }}
{{-   if or (not $os) (has "windows" $os) }}
{{-     $python := get . "python" }}
{{-     if regexMatch "^3\\.[0-9]+$" $python }}
{{-       $python = printf "cp%s" (replace "." "" $python) }}
{{-     end }}
{{-     $python = get . "pythonWindows" | default $python }}
call :uvinstall{{ if $python }} --python "{{ $python }}"{{ end }} -q{{ range (get . "with" | default list) }} --with "{{ . }}"{{ end }} "{{ get . "spec" | default .name }}" || goto :uv_install_failed
{{-   end }}
{{- end }}

goto :eof

:uvinstall
uv tool install %*
if errorlevel 1 (
    echo error: uv tool install %* failed 1>&2
    exit /b 1
)
exit /b 0

:uv_install_failed
echo error: python tooling install failed, aborting 1>&2
exit /b 1
