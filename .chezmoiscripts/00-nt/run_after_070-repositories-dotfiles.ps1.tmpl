# ~/repositories\dotfiles: a symlink to this chezmoi source, so the clone sits
# with the other repositories. The Windows counterpart of
# 00-{linux,macos}/002-repositories-dotfiles; the reasons are in
# .chezmoitemplates/repositories-dotfiles.sh. ~/repositories is the D: Dev
# Drive here (symlink_repositories), and the link points back at C:.
#
# mklink rather than New-Item, which in Windows PowerShell needs elevation for
# a symlink, as in 600-vencord.

Write-Host 'debug: entering hookscript'
$ReposDir = Join-Path $HOME 'repositories'
$Link = Join-Path $ReposDir 'dotfiles'
$Source = [IO.Path]::GetFullPath({{ .chezmoi.workingTree | squote }})

# ~/repositories is a link to D:\repositories, which a machine without the
# Dev Drive, and a CI runner, lacks. Test-Path on the link itself only says the
# link exists, so its target is tested instead: nothing can be created through
# a link that points at nothing (mklink: "The system cannot find the path
# specified").
$ReposItem = Get-Item -LiteralPath $ReposDir -Force -ErrorAction SilentlyContinue
if ($ReposItem -and $ReposItem.LinkType) {
    $ReposTarget = [string]($ReposItem.Target | Select-Object -First 1)
    if (-not (Test-Path -LiteralPath $ReposTarget -PathType Container)) {
        Write-Host "warning: $ReposDir links to $ReposTarget, which does not exist (050-dev-drive); no dotfiles link this time"
        exit 0
    }
}
if (-not $ReposItem) {
    New-Item -ItemType Directory -Path $ReposDir | Out-Null
}

$Item = Get-Item -LiteralPath $Link -Force -ErrorAction SilentlyContinue
if ($Item -and $Item.LinkType -eq 'SymbolicLink') {
    $Target = [string]($Item.Target | Select-Object -First 1)
    if ($Target -eq $Source) {
        Write-Host "debug: $Link already points at $Source"
        exit 0
    }
    Write-Host "notice: $Link pointed at $Target; repointing it at $Source"
    cmd /c rmdir "$Link"
} elseif ($Item) {
    Write-Host "warning: $Link exists and is not a symlink; leaving it, so it does not point at $Source"
    exit 0
} else {
    Write-Host "notice: linking $Link to $Source"
}

cmd /c mklink /D "$Link" "$Source" | Out-Null
if ($LASTEXITCODE -ne 0) {
    Write-Host "error: mklink could not create $Link (exit $LASTEXITCODE)"
    exit 1
}
