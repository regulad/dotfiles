{{- if .useDummySecrets }}
Write-Host 'debug: useDummySecrets is set, skipping GPG key import'
{{- else }}
$ErrorActionPreference = 'Stop'
if (-not (Get-Command gpg -ErrorAction SilentlyContinue)) {
    throw 'error: gpg not on PATH, cannot import GPG keys'
}
{{ template "private-import-temp.ps1" . }}
try {
{{ template "decrypt-import.ps1" (dict "root" . "name" "gpg-public.asc.age") }}
{{ template "decrypt-import.ps1" (dict "root" . "name" "gpg-secret.asc.age") }}
    gpg --batch --list-keys *> $null
    if ($LASTEXITCODE -ne 0) { throw 'error: could not initialize GPG keyring' }
    gpg --batch --yes --import (Join-Path $ImportDir 'gpg-public.asc')
    if ($LASTEXITCODE -ne 0) { throw 'error: public GPG key import failed' }
    # The passphrase goes through stdin, never a process argument.
    {{ (bitwarden "item" "f61fd2e0-3284-4c3b-8274-87cdeec73aa2").login.password | replace "'" "''" | printf "'%s'" }} | gpg --batch --yes --pinentry-mode loopback --passphrase-fd 0 --import (Join-Path $ImportDir 'gpg-secret.asc')
    if ($LASTEXITCODE -ne 0) { throw 'error: secret GPG key import failed' }
} finally {
    Remove-Item -LiteralPath $ImportDir -Recurse -Force
}
{{- end }}
