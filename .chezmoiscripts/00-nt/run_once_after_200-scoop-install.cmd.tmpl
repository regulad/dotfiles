@echo off
setlocal enabledelayedexpansion

REM Install half of the scoop setup. Upgrading existing packages lives in
REM 210-scoop-update.cmd, which runs on every apply; this one is run_once.
REM
REM run_once keys on the script contents, so adding a package to either list
REM below changes the hash and this re-runs -- the lists stay self-healing
REM without needing to reinstall everything on every apply.

call where scoop >nul 2>&1
if %errorLevel% neq 0 (
    echo debug: installing scoop
    call powershell -Command "Start-Process powershell -Verb RunAs -ArgumentList '-Command', 'Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Scope CurrentUser -Force; irm get.scoop.sh | iex' -Wait"
)
call refreshenv >nul 2>&1

REM Refresh bucket manifests before installing, or a stale checkout installs a
REM stale version. This is manifest refresh, not package upgrade -- the latter
REM is `scoop update --all` and belongs to 210-scoop-update.cmd.
echo debug: refreshing scoop manifests
call scoop update

call scoop bucket list | findstr /R /C:"^extras " >nul 2>&1
if errorlevel 1 (
    echo Adding extras bucket...
    call scoop bucket add extras
) else (
    echo extras bucket already present, skipping.
)
call scoop bucket list | findstr /R /C:"^versions " >nul 2>&1
if errorlevel 1 (
    echo Adding versions bucket...
    call scoop bucket add versions
) else (
    echo versions bucket already present, skipping.
)
call scoop bucket list | findstr /R /C:"^nonportable " >nul 2>&1
if errorlevel 1 (
    echo Adding nonportable bucket...
    call scoop bucket add nonportable
) else (
    echo nonportable already present, skipping.
)
call scoop bucket list | findstr /R /C:"^games " >nul 2>&1
if errorlevel 1 (
    echo Adding games bucket...
    call scoop bucket add games
) else (
    echo games already present, skipping.
)

call scoop bucket list | findstr /R /C:"^regulad " >nul 2>&1
if errorlevel 1 (
    echo Adding regulad bucket...
    call scoop bucket add regulad https://github.com/regulad/scoop-regulad.git
) else (
    echo regulad bucket already present, skipping.
)
call scoop bucket list | findstr /R /C:"^psmux " >nul 2>&1
if errorlevel 1 (
    echo Adding psmux bucket...
    call scoop bucket add psmux https://github.com/marlocarlo/scoop-psmux
) else (
    echo psmux bucket already present, skipping.
)

REM act (nektos/act) is not in the list: it drives a Docker Engine API, and
REM with Docker Desktop gone nothing on Windows serves one -- wslc keeps its
REM dockerd private to its VM (see the README TODOs). 105-docker-desktop-remove
REM uninstalls an act left over from before.
REM
REM gradle is not in the list either. Its manifest (main/gradle.json) has a
REM post_install that sets a per-user GRADLE_USER_HOME pointing into scoop's
REM own persist directory whenever the user scope has none, and a user value
REM shadows the machine-wide one that keeps Gradle's home on the D: Dev Drive
REM (registry-system.reg). registry-user.reg holding the same D: path per-user
REM leaves that check nothing to do, but a hook that redirects Gradle's home
REM has no business running at all, and scoop cannot be told to skip it: as of
REM 0.6.0 every post_install runs unconditionally, with no install flag or
REM config key to stop it. Projects bring their own Gradle through gradlew
REM instead. 205-scoop-gradle-remove uninstalls a gradle left over from before.
REM
REM sops is not in the list either: scoop's manifest depends on scoop's gpg, a
REM second GnuPG beside the Gpg4win that 100-winget installs and
REM 220-gpg-scoop-unlink keeps in charge. winget's SecretsOPerationS.SOPS has no
REM such dependency, so it comes from there.
REM
REM retry is the regulad bucket's: minfrin/retry, the tool apt, dnf and brew
REM ship as retry, built against the MSYS2 runtime since it has no native port
REM (https://github.com/regulad/retry/tree/main/windows). age is extras'.
REM
REM telnet is not in the list: it is Windows' own Telnet Client, enabled by
REM 040-telnet-client. scoop's telnet was GNU inetutils 1.7 from 2009 on
REM MinGW's abandoned MSYS1 runtime; 206-scoop-telnet-remove uninstalls it.
REM
REM Order matters where shims collide: the package installed last owns the
REM shim. gow ships old GNU builds of many tools (make 3.81 among them), so
REM make comes after it, as grep and coreutils already did. It used to sit
REM before gow, which went unnoticed because make was never installed at all:
REM the old installed-check (see :check_install_user) took cmake's row,
REM "cmake  4.x", for make.
{{- /* The GUI apps are left out under useHeadless, as 100-winget's are:
       tinyxnb (Explorer thumbnails for .xnb), mongodb-compass, mpv, ffdec,
       autohotkey, and icaros-np (Explorer thumbnails) further down. In
       template comments, so the rendered script, and with it this run_once's
       hash, is the same as before where they are installed. */}}
set user_packages=^
maven ^
tesseract ^
tesseract-languages ^
cmake ^
whisper-cpp ^
iperf3 ^
{{- if not .useHeadless }}
tinyxnb ^
{{- end }}
shasum ^
deno ^
mongosh ^
{{- if not .useHeadless }}
mongodb-compass ^
mpv ^
{{- end }}
git-filter-repo ^
python27 ^
dtk ^
ninja ^
bitwarden-cli ^
chezmoi ^
psmux ^
clink ^
gh ^
git ^
{{- if not .useHeadless }}
ffdec ^
{{- end }}
nodejs ^
gow ^
bind ^
pnpm ^
nmap ^
rust ^
go ^
golangci-lint ^
fastfetch ^
ripgrep ^
actionlint ^
hadolint ^
opentofu ^
terraform ^
tflint ^
jq ^
yq ^
age ^
retry ^
unzip ^
vim ^
neovim ^
clangd ^
rust-analyzer ^
harper ^
jdtls ^
lua ^
luarocks ^
perl ^
ruby ^
msys2 ^
uv ^
file ^
dos2unix ^
make ^
grep ^
coreutils ^
openssl ^
wingetcreate ^
rclone ^
less ^
imagemagick ^
{{- if not .useHeadless }}
autohotkey ^
{{- end }}
languagetool-java ^
nssm

REM Complex command blocks inside for loops break cmd's parser even without pipes.
REM Subroutine call isolates each package check cleanly. Fix by Claude Sonnet 4.6 (Anthropic).
echo debug: installing new scoop user packages
for %%p in (%user_packages%) do call :check_install_user %%p || goto :scoop_install_failed
goto :after_check_install_user

REM Installed means a `scoop list` row that starts with the exact name. The
REM query is a substring match (`scoop list age` also lists imagemagick and
REM tesseract-languages), so the name has to be anchored to the start of the
REM row, and a version need not start with a digit: matching "name, spaces,
REM digit" read telnet's msys-inetutils-1.7-1 as missing on every run. A
REM download that failed leaves the app's directory behind, which `scoop list`
REM still shows, marked "Install failed"; that row does not count, and the next
REM `scoop install` purges it before trying again.
:scoop_installed
scoop list %1 2>nul | findstr /b /l /c:"%1 " | findstr /v /l /c:"Install failed" >nul 2>&1
exit /b

:check_install_user
call :scoop_installed %1
if errorlevel 1 (
    echo debug: %1 not installed, installing...
    call :scoop_install %1
    if errorlevel 1 (
        echo error: failed to install scoop package %1 1>&2
        exit /b 1
    )
) else (
    echo debug: %1 already installed, skipping
)
exit /b 0

REM `scoop install %1`, run through %2 (sudo) when given. Each app downloads
REM from its own publisher's server, and some of those fail now and then:
REM nssm.cc answers 503 on and off. Three tries, half a minute apart. `call`
REM because scoop is scoop.cmd, and a batch file run without it never hands
REM control back. Each try is judged by :scoop_installed, not by scoop's exit
REM status, which is 0 even when the download failed: bin/scoop.ps1 runs the
REM subcommand with `&` and never passes its exit code on, so the `exit 1` in
REM scoop-install's abort ends only the subcommand's script.
:scoop_install
set /a scoop_try=0
:scoop_install_try
set /a scoop_try+=1
call %~2 scoop install %1
call :scoop_installed %1
if not errorlevel 1 exit /b 0
if %scoop_try% geq 3 exit /b 1
echo warning: scoop install %1 failed ^(try %scoop_try% of 3^), retrying in 30 seconds 1>&2
powershell -NoProfile -NonInteractive -Command "Start-Sleep -Seconds 30"
goto :scoop_install_try

:after_check_install_user
{{- if not .useHeadless }}

REM prompts mpv to use the chezmoi provided config in .config
REM NOTE: this was a PowerShell Remove-Item line sitting in a .cmd file, so cmd
REM reported "not recognized as an internal or external command" and carried on
REM -- the directory was never actually removed and mpv kept using its portable
REM config. Rewritten in cmd, and guarded so a missing directory is not an error.
if exist "%USERPROFILE%\scoop\apps\mpv\current\portable_config" (
    echo debug: removing mpv portable_config so the chezmoi config in .config wins
    rmdir /s /q "%USERPROFILE%\scoop\apps\mpv\current\portable_config"
    if errorlevel 1 (
        echo error: failed to remove mpv portable_config 1>&2
        exit /b 1
    )
)

set admin_packages=^
icaros-np

echo debug: installing new scoop admin packages
for %%p in (%admin_packages%) do call :check_install_admin %%p || goto :scoop_install_failed
{{- end }}
goto :after_check_install_admin

REM Same test and install as :check_install_user, elevated.
:check_install_admin
call :scoop_installed %1
if errorlevel 1 (
    echo debug: %1 not installed, installing...
    call :scoop_install %1 sudo
    if errorlevel 1 (
        echo error: failed to install scoop package %1 1>&2
        exit /b 1
    )
) else (
    echo debug: %1 already installed, skipping
)
exit /b 0

:after_check_install_admin

call refreshenv >nul 2>&1

REM `scoop update --all` used to be here; it upgrades already-installed
REM packages, which is an every-apply concern, so it moved to
REM 210-scoop-update.cmd.

echo debug: setting autorun
call clink autorun set %USERPROFILE%\autorun.cmd >nul 2>&1

REM The LanguageTool NSSM service used to be registered here, once, pointed at
REM the java.exe of the moment. It moved to 215-languagetool-service.ps1, which
REM re-converges the service on every change: the winget JDK moves to a new
REM versioned directory on each upgrade and the one-shot registration here
REM could not follow it. nssm and languagetool-java stay in the list above.

goto :eof

:scoop_install_failed
echo error: scoop package install failed, aborting 1>&2
exit /b 1
