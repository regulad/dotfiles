@echo off
setlocal

REM run_onchange_ (like the x509 scripts): chezmoi re-runs a script whose
REM *rendered* contents differ from what this filename last ran successfully,
REM so the digest below is the trigger -- edit dot_firefox-policies.json and
REM the deployment re-runs; an otherwise unchanged apply skips it and never
REM raises a UAC prompt.
REM
REM run_once_ would not do: it keys on the content digest alone with no
REM filename, so any block it has *ever* run successfully never runs again.
REM Reverting a policy edit reproduces an already-seen block and would silently
REM deploy nothing.
REM
REM Policy source digest:
REM     dot_firefox-policies.json {{ include "dot_firefox-policies.json" | sha256sum }}
REM
REM Windows has no system-wide policies.json path outside the registry; the
REM only file location Mozilla supports is a distribution\policies.json next to
REM firefox.exe, in the install winget laid down in 100-winget.

set "SRC=%USERPROFILE%\.firefox-policies.json"
if not exist "%SRC%" (
    echo warning: %SRC% not found, skipping firefox policy deployment 1>&2
    goto :eof
)

set "FIREFOX_DIR="
for %%i in ("%ProgramFiles%\Mozilla Firefox" "%ProgramFiles(x86)%\Mozilla Firefox") do (
    if exist "%%~i\firefox.exe" set "FIREFOX_DIR=%%~i"
)
if not defined FIREFOX_DIR (
    echo note: firefox not found under Program Files, skipping policy deployment 1>&2
    goto :eof
)

set "DEST=%FIREFOX_DIR%\distribution\policies.json"

REM Checked before sudo is touched, so an up-to-date machine doesn't raise a
REM UAC prompt only to discover it had nothing to do.
fc /b "%SRC%" "%DEST%" >nul 2>&1
if not errorlevel 1 (
    echo note: firefox policies already up to date 1>&2
    goto :eof
)

REM PowerShell rather than `mkdir & copy`: sudo here is pinned to Force New
REM Window mode (see 030-w32time.cmd), and chaining two cmd builtins whose
REM arguments both contain spaces through it means nesting double quotes inside
REM an already-quoted `cmd /c` argument. PowerShell's single-quoted strings
REM nest inside that argument without escaping, so the whole thing stays one
REM elevation and one readable line.
echo debug: deploying firefox policies to %DEST%
sudo powershell -NoProfile -NonInteractive -Command "New-Item -ItemType Directory -Force -Path '%FIREFOX_DIR%\distribution' | Out-Null; Copy-Item -LiteralPath '%SRC%' -Destination '%DEST%' -Force"

REM sudo reports success unconditionally in Force New Window mode, so the copy
REM is verified by reading it back rather than by trusting the exit code.
fc /b "%SRC%" "%DEST%" >nul 2>&1
if errorlevel 1 (
    echo error: firefox policy deployment did not apply -- was the elevation prompt declined? 1>&2
    exit /b 1
)
