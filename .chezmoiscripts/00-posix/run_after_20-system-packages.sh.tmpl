	"d:libdevmapper-dev"  # needed by thin-provisioning-tools build
	"r:device-mapper-devel"
	"dr:pciutils"  # needed by llama.cpp
	"d:libcurl4-openssl-dev"
	"r:libcurl-devel"
	## libolm is depreciated upstream but still needed to build the mautrix tools
	"m:libolm"
	"d:libolm-dev"
	"r:libolm-devel"
	"d:libsimdjson-dev"
	"r:simdjson-devel"

	# =+= MISC
	"d:thin-provisioning-tools"  # not natively available redhat
	"mdr:nyx"
	"r:libva-utils"
	"d:vainfo"
	"r:glx-utils"
	"d:mesa-utils"

	# =+= EDITOR
	"mdr:neovim"
