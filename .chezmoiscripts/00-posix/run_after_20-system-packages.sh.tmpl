	"mdr:minicom"

	# =+= UTILS
	"dr:systemd"  # provides utils even when in docker
	"r:gawk"  # not bundled by default
	"mdr:socat"
	"m:inetutils"
	"d:inetutils-telnet"
	"d:inetutils-ping"
	"d:inetutils-ftp"
	"r:iputils"
	"mdr:binutils"
	"dr:net-tools"
	"mdr:perl"
	"mdr:sshpass"
	"mdr:git"
	"mdr:git-lfs"
