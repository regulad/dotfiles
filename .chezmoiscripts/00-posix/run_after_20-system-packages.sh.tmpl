	"d:build-essential"
	"mdr:bash"
	"m:nushell"
	"r:nu"
	"mdr:tmux"
	"mdr:fastfetch"
	"dr:telnet"
	"mdr:retry" # no compat on termux
	"mdr:zsh"
	"dr:xxd"
	"mdr:binwalk"
	"mdr:ncdu"
	"mdr:htop"
	"mdr:nmap"
	"mdr:curl"
	"m:watch"
	"mdr:age"

	# =+= CONTAINERIZATION
	"mdr:podman"
	"mdr:podman-compose"

	# =+= macOS-SPECIFIC
	"m:reattach-to-user-namespace"
	"m:mas"
	"m:smartmontools"
	"m:pam-reattach"
	"m:pinentry-mac"

	# =+= BUILD TOOLS
	"dr:ninja-build"
	"m:ninja"
	"mdr:pkgconf"
	"mdr:cmake"

	# =+= DEPENDENCIES
	"m:cairo"  # needed by cairo PyPi package
