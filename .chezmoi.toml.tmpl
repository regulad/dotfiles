# https://www.chezmoi.io/user-guide/machines/general/#determine-whether-the-current-machine-is-a-laptop-or-desktop
{{- $chassisType := "desktop" }}
{{- if eq .chezmoi.os "darwin" }}
{{-   if contains "MacBook" (output "system_profiler" "SPHardwareDataType") }}
{{-     $chassisType = "laptop" }}
{{-   else }}
{{-     $chassisType = "desktop" }}
{{-   end }}
{{- else if and (eq .chezmoi.os "linux") (eq (trimAll "\n" (output "sh" "-c" "systemd-detect-virt --container; true")) "none") }}
{{-   $chassisType = (output "hostnamectl" "--json=short" | mustFromJson).Chassis }}
{{- else if eq .chezmoi.os "windows" }}
{{-   $chassisType = (output "pwsh.exe" "-NoProfile" "-NonInteractive" "-Command" "if ((Get-CimInstance -Class Win32_Battery | Measure-Object).Count -gt 0) { Write-Output 'laptop' } else { Write-Output 'desktop' }") | trim }}
{{- end }}

# https://www.chezmoi.io/user-guide/machines/general/#determine-whether-the-current-machine-is-a-laptop-or-desktop:~:text=Table%20of%20contents-,Determine%20whether%20the%20current%20machine%20is%20a%20laptop%20or%20desktop,-Determine%20how%20many
{{- $cpuCores := 1 }}
{{- $cpuThreads := 1 }}
{{- if eq .chezmoi.os "darwin" }}
{{-   $cpuCores = (output "sysctl" "-n" "hw.physicalcpu_max") | trim | atoi }}
{{-   $cpuThreads = (output "sysctl" "-n" "hw.logicalcpu_max") | trim | atoi }}
{{- else if and (eq .chezmoi.os "linux") (eq (trimAll "\n" (output "sh" "-c" "systemd-detect-virt --container; true")) "none") }}
{{-   $cpuCores = (output "sh" "-c" "lscpu --online --parse | grep --invert-match '^#' | sort --field-separator=',' --key='2,4' --unique | wc --lines") | trim | atoi }}
{{-   $cpuThreads = (output "sh" "-c" "lscpu --online --parse | grep --invert-match '^#' | wc --lines") | trim | atoi }}
{{- else if eq .chezmoi.os "windows" }}
{{-   $cpuCores = (output "pwsh.exe" "-NoProfile" "-NonInteractive" "-Command" "(Get-CimInstance -ClassName 'Win32_Processor').NumberOfCores") | trim | atoi }}
{{-   $cpuThreads = (output "pwsh.exe" "-NoProfile" "-NonInteractive" "-Command" "(Get-CimInstance -ClassName 'Win32_Processor').NumberOfLogicalProcessors") | trim | atoi }}
{{- end }}

# Where brew lives. Static config files (pam, tmux, gpg-agent, the Chrome
# native-messaging manifest) need the prefix as a literal string and cannot
# run `brew shellenv`, so it is decided once here and shared as .homebrewPrefix.
# Hookscripts get the same answer at runtime from posix-preamble-brew.sh.
#
# macOS: /opt/homebrew on Apple Silicon, /usr/local on Intel -- this is
# Homebrew's own rule, not a preference. Linux: /home/linuxbrew/.linuxbrew.
{{- $homebrewPrefix := "" }}
{{- if eq .chezmoi.os "darwin" }}
{{-   if eq .chezmoi.arch "arm64" }}
{{-     $homebrewPrefix = "/opt/homebrew" }}
{{-   else }}
{{-     $homebrewPrefix = "/usr/local" }}
{{-   end }}
{{- else if eq .chezmoi.os "linux" }}
{{-   $homebrewPrefix = "/home/linuxbrew/.linuxbrew" }}
{{- end }}

# macOS version, as Homebrew names releases: "11" and up for Big Sur onward,
# "10.15" for Catalina, where the major alone would collapse every 10.x
# release into one. ("" elsewhere.) Consumed with .chezmoi.arch as
# the "<series>-<arch>" key into .chezmoidata/brew-tiers.toml, which decides
# whether this host gets mainline brew or an era-pinned one.
{{- $macosSeries := "" }}
{{- $macosMajor := 0 }}
{{- if eq .chezmoi.os "darwin" }}
{{-   $parts := output "sw_vers" "-productVersion" | trim | splitList "." }}
{{-   $macosMajor = index $parts 0 | atoi }}
{{-   if eq $macosMajor 10 }}
{{-     $macosSeries = printf "10.%s" (index $parts 1) }}
{{-   else }}
{{-     $macosSeries = index $parts 0 }}
{{-   end }}
{{- end }}

# Whether this environment runs on the hardware's own instruction set:
# directly, or through a hypervisor (a VM, WSL2 -- the guest is native code
# on the host's CPU). False when its binaries are being translated: Rosetta
# on Apple Silicon, Prism on Windows on ARM, qemu-user/FEX/box64 on Linux.
# Gates what only makes sense natively -- the VM and container engines
# (colima, lima, apple/container), which a translated copy would duplicate.
# The x86_64 Rosetta brew's hookscripts (00-macos/006, 021, 031) render the
# shared templates with this forced to false; see docs/rosetta-brew.md.
{{- $nativeArch := true }}
{{- if eq .chezmoi.os "darwin" }}
{{-   if eq (output "sh" "-c" "sysctl -n sysctl.proc_translated 2>/dev/null; true" | trim) "1" }}
{{-     $nativeArch = false }}
{{-   end }}
{{- else if eq .chezmoi.os "linux" }}
{{-   $machine := output "uname" "-m" | trim }}
{{-   $goarch := get (dict "x86_64" "amd64" "aarch64" "arm64" "armv7l" "arm" "i686" "386" "riscv64" "riscv64") $machine | default $machine }}
{{-   $nativeArch = eq $goarch .chezmoi.arch }}
{{- else if eq .chezmoi.os "windows" }}
{{-   $cpuArch := output "pwsh.exe" "-NoProfile" "-NonInteractive" "-Command" "(Get-CimInstance -ClassName 'Win32_Processor' | Select-Object -First 1).Architecture" | trim }}
{{-   $goarch := get (dict "9" "amd64" "12" "arm64" "0" "386" "5" "arm") $cpuArch | default $cpuArch }}
{{-   $nativeArch = eq $goarch .chezmoi.arch }}
{{- end }}

# The computer's make and model, verbatim as its firmware reports them in the
# SMBIOS System Information table, for the per-model hookscript tier
# (.chezmoiscripts/99-<os>-<make>-<model>, see .chezmoiignore.tmpl). Windows
# and Linux read the same table, so one computer reports the same pair under
# either. Apple Silicon has no SMBIOS, so Macs use Apple's model identifier
# (hw.model, e.g. Mac15,3). Both stay empty in containers, which would see
# their host's table, and in WSL, which has none. They are free text, so they
# are written out with toJson: a JSON string is also a valid TOML basic string,
# with any quote or backslash in it escaped.
{{- $machineMake := "" }}
{{- $machineModel := "" }}
{{- if eq .chezmoi.os "darwin" }}
{{-   $machineMake = "Apple Inc." }}
{{-   $machineModel = output "sysctl" "-n" "hw.model" | trim }}
{{- else if and (eq .chezmoi.os "linux") (eq (trimAll "\n" (output "sh" "-c" "systemd-detect-virt --container; true")) "none") }}
{{-   $machineMake = output "sh" "-c" "cat /sys/class/dmi/id/sys_vendor 2>/dev/null; true" | trim }}
{{-   $machineModel = output "sh" "-c" "cat /sys/class/dmi/id/product_name 2>/dev/null; true" | trim }}
{{- else if eq .chezmoi.os "windows" }}
{{-   $system := output "pwsh.exe" "-NoProfile" "-NonInteractive" "-Command" "Get-CimInstance -ClassName 'Win32_ComputerSystem' | Select-Object Manufacturer, Model | ConvertTo-Json -Compress" | mustFromJson }}
{{-   $machineMake = $system.Manufacturer | default "" | trim }}
{{-   $machineModel = $system.Model | default "" | trim }}
{{- end }}

encryption = "age"
[age]
    identity = "{{ .chezmoi.homeDir }}/key.txt"
    recipient = "age14e7wj4lltcvva2jy9vzzul8y7yuj5xk9vtqfxt9erzz58xqwmpjqurdhep"
[git]
    autoCommit = true
    autoPush = true
    commitMessageTemplateFile = ".commit_message.tmpl"
[bitwarden]
    unlock = "auto"
[data]
    useDummySecrets = {{ env "CHEZMOI_USE_DUMMY" | not | not }}
    useHeadless = {{ env "CHEZMOI_USE_HEADLESS" | not | not }}
    homebrewPrefix = "{{ $homebrewPrefix }}"
    nativeArch = {{ $nativeArch }}
[data.macos]
    major = {{ $macosMajor }}
    series = "{{ $macosSeries }}"
[data.chassis]
    type = "{{ $chassisType }}"
    cores = {{ $cpuCores }}
    threads = {{ $cpuThreads }}
[data.machine]
    make = {{ $machineMake | toJson }}
    model = {{ $machineModel | toJson }}
